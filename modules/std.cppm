/* The named module std ([std.modules]), from C++23 on: every name of namespace
 * std that the freestanding headers of the revision in use declare, and the
 * global allocation and deallocation functions of <new>. Build it with the
 * options of the translation units that import it, as with
 *     clang++ -std=c++23 -ffreestanding -nostdinc -isystem ... \
 *         --precompile std.cppm -o std.pcm
 *     g++ -std=c++23 -fmodules -ffreestanding -nostdinc -isystem ... \
 *         -c std.cppm
 * The macros of the headers are not part of the module; the headers still
 * give them, such as those of <version>.
 *
 * It exports each name of tests/names.txt in the revisions it gives for it,
 * where the headers declare it with the compiler in use, which tests/run.sh
 * checks, and the operators the headers declare in those namespaces. The
 * customization point objects are exported from the inline namespaces they
 * are in, as the hidden friends of the same names would conflict with them
 * otherwise. */

module;

#include <__fcxx/std_module.h>

#if defined(__clang__)
#  pragma clang diagnostic ignored "-Wreserved-module-identifier"
#endif

export module std;

export namespace std {
