/* WEOF and mbstate_t, which C++26 makes freestanding too, are left out: the
 * value that the wide-character input and output functions return at the
 * end of a file, and the state of the conversions between multibyte and
 * wide characters, are those of the C library of a hosted environment,
 * which the library cannot know, and which none of the freestanding
 * functions has any use for. */

namespace std {

typedef __WINT_TYPE__ wint_t;

/* The functions are provided here, with C++ language linkage, as there is
 * no C library to take them from. */

inline wchar_t* wmemcpy(wchar_t* __s1, const wchar_t* __s2, size_t __n) {
    return static_cast<wchar_t*>(__builtin_memcpy(__s1, __s2, __n * sizeof(wchar_t)));
}

inline wchar_t* wmemmove(wchar_t* __s1, const wchar_t* __s2, size_t __n) {
    return static_cast<wchar_t*>(__builtin_memmove(__s1, __s2, __n * sizeof(wchar_t)));
}

inline wchar_t* wmemset(wchar_t* __s, wchar_t __c, size_t __n) {
    for (size_t __i = 0; __i < __n; ++__i) {
        __s[__i] = __c;
    }
    return __s;
}

inline int wmemcmp(const wchar_t* __s1, const wchar_t* __s2, size_t __n) {
    for (; __n > 0; --__n, ++__s1, ++__s2) {
        if (*__s1 != *__s2) {
            return *__s1 < *__s2 ? -1 : 1;
        }
    }
    return 0;
}

inline const wchar_t* wmemchr(const wchar_t* __s, wchar_t __c, size_t __n) {
    for (; __n > 0; --__n, ++__s) {
        if (*__s == __c) {
            return __s;
        }
    }
    return 0;
}

inline wchar_t* wmemchr(wchar_t* __s, wchar_t __c, size_t __n) {
    return const_cast<wchar_t*>(wmemchr(static_cast<const wchar_t*>(__s), __c, __n));
}

inline size_t wcslen(const wchar_t* __s) {
    const wchar_t* __e = __s;
    while (*__e != L'\0') {
        ++__e;
    }
    return static_cast<size_t>(__e - __s);
}

inline wchar_t* wcscpy(wchar_t* __s1, const wchar_t* __s2) {
    wchar_t* __d = __s1;
    while ((*__d++ = *__s2++) != L'\0') {
    }
    return __s1;
}

inline wchar_t* wcsncpy(wchar_t* __s1, const wchar_t* __s2, size_t __n) {
    wchar_t* __d = __s1;
    for (; __n > 0 && *__s2 != L'\0'; --__n) {
        *__d++ = *__s2++;
    }
    for (; __n > 0; --__n) {
        *__d++ = L'\0';
    }
    return __s1;
}

inline wchar_t* wcscat(wchar_t* __s1, const wchar_t* __s2) {
