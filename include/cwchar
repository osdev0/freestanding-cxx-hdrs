        }
    }
    return __n;
}

inline size_t wcscspn(const wchar_t* __s1, const wchar_t* __s2) {
    size_t __n = 0;
    for (; __s1[__n] != L'\0'; ++__n) {
        const wchar_t* __r = __s2;
        while (*__r != L'\0' && *__r != __s1[__n]) {
            ++__r;
        }
        if (*__r != L'\0') {
