inline int wcsncmp(const wchar_t* __s1, const wchar_t* __s2, size_t __n) {
    for (; __n > 0; --__n, ++__s1, ++__s2) {
        if (*__s1 != *__s2) {
            return *__s1 < *__s2 ? -1 : 1;
        }
        if (*__s1 == L'\0') {
            return 0;
