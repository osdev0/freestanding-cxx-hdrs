inline wchar_t* wcstok(wchar_t* __s1, const wchar_t* __s2, wchar_t** __ptr) {
    if (__s1 == 0) {
        __s1 = *__ptr;
        if (__s1 == 0) {
            return 0;
        }
    }
    __s1 += wcsspn(__s1, __s2);
    if (*__s1 == L'\0') {
        *__ptr = 0;
        return 0;
    }
    wchar_t* __end = __s1 + wcscspn(__s1, __s2);
    if (*__end != L'\0') {
        *__end = L'\0';
        *__ptr = __end + 1;
    } else {
        *__ptr = 0;
    }
    return __s1;
}

