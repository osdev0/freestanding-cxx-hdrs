#ifndef __FREESTANDING_CXX_HDRS_CFLOAT
#define __FREESTANDING_CXX_HDRS_CFLOAT 1

#pragma GCC system_header

#include <__fcxx/config.h>
_FCXX_BEGIN_EXTERN_CXX

#if _FCXX_STD < 2011
#  error "<cfloat> is not a freestanding header before C++11"
#endif

#if _FCXX_STD >= 2011
/* The macros of the C header, which defines those of each revision of C++. */
#  include <float.h>
#endif

_FCXX_END_EXTERN_CXX
#endif
