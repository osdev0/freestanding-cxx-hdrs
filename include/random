namespace std {

/* [rand.req.genl], the types that the templates take as UIntType and as
 * IntType. The implementation-defined subsets of the standard are those of
 * unsigned char, for the engines, and of the extended integer types
 * __int128 and unsigned __int128. */

template <class _Tp> struct __fcxx_rand_is_uint : false_type {};
template <> struct __fcxx_rand_is_uint<unsigned char> : true_type {};
template <> struct __fcxx_rand_is_uint<unsigned short> : true_type {};
template <> struct __fcxx_rand_is_uint<unsigned int> : true_type {};
template <> struct __fcxx_rand_is_uint<unsigned long> : true_type {};
template <> struct __fcxx_rand_is_uint<unsigned long long> : true_type {};
#ifdef __SIZEOF_INT128__
template <> struct __fcxx_rand_is_uint<__fcxx_uint128> : true_type {};
#endif

template <class _Tp> struct __fcxx_rand_is_int : __fcxx_rand_is_uint<_Tp> {};
template <> struct __fcxx_rand_is_int<signed char> : true_type {};
template <> struct __fcxx_rand_is_int<short> : true_type {};
template <> struct __fcxx_rand_is_int<int> : true_type {};
template <> struct __fcxx_rand_is_int<long> : true_type {};
template <> struct __fcxx_rand_is_int<long long> : true_type {};
#ifdef __SIZEOF_INT128__
template <> struct __fcxx_rand_is_int<__fcxx_int128> : true_type {};
#endif

/* The type the arithmetic of an unsigned type is done in, which is at least
 * unsigned int, so that nothing is promoted to int. */
template <class _Tp>
struct __fcxx_rand_wide {
    typedef __fcxx_conditional_t<(sizeof(_Tp) < sizeof(unsigned int)), unsigned int, _Tp> type;
};

/* The number of bits and the maximum of an integer type, as numeric_limits
 * has them, without needing all of <limits>. */
template <class _Tp>
constexpr size_t __fcxx_rand_digits() {
    return sizeof(_Tp) * __CHAR_BIT__ - (_Tp(-1) < _Tp(0) ? 1 : 0);
}

template <class _Tp>
constexpr _Tp __fcxx_rand_max() {
    return static_cast<_Tp>(static_cast<typename make_unsigned<_Tp>::type>(~typename make_unsigned<_Tp>::type(0))
                            >> (_Tp(-1) < _Tp(0) ? 1 : 0));
}

/* 2^w - 1, and the shifts, for any number of bits up to the width of the
 * type, where the operators would be undefined. */
template <class _Tp>
constexpr _Tp __fcxx_rand_mask(size_t __w) {
    return __w >= std::__fcxx_rand_digits<_Tp>() ? std::__fcxx_rand_max<_Tp>()
         : __w == 0 ? _Tp(0)
         : static_cast<_Tp>(std::__fcxx_rand_max<_Tp>() >> (std::__fcxx_rand_digits<_Tp>() - __w));
}

template <class _Tp>
constexpr _Tp __fcxx_rand_shl(_Tp __x, size_t __s) {
    return __s >= std::__fcxx_rand_digits<_Tp>() ? _Tp(0) : static_cast<_Tp>(__x << __s);
}

template <class _Tp>
constexpr _Tp __fcxx_rand_shr(_Tp __x, size_t __s) {
    return __s >= std::__fcxx_rand_digits<_Tp>() ? _Tp(0) : static_cast<_Tp>(__x >> __s);
}

/* The number of bits needed for a value, which is one more than the floor
 * of its base 2 logarithm. */
template <class _Tp>
constexpr size_t __fcxx_rand_bit_width(_Tp __x) {
    return __x == 0 ? 0 : 1 + std::__fcxx_rand_bit_width(static_cast<_Tp>(__x >> 1));
}

/* [rand.eng.general], a type qualifies as a seed sequence for an engine if
 * it can generate into an array of 32-bit values, which the engines seed
 * from, and cannot be converted to the result type of the engine. */
template <class _Sseq, class _Result, class = void>
struct __fcxx_is_seed_sequence : false_type {};

template <class _Sseq, class _Result>
struct __fcxx_is_seed_sequence<
    _Sseq, _Result,
    __fcxx_void_t<decltype(declval<_Sseq&>().generate(declval<uint_least32_t*>(), declval<uint_least32_t*>()))> >
    : __fcxx_bool_constant<!is_convertible<_Sseq, _Result>::value> {};

/* The value of a number of 32-bit values of a seed sequence, the first one
 * the least significant. */
template <class _Tp>
_Tp __fcxx_rand_from_words(const uint_least32_t* __a, size_t __k) {
    _Tp __value = 0;
    for (size_t __j = 0; __j < __k; ++__j) {
        __value = static_cast<_Tp>(
            __value | std::__fcxx_rand_shl(static_cast<_Tp>(__a[__j] & 0xffffffffu), 32 * __j));
    }
    return __value;
}

/* [rand.req.urng], uniform random bit generator requirements */

template <class _Gp>
concept uniform_random_bit_generator = __fcxx_uniform_random_bit_generator<_Gp>;

/* [rand.eng.lcong], class template linear_congruential_engine */

/* The arithmetic modulo m, which is that of the type for a modulus of 2^w,
 * and is otherwise done in a type wide enough for the products, or by
 * doubling and adding without one. */
#ifdef __SIZEOF_INT128__
#  define _FCXX_LCG_HAS_INT128 1
#else
#  define _FCXX_LCG_HAS_INT128 0
#endif

template <class _Tp, _Tp _Mp,
          int _Kind = _Mp == 0 ? 0
                    : _Mp - 1u <= 0xffffffffu ? 1
                    : _FCXX_LCG_HAS_INT128 && sizeof(_Tp) <= sizeof(unsigned long long) ? 2
                    : 3>
struct __fcxx_lcg_arith;

template <class _Tp, _Tp _Mp>
struct __fcxx_lcg_arith<_Tp, _Mp, 0> {
    typedef typename __fcxx_rand_wide<_Tp>::type _Wide;
    static _Tp __mul(_Tp __x, _Tp __y) {
        return static_cast<_Tp>(_FCXX_MUL(static_cast<_Wide>(__x), static_cast<_Wide>(__y)));
    }
    static _Tp __add(_Tp __x, _Tp __y) { return static_cast<_Tp>(static_cast<_Wide>(__x) + static_cast<_Wide>(__y)); }
    template <class _Up> static _Tp __reduce(_Up __x) { return static_cast<_Tp>(__x); }
};

template <class _Tp, _Tp _Mp>
struct __fcxx_lcg_arith<_Tp, _Mp, 1> {
    static _Tp __mul(_Tp __x, _Tp __y) {
        return static_cast<_Tp>(_FCXX_MUL(static_cast<unsigned long long>(__x), __y) % _Mp);
    }
    static _Tp __add(_Tp __x, _Tp __y) { return static_cast<_Tp>((static_cast<unsigned long long>(__x) + __y) % _Mp); }
    template <class _Up> static _Tp __reduce(_Up __x) { return static_cast<_Tp>(__x % _Mp); }
};

#if _FCXX_LCG_HAS_INT128
template <class _Tp, _Tp _Mp>
struct __fcxx_lcg_arith<_Tp, _Mp, 2> {
    static _Tp __mul(_Tp __x, _Tp __y) {
        return static_cast<_Tp>(_FCXX_MUL(static_cast<__fcxx_uint128>(__x), __y) % _Mp);
    }
    static _Tp __add(_Tp __x, _Tp __y) { return static_cast<_Tp>((static_cast<__fcxx_uint128>(__x) + __y) % _Mp); }
    template <class _Up> static _Tp __reduce(_Up __x) { return static_cast<_Tp>(__x % _Mp); }
};
#endif

template <class _Tp, _Tp _Mp>
struct __fcxx_lcg_arith<_Tp, _Mp, 3> {
    static _Tp __add(_Tp __x, _Tp __y) { return __x >= _Mp - __y ? __x - (_Mp - __y) : __x + __y; }
    static _Tp __mul(_Tp __x, _Tp __y) {
        _Tp __r = 0;
        for (; __y != 0; __y >>= 1) {
            if ((__y & 1) != 0) {
                __r = __add(__r, __x);
            }
            __x = __add(__x, __x);
        }
        return __r;
    }
    template <class _Up> static _Tp __reduce(_Up __x) { return static_cast<_Tp>(__x % _Mp); }
};

#undef _FCXX_LCG_HAS_INT128

template <class _UIntType, _UIntType _Ap, _UIntType _Cp, _UIntType _Mp>
class linear_congruential_engine {
    static_assert(__fcxx_rand_is_uint<_UIntType>::value,
                  "std::linear_congruential_engine needs an unsigned integer type");
    static_assert(_Mp == 0 || (_Ap < _Mp && _Cp < _Mp), "std::linear_congruential_engine needs a < m and c < m");

    typedef __fcxx_lcg_arith<_UIntType, _Mp> __arith;
    typedef __fcxx_conditional_t<(sizeof(_UIntType) > sizeof(unsigned long long)), _UIntType, unsigned long long>
        __seed_type;

    /* The number of 32-bit values of a seed sequence the state is made of,
     * which is the ceiling of log2(m) / 32. */
    static constexpr size_t __seed_words =
        ((_Mp == 0 ? std::__fcxx_rand_digits<_UIntType>()
                   : std::__fcxx_rand_bit_width(_Mp) - ((_Mp & (_Mp - 1u)) == 0 ? 1 : 0))
         + 31) / 32;

public:
    typedef _UIntType result_type;

    static constexpr result_type multiplier = _Ap;
    static constexpr result_type increment = _Cp;
    static constexpr result_type modulus = _Mp;
    static constexpr result_type min() { return _Cp == 0u ? 1u : 0u; }
    static constexpr result_type max() { return static_cast<result_type>(_Mp - 1u); }
    static constexpr result_type default_seed = 1u;

    linear_congruential_engine() : linear_congruential_engine(default_seed) {}
    explicit linear_congruential_engine(result_type __s) { seed(__s); }

    template <class _Sseq, class = __fcxx_enable_if_t<__fcxx_is_seed_sequence<_Sseq, result_type>::value> >
    explicit linear_congruential_engine(_Sseq& __q) {
        seed(__q);
    }

    void seed(result_type __s = default_seed) {
        __state = __arith::__reduce(__s);
        if (_Cp == 0 && __state == 0) {
            __state = 1;
        }
    }

    template <class _Sseq>
    __fcxx_enable_if_t<__fcxx_is_seed_sequence<_Sseq, result_type>::value> seed(_Sseq& __q) {
        uint_least32_t __a[__seed_words + 3];
        __q.generate(__a + 0, __a + (__seed_words + 3));
        __state = __arith::__reduce(std::__fcxx_rand_from_words<__seed_type>(__a + 3, __seed_words));
        if (_Cp == 0 && __state == 0) {
            __state = 1;
        }
    }

    /* Only the next state tells what the engine produces, as the multiplier
     * need not be invertible. */
    friend bool operator==(const linear_congruential_engine& __x, const linear_congruential_engine& __y) {
        return __x.__next(__x.__state) == __y.__next(__y.__state);
    }

    result_type operator()() {
        __state = __next(__state);
        return __state;
    }

    /* The transition is x -> ax + c, of which z steps are raised to their
     * power by squaring. */
    void discard(unsigned long long __z) {
        result_type __amul = __arith::__reduce(1u);
        result_type __aadd = 0;
        result_type __bmul = _Ap;
        result_type __badd = _Cp;
        for (; __z != 0; __z >>= 1) {
            if ((__z & 1) != 0) {
                __aadd = __arith::__add(__arith::__mul(__bmul, __aadd), __badd);
                __amul = __arith::__mul(__bmul, __amul);
            }
            __badd = __arith::__add(__arith::__mul(__bmul, __badd), __badd);
            __bmul = __arith::__mul(__bmul, __bmul);
        }
        __state = __arith::__add(__arith::__mul(__amul, __state), __aadd);
    }

private:
    static result_type __next(result_type __x) { return __arith::__add(__arith::__mul(_Ap, __x), _Cp); }

    result_type __state;
};

/* [rand.eng.mers], class template mersenne_twister_engine
 *
 * The state is kept in a circular buffer, of which __pos is the index of
 * X(i-n), the oldest value, which the next value replaces. */

template <class _UIntType, size_t _Wp, size_t _Np, size_t _Mp, size_t _Rp, _UIntType _Ap, size_t _Up, _UIntType _Dp,
          size_t _Sp, _UIntType _Bp, size_t _Tp, _UIntType _Cp, size_t _Lp, _UIntType _Fp>
class mersenne_twister_engine {
    static_assert(__fcxx_rand_is_uint<_UIntType>::value, "std::mersenne_twister_engine needs an unsigned integer type");
    static_assert(0 < _Mp && _Mp <= _Np, "std::mersenne_twister_engine needs 0 < m <= n");
    static_assert(2u < _Wp && _Wp <= std::__fcxx_rand_digits<_UIntType>(),
                  "std::mersenne_twister_engine needs 2 < w <= numeric_limits<UIntType>::digits");
    static_assert(_Rp <= _Wp && _Up <= _Wp && _Sp <= _Wp && _Tp <= _Wp && _Lp <= _Wp,
                  "std::mersenne_twister_engine needs r, u, s, t and l to be at most w");
    static_assert(_Ap <= std::__fcxx_rand_mask<_UIntType>(_Wp) && _Bp <= std::__fcxx_rand_mask<_UIntType>(_Wp)
                      && _Cp <= std::__fcxx_rand_mask<_UIntType>(_Wp) && _Dp <= std::__fcxx_rand_mask<_UIntType>(_Wp)
                      && _Fp <= std::__fcxx_rand_mask<_UIntType>(_Wp),
                  "std::mersenne_twister_engine needs a, b, c, d and f to be less than 2^w");

    typedef typename __fcxx_rand_wide<_UIntType>::type _Wide;

    static constexpr _Wide __mask = std::__fcxx_rand_mask<_Wide>(_Wp);
    static constexpr _Wide __lower_mask = std::__fcxx_rand_mask<_Wide>(_Rp);
    static constexpr _Wide __upper_mask = __mask & ~__lower_mask;

public:
    typedef _UIntType result_type;

    static constexpr size_t word_size = _Wp;
    static constexpr size_t state_size = _Np;
    static constexpr size_t shift_size = _Mp;
    static constexpr size_t mask_bits = _Rp;
    static constexpr _UIntType xor_mask = _Ap;
    static constexpr size_t tempering_u = _Up;
    static constexpr _UIntType tempering_d = _Dp;
    static constexpr size_t tempering_s = _Sp;
    static constexpr _UIntType tempering_b = _Bp;
    static constexpr size_t tempering_t = _Tp;
    static constexpr _UIntType tempering_c = _Cp;
    static constexpr size_t tempering_l = _Lp;
    static constexpr _UIntType initialization_multiplier = _Fp;
    static constexpr result_type min() { return 0; }
    static constexpr result_type max() { return std::__fcxx_rand_mask<result_type>(_Wp); }
    /* Converted explicitly, as unsigned char, which the engines take besides
     * the types of the standard, cannot represent it; the seed is taken
     * modulo 2^w anyway. */
    static constexpr result_type default_seed = static_cast<result_type>(5489u);

    mersenne_twister_engine() : mersenne_twister_engine(default_seed) {}
    explicit mersenne_twister_engine(result_type __value) { seed(__value); }

    template <class _Sseq, class = __fcxx_enable_if_t<__fcxx_is_seed_sequence<_Sseq, result_type>::value> >
    explicit mersenne_twister_engine(_Sseq& __q) {
        seed(__q);
    }

    void seed(result_type __value = default_seed) {
        _Wide __x = static_cast<_Wide>(__value) & __mask;
        __state[0] = static_cast<_UIntType>(__x);
        for (size_t __i = 1; __i < _Np; ++__i) {
            __x = (_FCXX_MUL(static_cast<_Wide>(_Fp), (__x ^ (__x >> (_Wp - 2)))) + static_cast<_Wide>(__i)) & __mask;
            __state[__i] = static_cast<_UIntType>(__x);
        }
        __pos = 0;
    }

    template <class _Sseq>
    __fcxx_enable_if_t<__fcxx_is_seed_sequence<_Sseq, result_type>::value> seed(_Sseq& __q) {
        const size_t __k = (_Wp + 31) / 32;
        uint_least32_t __a[_Np * __k];
        __q.generate(__a + 0, __a + _Np * __k);
        bool __zero = (std::__fcxx_rand_shr<_Wide>(std::__fcxx_rand_from_words<_Wide>(__a, __k) & __mask, _Rp)) == 0;
        for (size_t __i = 0; __i < _Np; ++__i) {
            const _Wide __x = std::__fcxx_rand_from_words<_Wide>(__a + __k * __i, __k) & __mask;
            __state[__i] = static_cast<_UIntType>(__x);
            if (__i != 0 && __x != 0) {
                __zero = false;
            }
        }
        /* A state of all zeros but for the bits that do not matter would
         * never leave zero. */
        if (__zero) {
            __state[0] = static_cast<_UIntType>(_Wide(1) << (_Wp - 1));
        }
        __pos = 0;
    }

    /* Of X(i-n), only the upper w-r bits affect what the engine produces. */
    friend bool operator==(const mersenne_twister_engine& __x, const mersenne_twister_engine& __y) {
        if ((static_cast<_Wide>(__x.__state[__x.__pos]) & __upper_mask)
            != (static_cast<_Wide>(__y.__state[__y.__pos]) & __upper_mask)) {
            return false;
        }
        for (size_t __j = 1; __j < _Np; ++__j) {
            if (__x.__at(__j) != __y.__at(__j)) {
                return false;
            }
        }
        return true;
    }

    result_type operator()() {
        _Wide __z = __next();
        __z ^= std::__fcxx_rand_shr<_Wide>(__z, _Up) & _Dp;
        __z ^= std::__fcxx_rand_shl<_Wide>(__z, _Sp) & _Bp;
        __z ^= std::__fcxx_rand_shl<_Wide>(__z, _Tp) & _Cp;
        __z ^= std::__fcxx_rand_shr<_Wide>(__z, _Lp);
        return static_cast<result_type>(__z);
    }

    void discard(unsigned long long __z) {
        for (; __z != 0; --__z) {
            __next();
        }
    }

private:
    /* X(i-n+j), for j from 0 to n-1. */
    _UIntType __at(size_t __j) const { return __state[__pos + __j < _Np ? __pos + __j : __pos + __j - _Np]; }

    /* The transition, which returns the new X(i) untempered. */
    _Wide __next() {
        const size_t __i = __pos;
        const size_t __i1 = __i + 1 == _Np ? 0 : __i + 1;
        const size_t __im = __i + _Mp >= _Np ? __i + _Mp - _Np : __i + _Mp;
        const _Wide __y = (static_cast<_Wide>(__state[__i]) & __upper_mask)
                        | (static_cast<_Wide>(__state[__i1]) & __lower_mask);
        _Wide __x = static_cast<_Wide>(__state[__im]) ^ (__y >> 1);
        if ((__y & 1) != 0) {
            __x ^= _Ap;
        }
        __state[__i] = static_cast<_UIntType>(__x);
        __pos = __i1;
        return __x;
    }

    _UIntType __state[_Np];
    size_t __pos;
};

/* [rand.eng.sub], class template subtract_with_carry_engine
 *
 * The state is kept in a circular buffer, of which __pos is the index of
 * X(i-r), the oldest value, which the next value replaces. */

template <class _UIntType, size_t _Wp, size_t _Sp, size_t _Rp>
class subtract_with_carry_engine {
    static_assert(__fcxx_rand_is_uint<_UIntType>::value,
                  "std::subtract_with_carry_engine needs an unsigned integer type");
    static_assert(0u < _Sp && _Sp < _Rp, "std::subtract_with_carry_engine needs 0 < s < r");
    static_assert(0 < _Wp && _Wp <= std::__fcxx_rand_digits<_UIntType>(),
                  "std::subtract_with_carry_engine needs 0 < w <= numeric_limits<UIntType>::digits");

    typedef typename __fcxx_rand_wide<_UIntType>::type _Wide;
    typedef __fcxx_conditional_t<(sizeof(_Wide) > sizeof(unsigned long long)), _Wide, unsigned long long> __seed_type;

    static constexpr _Wide __mask = std::__fcxx_rand_mask<_Wide>(_Wp);

public:
    typedef _UIntType result_type;

    static constexpr size_t word_size = _Wp;
    static constexpr size_t short_lag = _Sp;
    static constexpr size_t long_lag = _Rp;
    static constexpr result_type min() { return 0; }
    static constexpr result_type max() { return std::__fcxx_rand_mask<result_type>(_Wp); }

    /* From C++26 on, the seed of zero stands for the default one, which
     * need not be representable in the result type. */
    static constexpr uint_least32_t default_seed = 19780503u;

    subtract_with_carry_engine() : subtract_with_carry_engine(0u) {}
    explicit subtract_with_carry_engine(result_type __value) { seed(__value); }

    template <class _Sseq, class = __fcxx_enable_if_t<__fcxx_is_seed_sequence<_Sseq, result_type>::value> >
    explicit subtract_with_carry_engine(_Sseq& __q) {
        seed(__q);
    }

    /* The values come from the engine that the standard defines as
     * linear_congruential_engine<uint_least32_t, 40014u, 0u, 2147483563u>. */
    void seed(result_type __value = 0u) {
        unsigned long long __lcg = __value == 0u ? 19780503u : __value % 2147483563u;
        if (__lcg == 0) {
            __lcg = 1;
        }
        const size_t __n = (_Wp + 31) / 32;
        for (size_t __i = 0; __i < _Rp; ++__i) {
            __seed_type __x = 0;
            for (size_t __j = 0; __j < __n; ++__j) {
                __lcg = _FCXX_MUL(__lcg, 40014u) % 2147483563u;
                __x |= std::__fcxx_rand_shl(static_cast<__seed_type>(__lcg), 32 * __j);
            }
            __state[__i] = static_cast<_UIntType>(__x & __mask);
        }
        __carry = __state[_Rp - 1] == 0;
        __pos = 0;
    }

    template <class _Sseq>
    __fcxx_enable_if_t<__fcxx_is_seed_sequence<_Sseq, result_type>::value> seed(_Sseq& __q) {
        const size_t __k = (_Wp + 31) / 32;
        uint_least32_t __a[_Rp * __k];
        __q.generate(__a + 0, __a + _Rp * __k);
        for (size_t __i = 0; __i < _Rp; ++__i) {
            __state[__i] = static_cast<_UIntType>(std::__fcxx_rand_from_words<__seed_type>(__a + __k * __i, __k)
                                                  & __mask);
        }
        __carry = __state[_Rp - 1] == 0;
        __pos = 0;
    }

    /* X(i-r) and the carry only affect what the engine produces through
     * their sum. */
    friend bool operator==(const subtract_with_carry_engine& __x, const subtract_with_carry_engine& __y) {
        const _Wide __xo = __x.__state[__x.__pos];
        const _Wide __yo = __y.__state[__y.__pos];
        if (__x.__carry == __y.__carry ? __xo != __yo
            : __x.__carry ? !(__yo > __xo && __yo - __xo == 1)
