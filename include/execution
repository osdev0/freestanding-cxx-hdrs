#ifndef __FREESTANDING_CXX_HDRS_EXECUTION
#define __FREESTANDING_CXX_HDRS_EXECUTION 1

#pragma GCC system_header

#include <__fcxx/config.h>
_FCXX_BEGIN_EXTERN_CXX

#if _FCXX_STD < 2026
#  error "<execution> is not a freestanding header before C++26"
#endif

#define _FCXX_VERSION_EXECUTION
#include <__fcxx/version.h>
#undef _FCXX_VERSION_EXECUTION

#if _FCXX_STD >= 2026

/* Of the header, only the execution policy type trait is freestanding: the
 * execution policies, and the rest of what C++26 adds to the header, are
 * not. */
#include <__fcxx/execution_policy.h>

#endif

_FCXX_END_EXTERN_CXX
#endif
