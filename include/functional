/* [func.search.default], class template default_searcher */

template <class _ForwardIterator1, class _BinaryPredicate = equal_to<> >
class default_searcher {
public:
    constexpr default_searcher(_ForwardIterator1 __first, _ForwardIterator1 __last,
                                       _BinaryPredicate __p = _BinaryPredicate())
        : __pat_first(__first), __pat_last(__last), __pred(__p) {}

    template <class _ForwardIterator2>
    constexpr pair<_ForwardIterator2, _ForwardIterator2> operator()(_ForwardIterator2 __first,
                                                                             _ForwardIterator2 __last) const {
        for (;; ++__first) {
            _ForwardIterator2 __it = __first;
            for (_ForwardIterator1 __p = __pat_first;; ++__it, ++__p) {
                if (__p == __pat_last) {
                    return pair<_ForwardIterator2, _ForwardIterator2>(__first, __it);
                }
                if (__it == __last) {
                    return pair<_ForwardIterator2, _ForwardIterator2>(__last, __last);
                }
                if (!__pred(*__it, *__p)) {
                    break;
                }
            }
        }
    }

private:
    _ForwardIterator1 __pat_first;
    _ForwardIterator1 __pat_last;
    _BinaryPredicate __pred;
};

