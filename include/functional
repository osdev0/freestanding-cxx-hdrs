namespace std {

/* The perfect forwarding call wrappers of not_fn, bind_front and bind_back:
 * their target object and bound arguments are the elements of a tuple, and
 * a pattern makes the call of them with the arguments of the call, with the
 * cv-qualification and value category of the call wrapper. The call
 * operators that cannot make the call are deleted, so that the call of an
 * rvalue does not fall back to the operator of const lvalues, and so on. */
struct __fcxx_not_fn_pattern {
    template <class _State, size_t... _Is, class... _Args>
    static constexpr auto __call(_State&& __s, index_sequence<_Is...>, _Args&&... __args) noexcept(
        noexcept(!std::__fcxx_invoke(std::get<0>(std::forward<_State>(__s)), std::forward<_Args>(__args)...)))
        -> decltype(!std::__fcxx_invoke(std::get<0>(std::forward<_State>(__s)), std::forward<_Args>(__args)...)) {
        return !std::__fcxx_invoke(std::get<0>(std::forward<_State>(__s)), std::forward<_Args>(__args)...);
    }
};

struct __fcxx_bind_front_pattern {
    template <class _State, size_t... _Is, class... _Args>
    static constexpr auto __call(_State&& __s, index_sequence<_Is...>, _Args&&... __args) noexcept(
        noexcept(std::__fcxx_invoke(std::get<0>(std::forward<_State>(__s)), std::get<_Is>(std::forward<_State>(__s))...,
                                    std::forward<_Args>(__args)...)))
        -> decltype(std::__fcxx_invoke(std::get<0>(std::forward<_State>(__s)),
                                       std::get<_Is>(std::forward<_State>(__s))..., std::forward<_Args>(__args)...)) {
        return std::__fcxx_invoke(std::get<0>(std::forward<_State>(__s)), std::get<_Is>(std::forward<_State>(__s))...,
                                  std::forward<_Args>(__args)...);
    }
};

struct __fcxx_bind_back_pattern {
    template <class _State, size_t... _Is, class... _Args>
    static constexpr auto __call(_State&& __s, index_sequence<_Is...>, _Args&&... __args) noexcept(
        noexcept(std::__fcxx_invoke(std::get<0>(std::forward<_State>(__s)), std::forward<_Args>(__args)...,
                                    std::get<_Is>(std::forward<_State>(__s))...)))
        -> decltype(std::__fcxx_invoke(std::get<0>(std::forward<_State>(__s)), std::forward<_Args>(__args)...,
                                       std::get<_Is>(std::forward<_State>(__s))...)) {
        return std::__fcxx_invoke(std::get<0>(std::forward<_State>(__s)), std::forward<_Args>(__args)...,
                                  std::get<_Is>(std::forward<_State>(__s))...);
    }
};

/* The indices of the bound arguments in the tuple, after the target. */
template <class _Seq>
struct __fcxx_bound_indices;

template <size_t... _Is>
struct __fcxx_bound_indices<index_sequence<_Is...> > {
    typedef index_sequence<(_Is + 1)...> type;
};

template <class _Pattern, class _State, class _Seq, class _Void, class... _Args>
struct __fcxx_pf_callable : false_type {};

template <class _Pattern, class _State, class _Seq, class... _Args>
struct __fcxx_pf_callable<
    _Pattern, _State, _Seq,
    __fcxx_void_t<decltype(_Pattern::__call(std::declval<_State>(), _Seq(), std::declval<_Args>()...))>, _Args...>
    : true_type {};

struct __fcxx_pf_tag {};

template <class _Pattern, class _Fd, class... _Bound>
class __fcxx_pf_wrapper {
    typedef tuple<_Fd, _Bound...> _State;
    typedef typename __fcxx_bound_indices<index_sequence_for<_Bound...> >::type _Seq;

    _State __state;

public:
    template <class _Fn, class... _Args>
    constexpr explicit __fcxx_pf_wrapper(__fcxx_pf_tag, _Fn&& __f, _Args&&... __args)
        : __state(std::forward<_Fn>(__f), std::forward<_Args>(__args)...) {}

    template <class... _Args,
              __fcxx_enable_if_t<__fcxx_pf_callable<_Pattern, _State&, _Seq, void, _Args...>::value, int> = 0>
    constexpr auto operator()(_Args&&... __args) & noexcept(
        noexcept(_Pattern::__call(std::declval<_State&>(), _Seq(), std::declval<_Args>()...)))
        -> decltype(_Pattern::__call(std::declval<_State&>(), _Seq(), std::declval<_Args>()...)) {
        return _Pattern::__call(__state, _Seq(), std::forward<_Args>(__args)...);
    }

    template <class... _Args,
              __fcxx_enable_if_t<!__fcxx_pf_callable<_Pattern, _State&, _Seq, void, _Args...>::value, int> = 0>
    void operator()(_Args&&...) & = delete;

    template <class... _Args,
              __fcxx_enable_if_t<__fcxx_pf_callable<_Pattern, const _State&, _Seq, void, _Args...>::value, int> = 0>
    constexpr auto operator()(_Args&&... __args) const& noexcept(
        noexcept(_Pattern::__call(std::declval<const _State&>(), _Seq(), std::declval<_Args>()...)))
        -> decltype(_Pattern::__call(std::declval<const _State&>(), _Seq(), std::declval<_Args>()...)) {
        return _Pattern::__call(__state, _Seq(), std::forward<_Args>(__args)...);
    }

    template <class... _Args,
              __fcxx_enable_if_t<!__fcxx_pf_callable<_Pattern, const _State&, _Seq, void, _Args...>::value, int> = 0>
    void operator()(_Args&&...) const& = delete;

    template <class... _Args,
              __fcxx_enable_if_t<__fcxx_pf_callable<_Pattern, _State&&, _Seq, void, _Args...>::value, int> = 0>
    constexpr auto operator()(_Args&&... __args) && noexcept(
        noexcept(_Pattern::__call(std::declval<_State&&>(), _Seq(), std::declval<_Args>()...)))
        -> decltype(_Pattern::__call(std::declval<_State&&>(), _Seq(), std::declval<_Args>()...)) {
        return _Pattern::__call(std::move(__state), _Seq(), std::forward<_Args>(__args)...);
    }

    template <class... _Args,
              __fcxx_enable_if_t<!__fcxx_pf_callable<_Pattern, _State&&, _Seq, void, _Args...>::value, int> = 0>
    void operator()(_Args&&...) && = delete;

    template <class... _Args,
              __fcxx_enable_if_t<__fcxx_pf_callable<_Pattern, const _State&&, _Seq, void, _Args...>::value, int> = 0>
    constexpr auto operator()(_Args&&... __args) const&& noexcept(
        noexcept(_Pattern::__call(std::declval<const _State&&>(), _Seq(), std::declval<_Args>()...)))
        -> decltype(_Pattern::__call(std::declval<const _State&&>(), _Seq(), std::declval<_Args>()...)) {
        return _Pattern::__call(std::move(__state), _Seq(), std::forward<_Args>(__args)...);
    }

    template <class... _Args,
              __fcxx_enable_if_t<!__fcxx_pf_callable<_Pattern, const _State&&, _Seq, void, _Args...>::value, int> = 0>
    void operator()(_Args&&...) const&& = delete;
};

/* [func.not.fn], function template not_fn */
template <class _Fp>
constexpr __fcxx_pf_wrapper<__fcxx_not_fn_pattern, __fcxx_decay_t<_Fp> > not_fn(_Fp&& __f) {
    static_assert(is_constructible<__fcxx_decay_t<_Fp>, _Fp>::value
                      && is_move_constructible<__fcxx_decay_t<_Fp>>::value,
                  "std::not_fn of a callable object that cannot be decayed-copied");
    return __fcxx_pf_wrapper<__fcxx_not_fn_pattern, __fcxx_decay_t<_Fp> >(__fcxx_pf_tag(), std::forward<_Fp>(__f));
}

#if _FCXX_STD >= 2026
/* The target object of the call wrappers of a constant callable object,
 * which is empty, and calls the constant. */
template <auto _Fn>
struct __fcxx_constant_fn {
    template <class... _Args>
    constexpr auto operator()(_Args&&... __args) const
        noexcept(noexcept(std::__fcxx_invoke(_Fn, std::declval<_Args>()...)))
            -> decltype(std::__fcxx_invoke(_Fn, std::declval<_Args>()...)) {
        return std::__fcxx_invoke(_Fn, std::forward<_Args>(__args)...);
    }
};

/* Whether a constant callable object is a null pointer, which the forms
 * that take one as a template argument mandate it is not.
 * Workaround: GCC, with -fno-delete-null-pointer-checks, which is the default
 * for AVR: as a function can be at the address 0 then, it takes no
 * comparison of the address of a function, or of a pointer to a member
 * function, with a null pointer for a constant expression. Where the
 * comparison is not a constant, the pointer is the address of a function,
 * not a null one. */
template <auto _Fn>
constexpr bool __fcxx_null_callable() noexcept {
    using _Fp = decltype(_Fn);
    if constexpr (is_pointer_v<_Fp> || is_member_pointer_v<_Fp>) {
        return __builtin_constant_p(_Fn == nullptr) && _Fn == nullptr;
    } else {
        return false;
    }
}

template <auto _Fn>
consteval void __fcxx_check_constant_fn() {
    static_assert(!std::__fcxx_null_callable<_Fn>(), "a null pointer is not callable");
}

template <auto _Fn>
constexpr __fcxx_pf_wrapper<__fcxx_not_fn_pattern, __fcxx_constant_fn<_Fn> > not_fn() noexcept {
    std::__fcxx_check_constant_fn<_Fn>();
    return __fcxx_pf_wrapper<__fcxx_not_fn_pattern, __fcxx_constant_fn<_Fn> >(__fcxx_pf_tag(),
                                                                            __fcxx_constant_fn<_Fn>());
}
#endif

/* [func.bind.partial], function templates bind_front and bind_back */

template <class _Fp, class... _Args>
struct __fcxx_bind_partial_check {
    static_assert(is_constructible<__fcxx_decay_t<_Fp>, _Fp>::value
                      && is_move_constructible<__fcxx_decay_t<_Fp>>::value,
                  "the callable object cannot be decayed-copied");
    static_assert(__fcxx_and<is_constructible<__fcxx_decay_t<_Args>, _Args>...,
                             is_move_constructible<__fcxx_decay_t<_Args> >...>::value,
                  "the bound arguments cannot be decayed-copied");
    static constexpr bool value = true;
};

template <class _Fp, class... _Args>
constexpr __fcxx_pf_wrapper<__fcxx_bind_front_pattern, __fcxx_decay_t<_Fp>, __fcxx_decay_t<_Args>...> bind_front(
    _Fp&& __f, _Args&&... __args) {
    static_assert(__fcxx_bind_partial_check<_Fp, _Args...>::value, "");
    return __fcxx_pf_wrapper<__fcxx_bind_front_pattern, __fcxx_decay_t<_Fp>, __fcxx_decay_t<_Args>...>(
        __fcxx_pf_tag(), std::forward<_Fp>(__f), std::forward<_Args>(__args)...);
}

template <class _Fp, class... _Args>
constexpr __fcxx_pf_wrapper<__fcxx_bind_back_pattern, __fcxx_decay_t<_Fp>, __fcxx_decay_t<_Args>...> bind_back(
    _Fp&& __f, _Args&&... __args) {
    static_assert(__fcxx_bind_partial_check<_Fp, _Args...>::value, "");
    return __fcxx_pf_wrapper<__fcxx_bind_back_pattern, __fcxx_decay_t<_Fp>, __fcxx_decay_t<_Args>...>(
        __fcxx_pf_tag(), std::forward<_Fp>(__f), std::forward<_Args>(__args)...);
}

#if _FCXX_STD >= 2026
template <auto _Fn, class... _Args>
constexpr __fcxx_pf_wrapper<__fcxx_bind_front_pattern, __fcxx_constant_fn<_Fn>, __fcxx_decay_t<_Args>...> bind_front(
    _Args&&... __args) {
    std::__fcxx_check_constant_fn<_Fn>();
    static_assert(__fcxx_bind_partial_check<__fcxx_constant_fn<_Fn>, _Args...>::value, "");
    return __fcxx_pf_wrapper<__fcxx_bind_front_pattern, __fcxx_constant_fn<_Fn>, __fcxx_decay_t<_Args>...>(
        __fcxx_pf_tag(), __fcxx_constant_fn<_Fn>(), std::forward<_Args>(__args)...);
}

template <auto _Fn, class... _Args>
constexpr __fcxx_pf_wrapper<__fcxx_bind_back_pattern, __fcxx_constant_fn<_Fn>, __fcxx_decay_t<_Args>...> bind_back(
    _Args&&... __args) {
    std::__fcxx_check_constant_fn<_Fn>();
    static_assert(__fcxx_bind_partial_check<__fcxx_constant_fn<_Fn>, _Args...>::value, "");
    return __fcxx_pf_wrapper<__fcxx_bind_back_pattern, __fcxx_constant_fn<_Fn>, __fcxx_decay_t<_Args>...>(
        __fcxx_pf_tag(), __fcxx_constant_fn<_Fn>(), std::forward<_Args>(__args)...);
}
#endif

/* [func.bind], function object binders */

template <class _Tp>
struct is_bind_expression : false_type {};

template <class _Tp>
struct is_bind_expression<const _Tp> : is_bind_expression<_Tp> {};

template <class _Tp>
struct is_bind_expression<volatile _Tp> : is_bind_expression<_Tp> {};

template <class _Tp>
struct is_bind_expression<const volatile _Tp> : is_bind_expression<_Tp> {};

template <class _Tp>
struct is_placeholder : integral_constant<int, 0> {};

template <class _Tp>
struct is_placeholder<const _Tp> : is_placeholder<_Tp> {};

template <class _Tp>
struct is_placeholder<volatile _Tp> : is_placeholder<_Tp> {};

template <class _Tp>
struct is_placeholder<const volatile _Tp> : is_placeholder<_Tp> {};

template <class _Tp>
inline constexpr bool is_bind_expression_v = is_bind_expression<_Tp>::value;

template <class _Tp>
inline constexpr int is_placeholder_v = is_placeholder<_Tp>::value;

/* [func.bind.place], placeholders */
template <int _Np>
struct __fcxx_placeholder {};

template <int _Np>
struct is_placeholder<__fcxx_placeholder<_Np> > : integral_constant<int, _Np> {};

namespace placeholders {
inline constexpr __fcxx_placeholder<1> _1{};
inline constexpr __fcxx_placeholder<2> _2{};
inline constexpr __fcxx_placeholder<3> _3{};
inline constexpr __fcxx_placeholder<4> _4{};
inline constexpr __fcxx_placeholder<5> _5{};
inline constexpr __fcxx_placeholder<6> _6{};
inline constexpr __fcxx_placeholder<7> _7{};
inline constexpr __fcxx_placeholder<8> _8{};
inline constexpr __fcxx_placeholder<9> _9{};
inline constexpr __fcxx_placeholder<10> _10{};
} /* namespace placeholders */

/* The argument that bind passes for a bound argument of type _Td, cv-
 * qualified like the call wrapper, from the arguments of the call, which
 * are in a tuple of references: the reference of a reference_wrapper, the
 * result of the call of a bind expression, an argument of the call for a
 * placeholder, and the bound argument otherwise. */
template <class _Td, class _Args, class = void>
struct __fcxx_bind_arg {
    static constexpr _Td& __get(_Td& __td, _Args&) noexcept {
        return __td;
    }
};

template <class _Td, class _Args>
struct __fcxx_bind_arg<_Td, _Args, __fcxx_enable_if_t<__fcxx_is_reference_wrapper<__fcxx_remove_cv_t<_Td> >::value> > {
    static constexpr typename __fcxx_remove_cv_t<_Td>::type& __get(_Td& __td, _Args&) noexcept {
        return __td.get();
    }
};

template <class _Td, class _Seq, class _Args, class = void>
struct __fcxx_bind_nested_call {};

template <class _Td, size_t... _Js, class... _Us>
struct __fcxx_bind_nested_call<_Td, index_sequence<_Js...>, tuple<_Us...>,
                               __fcxx_void_t<decltype(std::declval<_Td&>()(std::declval<_Us>()...))> > {
    typedef decltype(std::declval<_Td&>()(std::declval<_Us>()...)) _Result;

    static constexpr _Result __get(_Td& __td, tuple<_Us...>& __args) {
        return __td(std::get<_Js>(std::move(__args))...);
    }
};

template <class _Td, class... _Us>
struct __fcxx_bind_arg<_Td, tuple<_Us...>,
                       __fcxx_enable_if_t<!__fcxx_is_reference_wrapper<__fcxx_remove_cv_t<_Td> >::value
                                          && is_bind_expression<__fcxx_remove_cv_t<_Td> >::value> >
    : __fcxx_bind_nested_call<_Td, index_sequence_for<_Us...>, tuple<_Us...> > {};

template <int _Jp, class _Args, bool = (_Jp <= int(tuple_size<_Args>::value))>
struct __fcxx_bind_placeholder_arg {};

template <int _Jp, class... _Us>
struct __fcxx_bind_placeholder_arg<_Jp, tuple<_Us...>, true> {
    template <class _Td>
    static constexpr typename tuple_element<_Jp - 1, tuple<_Us...>>::type&&
    __get(_Td&, tuple<_Us...>& __args) noexcept {
        return std::get<_Jp - 1>(std::move(__args));
    }
};

template <class _Td, class _Args>
struct __fcxx_bind_arg<_Td, _Args,
                       __fcxx_enable_if_t<!__fcxx_is_reference_wrapper<__fcxx_remove_cv_t<_Td> >::value
                                          && !is_bind_expression<__fcxx_remove_cv_t<_Td> >::value
                                          && (is_placeholder<__fcxx_remove_cv_t<_Td> >::value > 0)> >
    : __fcxx_bind_placeholder_arg<is_placeholder<__fcxx_remove_cv_t<_Td> >::value, _Args> {};

/* The call of the target object of a bind expression, with the arguments
 * bind passes, as INVOKE, or as INVOKE<R> for bind<R>. */
struct __fcxx_bind_no_result {};

template <class _Fd, class _TdTuple, class _Seq, class _Args, class = void>
struct __fcxx_bind_call {};

template <class _Fd, class... _Td, size_t... _Is, class _Args>
struct __fcxx_bind_call<
    _Fd, tuple<_Td...>, index_sequence<_Is...>, _Args,
    __fcxx_void_t<decltype(std::__fcxx_invoke(std::declval<_Fd&>(),
                                              __fcxx_bind_arg<_Td, _Args>::__get(std::declval<_Td&>(),
                                                                                 std::declval<_Args&>())...))> > {
    typedef decltype(std::__fcxx_invoke(
        std::declval<_Fd&>(),
        __fcxx_bind_arg<_Td, _Args>::__get(std::declval<_Td&>(), std::declval<_Args&>())...)) _Result;

    template <class _Tuple>
    static constexpr _Result __call(_Fd& __fd, _Tuple& __td, _Args&& __args) {
        return std::__fcxx_invoke(__fd, __fcxx_bind_arg<_Td, _Args>::__get(std::get<_Is>(__td), __args)...);
    }
};

template <class _Rp, class _Fd, class _TdTuple, class _Seq, class _Args, bool = is_void<_Rp>::value>
struct __fcxx_bind_call_r_impl {
    typedef __fcxx_bind_call<_Fd, _TdTuple, _Seq, _Args> _Call;
    typedef _Rp _Result;

    template <class _Tuple>
    static constexpr _Rp __call(_Fd& __fd, _Tuple& __td, _Args&& __args) {
        return _Call::__call(__fd, __td, std::move(__args));
    }
};

template <class _Rp, class _Fd, class _TdTuple, class _Seq, class _Args>
struct __fcxx_bind_call_r_impl<_Rp, _Fd, _TdTuple, _Seq, _Args, true> {
    typedef __fcxx_bind_call<_Fd, _TdTuple, _Seq, _Args> _Call;
    typedef _Rp _Result;

    template <class _Tuple>
    static constexpr _Rp __call(_Fd& __fd, _Tuple& __td, _Args&& __args) {
        static_cast<void>(_Call::__call(__fd, __td, std::move(__args)));
    }
};

/* INVOKE<R>, where the result converts to R, which may not bind a reference
 * to a temporary from C++23 on. */
template <class _Rp, class _Fd, class _TdTuple, class _Seq, class _Args, class = void>
struct __fcxx_bind_call_r {};

template <class _Rp, class _Fd, class _TdTuple, class _Seq, class _Args>
struct __fcxx_bind_call_r<_Rp, _Fd, _TdTuple, _Seq, _Args,
                          __fcxx_enable_if_t<__fcxx_is_invocable_r<
                              _Rp, typename __fcxx_bind_call<_Fd, _TdTuple, _Seq, _Args>::_Result (*)()>::value>>
    : __fcxx_bind_call_r_impl<_Rp, _Fd, _TdTuple, _Seq, _Args> {};

template <class _Rp, class _Fd, class _TdTuple, class _Seq, class _Args>
struct __fcxx_bind_invoke : __fcxx_bind_call_r<_Rp, _Fd, _TdTuple, _Seq, _Args> {};

template <class _Fd, class _TdTuple, class _Seq, class _Args>
struct __fcxx_bind_invoke<__fcxx_bind_no_result, _Fd, _TdTuple, _Seq, _Args>
    : __fcxx_bind_call<_Fd, _TdTuple, _Seq, _Args> {};

template <class _Invoke, class = void>
struct __fcxx_bind_callable : false_type {};

template <class _Invoke>
struct __fcxx_bind_callable<_Invoke, __fcxx_void_t<typename _Invoke::_Result> > : true_type {};

struct __fcxx_bind_tag {};

template <class _Rp, class _Fd, class... _Td>
class __fcxx_bind_t {
    typedef make_index_sequence<sizeof...(_Td)> _Seq;

    _Fd __fd;
    tuple<_Td...> __td;

    template <class _Fcv, class _Tcv, class... _Us>
    struct __invoke : __fcxx_bind_invoke<_Rp, _Fcv, _Tcv, _Seq, tuple<_Us&&...> > {};

public:
    template <class _Fn, class... _Args>
    constexpr explicit __fcxx_bind_t(__fcxx_bind_tag, _Fn&& __f, _Args&&... __args)
        : __fd(std::forward<_Fn>(__f)), __td(std::forward<_Args>(__args)...) {}

    /* The call operators that cannot make the call are deleted, so that the
     * call of a non-const bind expression does not fall back to that of a
     * const one. */
    template <class... _Us,
              __fcxx_enable_if_t<__fcxx_bind_callable<__invoke<_Fd, tuple<_Td...>, _Us...> >::value, int> = 0>
    constexpr typename __invoke<_Fd, tuple<_Td...>, _Us...>::_Result operator()(_Us&&... __us) {
        return __invoke<_Fd, tuple<_Td...>, _Us...>::__call(__fd, __td,
                                                            tuple<_Us&&...>(std::forward<_Us>(__us)...));
    }

    template <class... _Us,
              __fcxx_enable_if_t<!__fcxx_bind_callable<__invoke<_Fd, tuple<_Td...>, _Us...> >::value, int> = 0>
    void operator()(_Us&&...) = delete;

    template <
        class... _Us,
        __fcxx_enable_if_t<__fcxx_bind_callable<__invoke<const _Fd, tuple<const _Td...>, _Us...>>::value, int> = 0>
    constexpr typename __invoke<const _Fd, tuple<const _Td...>, _Us...>::_Result
    operator()(_Us&&... __us) const {
        return __invoke<const _Fd, tuple<const _Td...>, _Us...>::__call(__fd, __td,
                                                                        tuple<_Us&&...>(std::forward<_Us>(__us)...));
    }

    template <
        class... _Us,
        __fcxx_enable_if_t<!__fcxx_bind_callable<__invoke<const _Fd, tuple<const _Td...>, _Us...>>::value, int> = 0>
    void operator()(_Us&&...) const = delete;
};

template <class _Rp, class _Fd, class... _Td>
struct is_bind_expression<__fcxx_bind_t<_Rp, _Fd, _Td...> > : true_type {};

/* [func.bind.bind], function template bind */
template <class _Fp, class... _Args>
constexpr __fcxx_bind_t<__fcxx_bind_no_result, __fcxx_decay_t<_Fp>, __fcxx_decay_t<_Args>...> bind(
    _Fp&& __f, _Args&&... __args) {
    static_assert(__fcxx_and<is_constructible<__fcxx_decay_t<_Fp>, _Fp>,
                             is_constructible<__fcxx_decay_t<_Args>, _Args>...>::value,
                  "std::bind of arguments that cannot be decayed-copied");
    return __fcxx_bind_t<__fcxx_bind_no_result, __fcxx_decay_t<_Fp>, __fcxx_decay_t<_Args>...>(
        __fcxx_bind_tag(), std::forward<_Fp>(__f), std::forward<_Args>(__args)...);
}

