    template <class... _Slices>
        requires (sizeof...(_Slices) == extents_type::rank())
    friend constexpr auto submdspan_mapping(const mapping& __src, _Slices... __slices) {
        return __src.__submdspan_mapping_impl(__slices...);
    }
