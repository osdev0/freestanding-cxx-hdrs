     * the product of the extents of those before it. Among the dimensions
     * of a same stride, those of extent 1 come first. */
    constexpr bool is_exhaustive() const noexcept {
        if constexpr (__rank == 0) {
            return true;
        } else {
            for (rank_type __r = 0; __r != __rank; ++__r) {
                if (__exts.extent(__r) == 0) {
                    return true;
