/* [mdspan.sub.extents], subextents function */
template <class _Ext, class... _Slices>
constexpr auto __fcxx_md_subextents(const _Ext& __src, _Slices... __slices) {
    std::__fcxx_md_check_slices<_Ext, _Slices...>();
    using _Info = __fcxx_md_sub_info<_Ext, _Slices...>;
    return std::__fcxx_md_sub_extents<typename _Info::__sub_extents, _Info>(__src, index_sequence_for<_Slices...>(),
                                                                            __slices...);
}

template <class _IndexType, size_t... _Extents, class... _SliceSpecifiers>
    requires (sizeof...(_SliceSpecifiers) == sizeof...(_Extents))
constexpr auto subextents(const extents<_IndexType, _Extents...>& __src, _SliceSpecifiers... __raw_slices) {
    return std::__fcxx_md_subextents(__src, std::__fcxx_md_canonical_slice<_IndexType>(std::move(__raw_slices))...);
}

/* [mdspan.sub.canonical], submdspan slice canonicalization */
template <class _IndexType, size_t... _Extents, class... _SliceSpecifiers>
    requires (sizeof...(_SliceSpecifiers) == sizeof...(_Extents))
constexpr auto canonical_slices(const extents<_IndexType, _Extents...>& __src, _SliceSpecifiers... __slices) {
    (void)__src;
    std::__fcxx_md_check_slices<
        extents<_IndexType, _Extents...>,
        decltype(std::__fcxx_md_canonical_slice<_IndexType>(std::declval<_SliceSpecifiers>()))...>();
    return std::make_tuple(std::__fcxx_md_canonical_slice<_IndexType>(std::move(__slices))...);
}

/* sliceable-mapping, where submdspan_mapping is only looked up by argument
 * dependent lookup. */
namespace __fcxx_submdspan_adl {

void submdspan_mapping();

template <class _Map, class... _Slices>
constexpr auto __call(const _Map& __m, _Slices... __slices)
    -> decltype(submdspan_mapping(__m, std::move(__slices)...)) {
    return submdspan_mapping(__m, std::move(__slices)...);
}

template <class _Map, size_t... _Is>
auto __sliced(const _Map& __m, index_sequence<_Is...>)
    -> decltype(submdspan_mapping(__m, ((void)_Is, full_extent)...));

} /* namespace __fcxx_submdspan_adl */

template <class _Tp>
inline constexpr bool __fcxx_md_is_mapping_result = false;

template <class _Mp>
inline constexpr bool __fcxx_md_is_mapping_result<submdspan_mapping_result<_Mp> > = true;

template <class _LayoutMapping>
concept __fcxx_md_sliceable_mapping =
    requires(const _LayoutMapping& __lm) {
        __fcxx_submdspan_adl::__sliced(__lm, make_index_sequence<_LayoutMapping::extents_type::rank()>());
    }
    && __fcxx_md_is_mapping_result<remove_cvref_t<decltype(__fcxx_submdspan_adl::__sliced(
        std::declval<const _LayoutMapping&>(), make_index_sequence<_LayoutMapping::extents_type::rank()>()))> >;

/* [mdspan.sub.sub], submdspan function template */
template <class _ElementType, class _Extents, class _LayoutPolicy, class _AccessorPolicy, class... _Slices>
constexpr auto __fcxx_md_submdspan(const mdspan<_ElementType, _Extents, _LayoutPolicy, _AccessorPolicy>& __src,
                                   _Slices... __slices) {
    std::__fcxx_md_check_slices<_Extents, _Slices...>();
    auto __sub = __fcxx_submdspan_adl::__call(__src.mapping(), std::move(__slices)...);
    using _Off = typename _AccessorPolicy::offset_policy;
    using _SubMap = decltype(__sub.mapping);
    return mdspan<typename _Off::element_type, typename _SubMap::extents_type, typename _SubMap::layout_type, _Off>(
        __src.accessor().offset(__src.data_handle(), __sub.offset), __sub.mapping, _Off(__src.accessor()));
}

template <class _ElementType, class _Extents, class _LayoutPolicy, class _AccessorPolicy, class... _SliceSpecifiers>
    requires (sizeof...(_SliceSpecifiers) == _Extents::rank()
              && __fcxx_md_sliceable_mapping<typename _LayoutPolicy::template mapping<_Extents> >)
constexpr auto submdspan(const mdspan<_ElementType, _Extents, _LayoutPolicy, _AccessorPolicy>& __src,
                         _SliceSpecifiers... __raw_slices) {
    return std::__fcxx_md_submdspan(
        __src, std::__fcxx_md_canonical_slice<typename _Extents::index_type>(std::move(__raw_slices))...);
}
