namespace std {

/* The largest unsigned type, in which the largest value of every integer
 * type is representable, and its signed counterpart. */
#ifdef __SIZEOF_INT128__
__extension__ typedef unsigned __int128 __fcxx_md_umax;
__extension__ typedef __int128 __fcxx_md_smax;
#else
typedef unsigned long long __fcxx_md_umax;
typedef long long __fcxx_md_smax;
#endif

/* The largest value of an integer type. */
template <class _Tp>
inline constexpr __fcxx_md_umax __fcxx_md_max_of =
    is_signed_v<_Tp> ? static_cast<__fcxx_md_umax>(static_cast<make_unsigned_t<_Tp> >(-1) >> 1)
                     : static_cast<__fcxx_md_umax>(static_cast<_Tp>(-1));

/* Whether a value of an integer type is representable as a value of
 * another. */
template <class _Tp, class _Up>
constexpr bool __fcxx_md_in_range(_Up __v) noexcept {
    if constexpr (is_signed_v<_Up>) {
        if (__v < 0) {
            if constexpr (is_signed_v<_Tp>) {
                return static_cast<__fcxx_md_smax>(__v) >= -static_cast<__fcxx_md_smax>(__fcxx_md_max_of<_Tp>) - 1;
            } else {
                return false;
            }
        }
    }
    return static_cast<__fcxx_md_umax>(__v) <= __fcxx_md_max_of<_Tp>;
}

/* A table of sizes, computed at compile time, with at least one element. */
template <size_t _Np>
struct __fcxx_md_table {
    size_t __v[_Np];
};

/* dynamic-index(r) for each r of [0, rank()], and dynamic-index-inv(i) for
 * each i of [0, rank_dynamic()). */
template <size_t... _Extents>
constexpr __fcxx_md_table<sizeof...(_Extents) + 1> __fcxx_md_dynamic_index_table() noexcept {
    const size_t __exts[] = {_Extents..., 0};
    __fcxx_md_table<sizeof...(_Extents) + 1> __t{};
    size_t __n = 0;
    for (size_t __r = 0; __r != sizeof...(_Extents) + 1; ++__r) {
        __t.__v[__r] = __n;
        if (__exts[__r] == dynamic_extent) {
            ++__n;
        }
    }
    return __t;
}

template <size_t _RankDynamic, size_t... _Extents>
constexpr __fcxx_md_table<_RankDynamic + 1> __fcxx_md_dynamic_index_inv_table() noexcept {
    const size_t __exts[] = {_Extents..., 0};
    __fcxx_md_table<_RankDynamic + 1> __t{};
    size_t __n = 0;
    for (size_t __r = 0; __r != sizeof...(_Extents); ++__r) {
        if (__exts[__r] == dynamic_extent) {
            __t.__v[__n++] = __r;
        }
    }
    return __t;
}

/* dynamic_extent, for each element of a pack. */
template <size_t>
inline constexpr size_t __fcxx_md_dynamic = dynamic_extent;

/* The dynamic extents of an extents object, of which there may be none. */
template <class _It, size_t _Nd>
struct __fcxx_md_dyn_exts {
    _It __v[_Nd];
};

template <class _It>
struct __fcxx_md_dyn_exts<_It, 0> {};

/* [mdspan.extents], class template extents */
template <class _IndexType, size_t... _Extents>
class extents {
    static_assert(__fcxx_is_cmp_integer<_IndexType>::value && is_same_v<_IndexType, remove_cv_t<_IndexType> >,
                  "std::extents needs a signed or unsigned integer type as its index type");
    static_assert(((_Extents == dynamic_extent || std::__fcxx_md_in_range<_IndexType>(_Extents)) && ...),
                  "std::extents with a static extent that its index type cannot represent");

    static constexpr size_t __num_dynamic = ((_Extents == dynamic_extent ? 1 : 0) + ... + 0);
    static constexpr size_t __static_exts[sizeof...(_Extents) + 1] = {_Extents..., 0};
    static constexpr __fcxx_md_table<sizeof...(_Extents) + 1> __dyn_index =
        std::__fcxx_md_dynamic_index_table<_Extents...>();
    static constexpr __fcxx_md_table<__num_dynamic + 1> __dyn_index_inv =
        std::__fcxx_md_dynamic_index_inv_table<__num_dynamic, _Extents...>();

public:
    using index_type = _IndexType;
    using size_type = make_unsigned_t<index_type>;
    using rank_type = size_t;

    /* [mdspan.extents.obs], observers of the multidimensional index space */
    static constexpr rank_type rank() noexcept { return sizeof...(_Extents); }
    static constexpr rank_type rank_dynamic() noexcept { return __num_dynamic; }
    static constexpr size_t static_extent(rank_type __i) noexcept { return __static_exts[__i]; }

    constexpr index_type extent(rank_type __i) const noexcept {
        if constexpr (__num_dynamic == 0) {
            return static_cast<index_type>(__static_exts[__i]);
        } else if constexpr (__num_dynamic == sizeof...(_Extents)) {
            return __dyn.__v[__i];
        } else {
            return __static_exts[__i] == dynamic_extent ? __dyn.__v[__dyn_index.__v[__i]]
                                                        : static_cast<index_type>(__static_exts[__i]);
        }
    }

    /* [mdspan.extents.cons], constructors */
    constexpr extents() noexcept = default;

    template <class _OtherIndexType, size_t... _OtherExtents>
        requires (sizeof...(_OtherExtents) == sizeof...(_Extents)
                  && ((_OtherExtents == dynamic_extent || _Extents == dynamic_extent || _OtherExtents == _Extents)
                      && ...))
    constexpr explicit((((_Extents != dynamic_extent) && (_OtherExtents == dynamic_extent)) || ...)
                       || (__fcxx_md_max_of<index_type> < __fcxx_md_max_of<_OtherIndexType>))
        extents(const extents<_OtherIndexType, _OtherExtents...>& __other) noexcept {
        if constexpr (__num_dynamic != 0) {
            for (rank_type __d = 0; __d != __num_dynamic; ++__d) {
                __dyn.__v[__d] = static_cast<index_type>(__other.extent(__dyn_index_inv.__v[__d]));
            }
        }
    }

    template <class... _OtherIndexTypes>
        requires ((is_convertible_v<_OtherIndexTypes, index_type> && ...)
                  && (is_nothrow_constructible_v<index_type, _OtherIndexTypes> && ...)
                  && (sizeof...(_OtherIndexTypes) == __num_dynamic
                      || sizeof...(_OtherIndexTypes) == sizeof...(_Extents)))
    constexpr explicit extents(_OtherIndexTypes... __exts) noexcept {
        if constexpr (__num_dynamic != 0) {
            const index_type __values[] = {static_cast<index_type>(std::move(__exts))...};
            __set(__values, sizeof...(_OtherIndexTypes));
        }
    }

    template <class _OtherIndexType, size_t _Np>
        requires (is_convertible_v<const _OtherIndexType&, index_type>
                  && is_nothrow_constructible_v<index_type, const _OtherIndexType&>
                  && (_Np == __num_dynamic || _Np == sizeof...(_Extents)))
    constexpr explicit(_Np != __num_dynamic) extents(span<_OtherIndexType, _Np> __exts) noexcept {
        if constexpr (__num_dynamic != 0) {
            __set(__exts, _Np);
        }
    }

    template <class _OtherIndexType, size_t _Np>
        requires (is_convertible_v<const _OtherIndexType&, index_type>
                  && is_nothrow_constructible_v<index_type, const _OtherIndexType&>
                  && (_Np == __num_dynamic || _Np == sizeof...(_Extents)))
    constexpr explicit(_Np != __num_dynamic) extents(const array<_OtherIndexType, _Np>& __exts) noexcept {
        if constexpr (__num_dynamic != 0) {
            __set(__exts, _Np);
        }
    }

    /* [mdspan.extents.cmp], comparison operators */
    template <class _OtherIndexType, size_t... _OtherExtents>
    friend constexpr bool operator==(const extents& __lhs,
                                     const extents<_OtherIndexType, _OtherExtents...>& __rhs) noexcept {
        if constexpr (sizeof...(_OtherExtents) != sizeof...(_Extents)) {
            return false;
        } else {
            for (rank_type __r = 0; __r != sizeof...(_Extents); ++__r) {
                if (!std::cmp_equal(__lhs.extent(__r), __rhs.extent(__r))) {
                    return false;
                }
            }
            return true;
        }
    }

    /* [mdspan.extents.expo], exposition-only helpers, which the layout
     * mappings use. */
    constexpr size_t __fwd_prod_of_extents(rank_type __i) const noexcept {
        size_t __p = 1;
        for (rank_type __k = 0; __k != __i; ++__k) {
            __p *= static_cast<size_t>(extent(__k));
        }
        return __p;
    }

    constexpr size_t __rev_prod_of_extents(rank_type __i) const noexcept {
        size_t __p = 1;
        for (rank_type __k = __i + 1; __k != sizeof...(_Extents); ++__k) {
            __p *= static_cast<size_t>(extent(__k));
        }
        return __p;
    }

    template <class _OtherIndexType>
    static constexpr auto __index_cast(_OtherIndexType&& __i) noexcept {
        if constexpr (is_integral_v<remove_cvref_t<_OtherIndexType> >
                      && !is_same_v<remove_cvref_t<_OtherIndexType>, bool>) {
            return __i;
        } else {
            return static_cast<index_type>(std::forward<_OtherIndexType>(__i));
        }
    }

private:
    /* Sets the dynamic extents from all of the extents, or from the dynamic
     * ones only. */
    template <class _Src>
    constexpr void __set(const _Src& __src, size_t __n) noexcept {
        for (rank_type __d = 0; __d != __num_dynamic; ++__d) {
            const size_t __from = __n == __num_dynamic ? __d : __dyn_index_inv.__v[__d];
            __dyn.__v[__d] = static_cast<index_type>(std::as_const(__src[__from]));
        }
    }

    _FCXX_NO_UNIQUE_ADDRESS __fcxx_md_dyn_exts<_IndexType, __num_dynamic> __dyn{};
};

/* The deduction guide, which deduces static extents from the constants
 * carried by types from C++26 on. */
template <class... _Integrals>
    requires (is_convertible_v<_Integrals, size_t> && ...)
explicit extents(_Integrals...) -> extents<size_t, __fcxx_maybe_static_ext<_Integrals>...>;

/* [mdspan.extents.dextents], alias template dextents */
template <class _IndexType, class _Seq>
struct __fcxx_md_dextents;

template <class _IndexType, size_t... _Is>
struct __fcxx_md_dextents<_IndexType, index_sequence<_Is...> > {
    using type = extents<_IndexType, __fcxx_md_dynamic<_Is>...>;
};

template <class _IndexType, size_t _Rank>
using dextents = typename __fcxx_md_dextents<_IndexType, make_index_sequence<_Rank> >::type;

/* [mdspan.extents.dims], alias template dims */
template <size_t _Rank, class _IndexType = size_t>
using dims = dextents<_IndexType, _Rank>;

template <class _Tp>
inline constexpr bool __fcxx_md_is_extents = false;

template <class _IndexType, size_t... _Extents>
inline constexpr bool __fcxx_md_is_extents<extents<_IndexType, _Extents...> > = true;

/* Whether the size of the index space of static extents is representable as
 * a value of their index type, which the layout mappings mandate. */
template <class _Extents>
constexpr bool __fcxx_md_static_size_fits() noexcept {
    if constexpr (_Extents::rank_dynamic() != 0) {
        return true;
    } else {
        for (size_t __r = 0; __r != _Extents::rank(); ++__r) {
            if (_Extents::static_extent(__r) == 0) {
                return true;
            }
        }
        __fcxx_md_umax __size = 1;
        for (size_t __r = 0; __r != _Extents::rank(); ++__r) {
            const __fcxx_md_umax __e = _Extents::static_extent(__r);
            if (__size > __fcxx_md_max_of<typename _Extents::index_type> / __e) {
                return false;
            }
            __size *= __e;
        }
        return true;
    }
}

/* [mdspan.layout.policy.overview], layout mapping policies */
struct layout_left {
    template <class _Extents>
    class mapping;
};

struct layout_right {
    template <class _Extents>
    class mapping;
};

struct layout_stride {
    template <class _Extents>
    class mapping;
};

template <size_t _PaddingValue = dynamic_extent>
struct layout_left_padded {
    template <class _Extents>
    class mapping;
};

template <size_t _PaddingValue = dynamic_extent>
struct layout_right_padded {
    template <class _Extents>
    class mapping;
};

/* is-mapping-of, is-layout-left-padded-mapping-of and
 * is-layout-right-padded-mapping-of, which reject the types without the
 * members they look at. */
template <class _Layout, class _Mapping, class = void>
struct __fcxx_md_is_mapping_of : false_type {};

template <class _Layout, class _Mapping>
struct __fcxx_md_is_mapping_of<_Layout, _Mapping, __fcxx_void_t<typename _Mapping::extents_type> >
    : bool_constant<is_same_v<typename _Layout::template mapping<typename _Mapping::extents_type>, _Mapping> > {};

template <class _Mapping, class = void>
struct __fcxx_md_is_left_padded : false_type {};

template <class _Mapping>
struct __fcxx_md_is_left_padded<
    _Mapping, __fcxx_void_t<typename _Mapping::extents_type,
                            __fcxx_enable_if_t<is_same_v<decltype(_Mapping::padding_value), const size_t> > > >
    : bool_constant<is_same_v<typename layout_left_padded<_Mapping::padding_value>::template mapping<
                                  typename _Mapping::extents_type>,
                              _Mapping> > {};

template <class _Mapping, class = void>
struct __fcxx_md_is_right_padded : false_type {};

template <class _Mapping>
struct __fcxx_md_is_right_padded<
    _Mapping, __fcxx_void_t<typename _Mapping::extents_type,
                            __fcxx_enable_if_t<is_same_v<decltype(_Mapping::padding_value), const size_t> > > >
    : bool_constant<is_same_v<typename layout_right_padded<_Mapping::padding_value>::template mapping<
                                  typename _Mapping::extents_type>,
                              _Mapping> > {};

/* layout-mapping-alike */
template <class _Mp>
concept __fcxx_md_layout_mapping_alike = requires {
    requires __fcxx_md_is_extents<typename _Mp::extents_type>;
    { _Mp::is_always_strided() } -> same_as<bool>;
    { _Mp::is_always_exhaustive() } -> same_as<bool>;
    { _Mp::is_always_unique() } -> same_as<bool>;
    bool_constant<_Mp::is_always_strided()>::value;
    bool_constant<_Mp::is_always_exhaustive()>::value;
    bool_constant<_Mp::is_always_unique()>::value;
};

/* OFFSET(m), the offset of the first element of a mapping. */
template <class _Mapping, size_t... _Is>
constexpr typename _Mapping::index_type __fcxx_md_offset_at_zero(const _Mapping& __m, index_sequence<_Is...>) {
    return __m(((void)_Is, static_cast<typename _Mapping::index_type>(0))...);
}

template <class _Mapping>
constexpr typename _Mapping::index_type __fcxx_md_offset(const _Mapping& __m) {
    using _Ext = typename _Mapping::extents_type;
    if constexpr (_Ext::rank() == 0) {
        return __m();
    } else {
        for (size_t __r = 0; __r != _Ext::rank(); ++__r) {
            if (__m.extents().extent(__r) == 0) {
                return 0;
            }
        }
        return std::__fcxx_md_offset_at_zero(__m, make_index_sequence<_Ext::rank()>());
    }
}

/* LEAST-MULTIPLE-AT-LEAST(x, y), and whether it is representable as a value
 * of size_t and of an index type. */
constexpr size_t __fcxx_md_lmal(size_t __x, size_t __y) noexcept {
    return __x == 0 ? __y : (__y / __x + (__y % __x != 0 ? 1 : 0)) * __x;
}

template <class _It>
constexpr bool __fcxx_md_lmal_fits(size_t __x, size_t __y) noexcept {
    if (__x == 0) {
        return std::__fcxx_md_in_range<_It>(__y);
    }
    const __fcxx_md_umax __q = __y / __x + (__y % __x != 0 ? 1 : 0);
    const __fcxx_md_umax __r = __q * __x;
    return __r <= static_cast<size_t>(-1) && __r <= __fcxx_md_max_of<_It>;
}

template <class _It>
constexpr _It __fcxx_md_lmal_index(_It __x, _It __y) noexcept {
    return __x == 0 ? __y : static_cast<_It>((__y / __x + (__y % __x != 0 ? 1 : 0)) * __x);
}

/* Whether the product of LEAST-MULTIPLE-AT-LEAST(padding, extent k) and the
 * other static extents is representable as a value of size_t and of the
 * index type, where the extents are all static. */
template <class _Extents, size_t _Pad, size_t _Kp>
constexpr bool __fcxx_md_padded_size_fits() noexcept {
    using _It = typename _Extents::index_type;
    for (size_t __r = 0; __r != _Extents::rank(); ++__r) {
        if (_Extents::static_extent(__r) == dynamic_extent) {
            return true;
        }
    }
    if (!std::__fcxx_md_lmal_fits<_It>(_Pad, _Extents::static_extent(_Kp))) {
        return false;
    }
    __fcxx_md_umax __max = __fcxx_md_max_of<_It>;
    if (static_cast<size_t>(-1) < __max) {
        __max = static_cast<size_t>(-1);
    }
    __fcxx_md_umax __size = std::__fcxx_md_lmal(_Pad, _Extents::static_extent(_Kp));
    for (size_t __r = 0; __r != _Extents::rank(); ++__r) {
        if (__r != _Kp) {
            const __fcxx_md_umax __e = _Extents::static_extent(__r);
            if (__e == 0) {
                return true;
            }
            if (__size > __max / __e) {
                return false;
            }
            __size *= __e;
        }
    }
    return __size <= __max;
}

