/* [mdspan.sub.range.slices], range slices, whose members are integers or
 * integral-constant-like. */
template <class _Tp>
concept __fcxx_md_slice_value = __fcxx_is_cmp_integer<_Tp>::value || __fcxx_integral_constant_like<_Tp>;

template <class _OffsetType, class _ExtentType, class _StrideType>
struct extent_slice {
    static_assert(__fcxx_md_slice_value<_OffsetType> && __fcxx_md_slice_value<_ExtentType>
                      && __fcxx_md_slice_value<_StrideType>,
                  "std::extent_slice of types that are neither integers nor integral-constant-like");

    using offset_type = _OffsetType;
    using extent_type = _ExtentType;
    using stride_type = _StrideType;

    _FCXX_NO_UNIQUE_ADDRESS offset_type offset{};
    _FCXX_NO_UNIQUE_ADDRESS extent_type extent{};
    _FCXX_NO_UNIQUE_ADDRESS stride_type stride{};
};

template <class _FirstType, class _LastType, class _StrideType = constant_wrapper<static_cast<size_t>(1), size_t> >
struct range_slice {
    static_assert(__fcxx_md_slice_value<_FirstType> && __fcxx_md_slice_value<_LastType>
                      && __fcxx_md_slice_value<_StrideType>,
                  "std::range_slice of types that are neither integers nor integral-constant-like");

    _FCXX_NO_UNIQUE_ADDRESS _FirstType first{};
    _FCXX_NO_UNIQUE_ADDRESS _LastType last{};
    _FCXX_NO_UNIQUE_ADDRESS _StrideType stride{};
};

