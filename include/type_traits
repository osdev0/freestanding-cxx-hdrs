/* [meta.unary.comp], composite type categories */

template <class _Tp>
struct is_arithmetic : __fcxx_bool_constant<is_integral<_Tp>::value || is_floating_point<_Tp>::value> {};

template <class _Tp>
struct is_fundamental
    : __fcxx_bool_constant<is_arithmetic<_Tp>::value || is_void<_Tp>::value || __fcxx_is_null_pointer<_Tp>::value
                      || __fcxx_is_reflection<_Tp>::value> {};

template <class _Tp>
struct is_object
    : __fcxx_bool_constant<!is_function<_Tp>::value && !is_reference<_Tp>::value && !is_void<_Tp>::value> {};

template <class _Tp>
struct is_scalar
    : __fcxx_bool_constant<is_arithmetic<_Tp>::value || is_enum<_Tp>::value || is_pointer<_Tp>::value
                      || is_member_pointer<_Tp>::value || __fcxx_is_null_pointer<_Tp>::value
                      || __fcxx_is_reflection<_Tp>::value> {};

template <class _Tp>
struct is_compound : __fcxx_bool_constant<!is_fundamental<_Tp>::value> {};

