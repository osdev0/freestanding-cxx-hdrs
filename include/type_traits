/* Swapping is looked up as with "using std::swap;", along with whatever the
 * arguments bring in, which the two function templates of <utility> are
 * here for. From C++23 on, std::swap names them (below), so that the
 * lookup finds the same functions either way. */
namespace __fcxx_swap_lookup {

template <class _Tp>
_FCXX_CONSTEXPR20 typename enable_if<is_move_constructible<_Tp>::value && is_move_assignable<_Tp>::value>::type
swap(_Tp& __a, _Tp& __b) noexcept(is_nothrow_move_constructible<_Tp>::value
                                  && is_nothrow_move_assignable<_Tp>::value) {
    _Tp __tmp(std::__fcxx_move(__a));
    __a = std::__fcxx_move(__b);
    __b = std::__fcxx_move(__tmp);
}

template <class _Tp, size_t _Np>
_FCXX_CONSTEXPR20 typename enable_if<__fcxx_is_swappable_with_impl<_Tp&, _Tp&>::value>::type
swap(_Tp (&__a)[_Np], _Tp (&__b)[_Np]) noexcept(__fcxx_is_nothrow_swappable_with_impl<_Tp&, _Tp&>::value) {
    for (size_t __i = 0; __i != _Np; ++__i) {
        swap(__a[__i], __b[__i]);
    }
}

