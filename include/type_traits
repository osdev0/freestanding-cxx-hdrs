    typedef __fcxx_conditional_t<
        sizeof(unsigned char) == _Sz, unsigned char,
        __fcxx_conditional_t<
            sizeof(unsigned short) == _Sz, unsigned short,
            __fcxx_conditional_t<sizeof(unsigned int) == _Sz, unsigned int,
                                 __fcxx_conditional_t<sizeof(unsigned long) == _Sz, unsigned long,
#    ifdef __SIZEOF_INT128__
                                                      __fcxx_conditional_t<sizeof(unsigned long long) == _Sz,
