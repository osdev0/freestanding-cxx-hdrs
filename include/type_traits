/* Whether a type is constructible from arguments of given types, which is
 * whether "T t(declval<Args>()...);" is well-formed. */

#if _FCXX_HAS_TYPE_TRAIT(is_constructible, 800)
template <class _Tp, class... _Args>
struct is_constructible : __fcxx_bool_constant<__is_constructible(_Tp, _Args...)> {};
#  if (_FCXX_GCC >= 801 && _FCXX_GCC <= 803) || _FCXX_GCC == 901
/* Workaround: GCC 8.1 to 8.3 and 9.1, all targets: the builtin takes the
 * arrays of unknown bound to be default constructible. */
template <class _Tp>
struct is_constructible<_Tp[]> : false_type {};
#  endif
#else
/* A placement new-expression checks the construction of an object type, and
 * a reference binds as in an implicit conversion, which leaves out only the
 * explicit conversion functions to a reference. */
template <class _From, class _To>
struct __fcxx_binds_implicitly {
    template <class _Up> static void __take(_Up) noexcept;
    template <class _F1, class _T1, class = decltype(__take<_T1>(__fcxx_declval<_F1>()))>
    static true_type __test(int);
    template <class, class>
    static false_type __test(...);
    typedef decltype(__test<_From, _To>(0)) type;
};

template <class _Void, class _Tp, class... _Args>
struct __fcxx_is_constructible_object : false_type {};

template <class _Tp, class... _Args>
struct __fcxx_is_constructible_object<
    __fcxx_void_t<decltype(::new (__fcxx_declval<void*>()) _Tp(__fcxx_declval<_Args>()...))>, _Tp, _Args...>
    : true_type {};

template <class _Tp, class... _Args>
struct __fcxx_is_constructible_impl : __fcxx_is_constructible_object<void, _Tp, _Args...> {};

template <class _Tp, class _Arg>
struct __fcxx_is_constructible_impl<_Tp&, _Arg> : __fcxx_binds_implicitly<_Arg, _Tp&>::type {};

template <class _Tp, class _Arg>
struct __fcxx_is_constructible_impl<_Tp&&, _Arg>
    : __fcxx_bool_constant<__fcxx_binds_implicitly<_Arg, _Tp&&>::type::value
                           && !(is_lvalue_reference<_Arg>::value && !is_function<_Tp>::value)> {};

template <class _Tp, class... _Args>
struct is_constructible
    : __fcxx_bool_constant<!is_void<_Tp>::value && !is_function<_Tp>::value
                           && __fcxx_is_constructible_impl<_Tp, _Args...>::value> {};

template <class _Tp, class... _Args>
struct is_constructible<_Tp[], _Args...> : false_type {};
#endif

template <class _Tp>
struct is_default_constructible : is_constructible<_Tp> {};

