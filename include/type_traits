/* [meta.help], helper class */

template <class _Tp, _Tp __v>
struct integral_constant {
    static constexpr _Tp value = __v;
    typedef _Tp value_type;
    typedef integral_constant type;
    constexpr operator value_type() const noexcept { return value; }
#if _FCXX_STD >= 2014
    constexpr value_type operator()() const noexcept { return value; }
#endif
};

#if !_FCXX_HAS_INLINE_VARIABLES
template <class _Tp, _Tp __v>
constexpr _Tp integral_constant<_Tp, __v>::value;
#endif

typedef integral_constant<bool, true> true_type;
typedef integral_constant<bool, false> false_type;

template <bool _Bp>
using __fcxx_bool_constant = integral_constant<bool, _Bp>;

#if _FCXX_STD >= 2017
template <bool _Bp>
using bool_constant = integral_constant<bool, _Bp>;
#endif

/* [meta.rel], is_same, which everything else needs too */

template <class _Tp, class _Up> struct is_same : false_type {};
template <class _Tp> struct is_same<_Tp, _Tp> : true_type {};

/* [meta.trans.other], the helpers everything else needs */

template <bool, class _Tp = void>
struct enable_if {};

template <class _Tp>
struct enable_if<true, _Tp> {
    typedef _Tp type;
};

template <bool _Bp, class _Tp = void>
using __fcxx_enable_if_t = typename enable_if<_Bp, _Tp>::type;

template <bool _Bp, class _If, class _Then>
struct conditional {
    typedef _If type;
};

template <class _If, class _Then>
struct conditional<false, _If, _Then> {
    typedef _Then type;
};

template <bool _Bp, class _If, class _Then>
using __fcxx_conditional_t = typename conditional<_Bp, _If, _Then>::type;

/* A void_t that also works with the compilers that did not yet consider the
 * unused arguments of alias templates for SFINAE. */
template <class...>
struct __fcxx_make_void {
    typedef void type;
};

template <class... _Tp>
using __fcxx_void_t = typename __fcxx_make_void<_Tp...>::type;

template <class _Tp>
struct __fcxx_type_identity {
    typedef _Tp type;
};

/* [meta.trans.cv], const-volatile modifications */

template <class _Tp> struct remove_const { typedef _Tp type; };
template <class _Tp> struct remove_const<const _Tp> { typedef _Tp type; };

template <class _Tp> struct remove_volatile { typedef _Tp type; };
template <class _Tp> struct remove_volatile<volatile _Tp> { typedef _Tp type; };

template <class _Tp> struct remove_cv { typedef _Tp type; };
template <class _Tp> struct remove_cv<const _Tp> { typedef _Tp type; };
template <class _Tp> struct remove_cv<volatile _Tp> { typedef _Tp type; };
template <class _Tp> struct remove_cv<const volatile _Tp> { typedef _Tp type; };

template <class _Tp> struct add_const { typedef const _Tp type; };
template <class _Tp> struct add_volatile { typedef volatile _Tp type; };
template <class _Tp> struct add_cv { typedef const volatile _Tp type; };

template <class _Tp>
using __fcxx_remove_cv_t = typename remove_cv<_Tp>::type;

/* [meta.trans.ref], reference modifications */

template <class _Tp> struct remove_reference { typedef _Tp type; };
template <class _Tp> struct remove_reference<_Tp&> { typedef _Tp type; };
template <class _Tp> struct remove_reference<_Tp&&> { typedef _Tp type; };

template <class _Tp>
using __fcxx_remove_ref_t = typename remove_reference<_Tp>::type;

template <class _Tp>
struct __fcxx_remove_cvref {
    typedef typename remove_cv<typename remove_reference<_Tp>::type>::type type;
};

template <class _Tp>
using __fcxx_remove_cvref_t = typename __fcxx_remove_cvref<_Tp>::type;

/* A type can be referred to unless it is cv void or a function type with a
 * cv-qualifier or a ref-qualifier, and pointed to unless it is such a function
 * type too.
 * Workaround: GCC 4.8, all targets: it forms the references and the pointers
 * to the function types with qualifiers in SFINAE, as with
 * "template <class T, class = void> struct R {}; template <class T> struct
 * R<T, decltype(void(static_cast<T*>(nullptr)))>;", which picks the second
 * for R<void() const>, so those function types are told apart by their
 * forms. */
#if _FCXX_GCC && _FCXX_GCC < 409
template <class _Tp>
struct __fcxx_qualified_function {
    typedef void type;
};

#  define _FCXX_QUALIFIED_FUNCTION(q) \
    template <class _Rp, class... _Args> \
    struct __fcxx_qualified_function<_Rp(_Args...) q> {}; \
    template <class _Rp, class... _Args> \
    struct __fcxx_qualified_function<_Rp(_Args..., ...) q> {};
_FCXX_QUALIFIED_FUNCTION(const)
_FCXX_QUALIFIED_FUNCTION(volatile)
_FCXX_QUALIFIED_FUNCTION(const volatile)
#  if _FCXX_HAS_REF_QUALIFIERS
_FCXX_QUALIFIED_FUNCTION(&)
_FCXX_QUALIFIED_FUNCTION(const&)
_FCXX_QUALIFIED_FUNCTION(volatile&)
_FCXX_QUALIFIED_FUNCTION(const volatile&)
_FCXX_QUALIFIED_FUNCTION(&&)
_FCXX_QUALIFIED_FUNCTION(const&&)
_FCXX_QUALIFIED_FUNCTION(volatile&&)
_FCXX_QUALIFIED_FUNCTION(const volatile&&)
#  endif
#  undef _FCXX_QUALIFIED_FUNCTION

template <class _Tp>
using __fcxx_void_ref_t = __fcxx_void_t<typename __fcxx_qualified_function<_Tp>::type, _Tp&>;
template <class _Tp>
using __fcxx_void_ptr_t = __fcxx_void_t<typename __fcxx_qualified_function<_Tp>::type, _Tp*>;
#else
template <class _Tp>
using __fcxx_void_ref_t = __fcxx_void_t<_Tp&>;
template <class _Tp>
using __fcxx_void_ptr_t = __fcxx_void_t<_Tp*>;
#endif

template <class _Tp, class = void>
struct __add_reference_impl {
    typedef _Tp __lvalue;
    typedef _Tp __rvalue;
};

template <class _Tp>
struct __add_reference_impl<_Tp, __fcxx_void_ref_t<_Tp> > {
    typedef _Tp& __lvalue;
    typedef _Tp&& __rvalue;
};

template <class _Tp>
struct add_lvalue_reference {
    typedef typename __add_reference_impl<_Tp>::__lvalue type;
};

template <class _Tp>
struct add_rvalue_reference {
    typedef typename __add_reference_impl<_Tp>::__rvalue type;
};

template <class _Tp, class = void>
struct __fcxx_is_referenceable : false_type {};

template <class _Tp>
struct __fcxx_is_referenceable<_Tp, __fcxx_void_ref_t<_Tp> > : true_type {};

/* declval, of <utility>, which the traits are described in terms of, under
 * a name of the library's own, as <utility> is only freestanding from C++23
 * on, where the name of the standard is declared along with it (below). */
template <class _Tp>
typename add_rvalue_reference<_Tp>::type __fcxx_declval() noexcept;

