#ifndef __FREESTANDING_CXX_HDRS_SYSTEM_ERROR
#define __FREESTANDING_CXX_HDRS_SYSTEM_ERROR 1

#pragma GCC system_header

#include <__fcxx/config.h>
_FCXX_BEGIN_EXTERN_CXX

#if _FCXX_STD < 2026
#  error "<system_error> is not a freestanding header before C++26"
#endif

#define _FCXX_VERSION_SYSTEM_ERROR
#include <__fcxx/version.h>
#undef _FCXX_VERSION_SYSTEM_ERROR

#if _FCXX_STD >= 2026

/* Of the header, only the error conditions are freestanding. */
#include <__fcxx/errc.h>

#include <compare>

#endif

_FCXX_END_EXTERN_CXX
#endif
