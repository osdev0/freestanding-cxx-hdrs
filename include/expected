    /* [expected.void.eq], equality operators, constrained from C++26 on */

    template <class _T2, class _E2>
        requires (is_void<_T2>::value && __fcxx_eq_comparable<_Ep, _E2>)
    friend constexpr bool operator==(const expected& __x, const expected<_T2, _E2>& __y) {
        if (__x.has_value() != __y.has_value()) {
            return false;
        }
        if (__x.has_value()) {
            return true;
        }
        return __x.error() == __y.error();
    }

    template <class _E2>
        requires (__fcxx_eq_comparable<_Ep, _E2>)
    friend constexpr bool operator==(const expected& __x, const unexpected<_E2>& __e) {
        if (!__x.has_value()) {
            return __x.error() == __e.error();
        }
        return false;
    }

private:
    template <class _Fp, class... _Args>
    constexpr expected(__fcxx_expected_error_tag __tag, _Fp&& __f, _Args&&... __args)
        : _Base(__tag, std::forward<_Fp>(__f), std::forward<_Args>(__args)...) {}

    template <class _Self, class _Fp>
    static constexpr auto __and_then(_Self&& __self, _Fp&& __f) {
        typedef __fcxx_remove_cvref_t<invoke_result_t<_Fp> > _Up;
        static_assert(__fcxx_is_expected<_Up>::value,
                      "std::expected::and_then of a function not returning a std::expected");
        static_assert(is_same<typename _Up::error_type, _Ep>::value,
                      "std::expected::and_then of a function returning a std::expected of another error type");
        if (__self.__has_val) {
            return std::__fcxx_invoke(std::forward<_Fp>(__f));
        }
        return _Up(unexpect, std::forward<_Self>(__self).error());
    }

    template <class _Self, class _Fp>
    static constexpr auto __or_else(_Self&& __self, _Fp&& __f) {
        typedef __fcxx_remove_cvref_t<invoke_result_t<_Fp, decltype(std::forward<_Self>(__self).error())> > _Gp;
        static_assert(__fcxx_is_expected<_Gp>::value,
                      "std::expected::or_else of a function not returning a std::expected");
        static_assert(is_same<typename _Gp::value_type, _Tp>::value,
                      "std::expected::or_else of a function returning a std::expected of another value type");
        if (__self.__has_val) {
            return _Gp();
        }
        return std::__fcxx_invoke(std::forward<_Fp>(__f), std::forward<_Self>(__self).error());
    }

    template <class _Self, class _Fp>
    static constexpr auto __transform(_Self&& __self, _Fp&& __f) {
        typedef __fcxx_remove_cv_t<invoke_result_t<_Fp> > _Up;
        static_assert(__fcxx_expected_valid<_Up>::value,
                      "std::expected::transform of a function returning what std::expected cannot hold");
        if (!__self.__has_val) {
            return expected<_Up, _Ep>(unexpect, std::forward<_Self>(__self).error());
        }
        if constexpr (is_void<_Up>::value) {
            std::__fcxx_invoke(std::forward<_Fp>(__f));
            return expected<_Up, _Ep>();
        } else {
            return expected<_Up, _Ep>(__fcxx_expected_value_tag(), std::forward<_Fp>(__f));
        }
    }

    template <class _Self, class _Fp>
    static constexpr auto __transform_error(_Self&& __self, _Fp&& __f) {
        typedef __fcxx_remove_cv_t<invoke_result_t<_Fp, decltype(std::forward<_Self>(__self).error())> > _Gp;
        static_assert(__fcxx_unexpected_valid<_Gp>::value,
                      "std::expected::transform_error of a function returning what std::unexpected cannot hold");
        if (__self.__has_val) {
            return expected<_Tp, _Gp>();
        }
        return expected<_Tp, _Gp>(__fcxx_expected_error_tag(), std::forward<_Fp>(__f),
                                  std::forward<_Self>(__self).error());
    }
