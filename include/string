#ifndef __FREESTANDING_CXX_HDRS_STRING
#define __FREESTANDING_CXX_HDRS_STRING 1

#pragma GCC system_header

#include <__fcxx/config.h>
_FCXX_BEGIN_EXTERN_CXX

#if _FCXX_STD < 2026
#  error "<string> is not a freestanding header before C++26"
#endif

#define _FCXX_VERSION_STRING
#include <__fcxx/version.h>
#undef _FCXX_VERSION_STRING

#if _FCXX_STD >= 2026

/* Of <string>, only char_traits and its specializations are freestanding;
 * basic_string, and all that goes with it, is not. The header provides the
 * range access functions of <iterator> too, and includes the headers its
 * synopsis includes. */
#include <compare>
#include <initializer_list>
#include <__fcxx/range_access.h>
#include <__fcxx/char_traits.h>

#endif

_FCXX_END_EXTERN_CXX
#endif
