/* The special values of the floating-point types are what they are whatever
 * the options the program is compiled with, which Clang 18 and later warn
 * about where the options let it assume there are none (-ffinite-math-only,
 * of -ffast-math). */
#if _FCXX_CLANG >= 1800
#  pragma clang diagnostic push
#  pragma clang diagnostic ignored "-Wnan-infinity-disabled"
#endif

/* The floating-point types, whose properties the compilers predefine. The
 * digits of max_digits10 are those needed to tell every value apart. */
template <class _Dummy>
struct __float_limits {
    static _FCXX_LIMITS_CONST bool is_specialized = true;
    static _FCXX_LIMITS_CONST bool is_signed = true;
    static _FCXX_LIMITS_CONST bool is_integer = false;
    static _FCXX_LIMITS_CONST bool is_exact = false;
    static _FCXX_LIMITS_CONST bool has_infinity = __FLT_HAS_INFINITY__;
    static _FCXX_LIMITS_CONST bool has_quiet_NaN = __FLT_HAS_QUIET_NAN__;
    static _FCXX_LIMITS_CONST bool has_signaling_NaN = has_quiet_NaN;
    _FCXX_DEPRECATED_CXX23("deprecated in C++23")
    static _FCXX_LIMITS_CONST float_denorm_style has_denorm = __FLT_HAS_DENORM__ ? denorm_present : denorm_absent;
    _FCXX_DEPRECATED_CXX23("deprecated in C++23") static _FCXX_LIMITS_CONST bool has_denorm_loss = false;
    static _FCXX_LIMITS_CONST bool is_iec559 = has_infinity && has_quiet_NaN && __FLT_HAS_DENORM__;
    static _FCXX_LIMITS_CONST bool is_bounded = true;
    static _FCXX_LIMITS_CONST bool is_modulo = false;
    static _FCXX_LIMITS_CONST bool traps = false;
    static _FCXX_LIMITS_CONST bool tinyness_before = _FCXX_LIMITS_TINY_FLOAT;
    static _FCXX_LIMITS_CONST float_round_style round_style = round_to_nearest;
    static _FCXX_LIMITS_CONST int digits = __FLT_MANT_DIG__;
    static _FCXX_LIMITS_CONST int digits10 = __FLT_DIG__;
#if _FCXX_STD >= 2011
    static _FCXX_LIMITS_CONST int max_digits10 = 2 + __FLT_MANT_DIG__ * 643L / 2136;
#endif
    static _FCXX_LIMITS_CONST int radix = __FLT_RADIX__;
    static _FCXX_LIMITS_CONST int min_exponent = __FLT_MIN_EXP__;
    static _FCXX_LIMITS_CONST int min_exponent10 = __FLT_MIN_10_EXP__;
    static _FCXX_LIMITS_CONST int max_exponent = __FLT_MAX_EXP__;
    static _FCXX_LIMITS_CONST int max_exponent10 = __FLT_MAX_10_EXP__;

    static _FCXX_CONSTEXPR11 float min() _FCXX_NOEXCEPT { return __FLT_MIN__; }
    static _FCXX_CONSTEXPR11 float max() _FCXX_NOEXCEPT { return __FLT_MAX__; }
#if _FCXX_STD >= 2011
    static _FCXX_CONSTEXPR11 float lowest() _FCXX_NOEXCEPT { return -__FLT_MAX__; }
#endif
    static _FCXX_CONSTEXPR11 float epsilon() _FCXX_NOEXCEPT { return __FLT_EPSILON__; }
    static _FCXX_CONSTEXPR11 float round_error() _FCXX_NOEXCEPT { return 0.5F; }
    static _FCXX_CONSTEXPR11 float infinity() _FCXX_NOEXCEPT { return __builtin_huge_valf(); }
    static _FCXX_CONSTEXPR11 float quiet_NaN() _FCXX_NOEXCEPT { return __builtin_nanf(""); }
    static _FCXX_CONSTEXPR11 float signaling_NaN() _FCXX_NOEXCEPT { return __builtin_nansf(""); }
    static _FCXX_CONSTEXPR11 float denorm_min() _FCXX_NOEXCEPT { return __FLT_DENORM_MIN__; }
};

