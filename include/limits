/* The integer types, for which everything follows from their size and
 * signedness. */
template <class _Tp>
struct __integer_limits {
    static _FCXX_LIMITS_CONST bool is_specialized = true;
    static _FCXX_LIMITS_CONST bool is_signed = _Tp(-1) < _Tp(0);
    static _FCXX_LIMITS_CONST bool is_integer = true;
    static _FCXX_LIMITS_CONST bool is_exact = true;
    static _FCXX_LIMITS_CONST bool has_infinity = false;
    static _FCXX_LIMITS_CONST bool has_quiet_NaN = false;
    static _FCXX_LIMITS_CONST bool has_signaling_NaN = false;
    _FCXX_DEPRECATED_CXX23("deprecated in C++23")
    static _FCXX_LIMITS_CONST float_denorm_style has_denorm = denorm_absent;
    _FCXX_DEPRECATED_CXX23("deprecated in C++23") static _FCXX_LIMITS_CONST bool has_denorm_loss = false;
    static _FCXX_LIMITS_CONST bool is_iec559 = false;
    static _FCXX_LIMITS_CONST bool is_bounded = true;
    static _FCXX_LIMITS_CONST bool is_modulo = !is_signed;
    static _FCXX_LIMITS_CONST bool traps = _FCXX_LIMITS_INTEGER_TRAPS;
    static _FCXX_LIMITS_CONST bool tinyness_before = false;
    static _FCXX_LIMITS_CONST float_round_style round_style = round_toward_zero;
    static _FCXX_LIMITS_CONST int digits = static_cast<int>(sizeof(_Tp) * __CHAR_BIT__) - is_signed;
    static _FCXX_LIMITS_CONST int digits10 = static_cast<int>(digits * 643L / 2136);
#if _FCXX_STD >= 2011
    static _FCXX_LIMITS_CONST int max_digits10 = 0;
#endif
    static _FCXX_LIMITS_CONST int radix = 2;
    static _FCXX_LIMITS_CONST int min_exponent = 0;
    static _FCXX_LIMITS_CONST int min_exponent10 = 0;
    static _FCXX_LIMITS_CONST int max_exponent = 0;
    static _FCXX_LIMITS_CONST int max_exponent10 = 0;

    static _FCXX_CONSTEXPR11 _Tp min() _FCXX_NOEXCEPT { return is_signed ? _Tp(-max() - 1) : _Tp(0); }
    static _FCXX_CONSTEXPR11 _Tp max() _FCXX_NOEXCEPT {
        return is_signed ? _Tp(((_Tp(1) << (digits - 1)) - 1) * 2 + 1) : _Tp(~_Tp(0));
    }
#if _FCXX_STD >= 2011
    static _FCXX_CONSTEXPR11 _Tp lowest() _FCXX_NOEXCEPT { return min(); }
#endif
    static _FCXX_CONSTEXPR11 _Tp epsilon() _FCXX_NOEXCEPT { return _Tp(0); }
    static _FCXX_CONSTEXPR11 _Tp round_error() _FCXX_NOEXCEPT { return _Tp(0); }
    static _FCXX_CONSTEXPR11 _Tp infinity() _FCXX_NOEXCEPT { return _Tp(0); }
    static _FCXX_CONSTEXPR11 _Tp quiet_NaN() _FCXX_NOEXCEPT { return _Tp(0); }
    static _FCXX_CONSTEXPR11 _Tp signaling_NaN() _FCXX_NOEXCEPT { return _Tp(0); }
    static _FCXX_CONSTEXPR11 _Tp denorm_min() _FCXX_NOEXCEPT { return _Tp(0); }
};

