#ifndef __FREESTANDING_CXX_HDRS_LIMITS
#define __FREESTANDING_CXX_HDRS_LIMITS 1

#pragma GCC system_header

#include <__fcxx/config.h>

#define _FCXX_VERSION_LIMITS
#include <__fcxx/version.h>
#undef _FCXX_VERSION_LIMITS

/* The static data members are constexpr from C++11 on, and before C++17,
 * those that are odr-used need a definition outside of the class. Only the
 * static data members of templates can have one in a header, so all of the
 * specializations get theirs from the class templates below, which is also
 * what keeps the functions of the floating-point types from being defined
 * until they are used, as Clang cannot even define a function returning a
 * long double on targets without an FPU. */
#if _FCXX_STD >= 2011
#  define _FCXX_LIMITS_CONST constexpr
#else
#  define _FCXX_LIMITS_CONST const
#endif

/* Whether the integer types trap, which a division by zero does where the
 * hardware traps on it, as on x86, m68k, s390 and SPARC, where the routines
 * that divide do, as on Alpha and HPPA, and on MIPS, where GCC and Clang check
 * for it with a trap unless -mno-check-zero-division, which nothing tells. On
 * the others the division gives a value: on Arm without a division
 * instruction, the __aeabi_idiv0 of the runtime decides, and on LoongArch,
 * GCC checks for it at -O0 and -Og alone, which no constant can follow. */
#if defined(__i386__) || defined(__x86_64__) || defined(__m68k__) || defined(__s390__) || defined(__sparc__) \
    || defined(__alpha__) || defined(__hppa__) || defined(__mips__)
#  define _FCXX_LIMITS_INTEGER_TRAPS true
#else
#  define _FCXX_LIMITS_INTEGER_TRAPS false
#endif

/* Whether the floating-point arithmetic detects tininess before rounding,
 * which IEEE 754 leaves to each implementation. That of AArch64, PowerPC and
 * s390 does, as do Arm with the VFP for the types the VFP has, the 80-bit
 * long double of m68k, and the quadruple precision of SPARC, in software. The
 * others detect it after rounding: x86, RISC-V, MIPS, LoongArch, HPPA, SH, and
 * the float and double of m68k and SPARC. Without flags, as with Arm without
 * the VFP and the double-double long double of PowerPC, nothing is detected.
 * The half-precision types, computed in float, are as float. */
#if defined(__aarch64__) || defined(__s390__)
#  define _FCXX_LIMITS_TINY_FLOAT true
#  define _FCXX_LIMITS_TINY_DOUBLE true
#  define _FCXX_LIMITS_TINY_LONG_DOUBLE true
#  define _FCXX_LIMITS_TINY_FLOAT128 true
#elif defined(__powerpc__) && !defined(_SOFT_FLOAT) && !defined(__NO_FPRS__)
#  define _FCXX_LIMITS_TINY_FLOAT true
#  define _FCXX_LIMITS_TINY_DOUBLE true
#  ifdef __LONG_DOUBLE_IBM128__
#    define _FCXX_LIMITS_TINY_LONG_DOUBLE false
#  else
#    define _FCXX_LIMITS_TINY_LONG_DOUBLE true
#  endif
#  define _FCXX_LIMITS_TINY_FLOAT128 true
#elif defined(__arm__) && defined(__ARM_FP)
#  define _FCXX_LIMITS_TINY_FLOAT ((__ARM_FP & 4) != 0)
#  define _FCXX_LIMITS_TINY_DOUBLE ((__ARM_FP & 8) != 0)
#  define _FCXX_LIMITS_TINY_LONG_DOUBLE ((__ARM_FP & 8) != 0)
#  define _FCXX_LIMITS_TINY_FLOAT128 false
#elif defined(__m68k__) && __LDBL_MANT_DIG__ == 64
#  define _FCXX_LIMITS_TINY_FLOAT false
#  define _FCXX_LIMITS_TINY_DOUBLE false
#  define _FCXX_LIMITS_TINY_LONG_DOUBLE true
#  define _FCXX_LIMITS_TINY_FLOAT128 false
#elif defined(__sparc__)
#  define _FCXX_LIMITS_TINY_FLOAT false
#  define _FCXX_LIMITS_TINY_DOUBLE false
#  define _FCXX_LIMITS_TINY_LONG_DOUBLE (__LDBL_MANT_DIG__ == 113)
#  define _FCXX_LIMITS_TINY_FLOAT128 true
#else
#  define _FCXX_LIMITS_TINY_FLOAT false
#  define _FCXX_LIMITS_TINY_DOUBLE false
#  define _FCXX_LIMITS_TINY_LONG_DOUBLE false
#  define _FCXX_LIMITS_TINY_FLOAT128 false
#endif

namespace std {

enum float_round_style {
    round_indeterminate = -1,
    round_toward_zero = 0,
    round_to_nearest = 1,
    round_toward_infinity = 2,
    round_toward_neg_infinity = 3
};

enum _FCXX_DEPRECATED_CXX23("deprecated in C++23") float_denorm_style {
    denorm_indeterminate = -1,
    denorm_absent = 0,
    denorm_present = 1
};

/* The primary template, for the types that are not arithmetic. */
template <class _Tp>
class numeric_limits {
public:
    static _FCXX_LIMITS_CONST bool is_specialized = false;
    static _FCXX_LIMITS_CONST bool is_signed = false;
    static _FCXX_LIMITS_CONST bool is_integer = false;
    static _FCXX_LIMITS_CONST bool is_exact = false;
    static _FCXX_LIMITS_CONST bool has_infinity = false;
    static _FCXX_LIMITS_CONST bool has_quiet_NaN = false;
    static _FCXX_LIMITS_CONST bool has_signaling_NaN = false;
    _FCXX_DEPRECATED_CXX23("deprecated in C++23")
    static _FCXX_LIMITS_CONST float_denorm_style has_denorm = denorm_absent;
    _FCXX_DEPRECATED_CXX23("deprecated in C++23") static _FCXX_LIMITS_CONST bool has_denorm_loss = false;
    static _FCXX_LIMITS_CONST bool is_iec559 = false;
    static _FCXX_LIMITS_CONST bool is_bounded = false;
    static _FCXX_LIMITS_CONST bool is_modulo = false;
    static _FCXX_LIMITS_CONST bool traps = false;
    static _FCXX_LIMITS_CONST bool tinyness_before = false;
    static _FCXX_LIMITS_CONST float_round_style round_style = round_toward_zero;
    static _FCXX_LIMITS_CONST int digits = 0;
    static _FCXX_LIMITS_CONST int digits10 = 0;
#if _FCXX_STD >= 2011
    static _FCXX_LIMITS_CONST int max_digits10 = 0;
#endif
    static _FCXX_LIMITS_CONST int radix = 0;
    static _FCXX_LIMITS_CONST int min_exponent = 0;
    static _FCXX_LIMITS_CONST int min_exponent10 = 0;
    static _FCXX_LIMITS_CONST int max_exponent = 0;
    static _FCXX_LIMITS_CONST int max_exponent10 = 0;

    static _FCXX_CONSTEXPR11 _Tp min() _FCXX_NOEXCEPT { return _Tp(); }
    static _FCXX_CONSTEXPR11 _Tp max() _FCXX_NOEXCEPT { return _Tp(); }
#if _FCXX_STD >= 2011
    static _FCXX_CONSTEXPR11 _Tp lowest() _FCXX_NOEXCEPT { return _Tp(); }
#endif
    static _FCXX_CONSTEXPR11 _Tp epsilon() _FCXX_NOEXCEPT { return _Tp(); }
    static _FCXX_CONSTEXPR11 _Tp round_error() _FCXX_NOEXCEPT { return _Tp(); }
    static _FCXX_CONSTEXPR11 _Tp infinity() _FCXX_NOEXCEPT { return _Tp(); }
    static _FCXX_CONSTEXPR11 _Tp quiet_NaN() _FCXX_NOEXCEPT { return _Tp(); }
    static _FCXX_CONSTEXPR11 _Tp signaling_NaN() _FCXX_NOEXCEPT { return _Tp(); }
    static _FCXX_CONSTEXPR11 _Tp denorm_min() _FCXX_NOEXCEPT { return _Tp(); }
};

