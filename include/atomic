    _FCXX_ATOMIC_VOLATILE_LOCK_FREE(                                                                             \
        (void store_##key(_Tp __v, memory_order __m = memory_order_seq_cst) volatile noexcept),                 \
        { (void)fetch<_Tp>(&this->__value, __v, __m); })                                                         \
    _FCXX_ATOMIC_CE void store_##key(_Tp __v, memory_order __m = memory_order_seq_cst) noexcept {              \
