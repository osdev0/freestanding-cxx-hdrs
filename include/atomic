    if (sizeof(_Tp) <= 2 && __fcxx_atomic_loop_##op) {                                                           \
        const _Tp __old = __fcxx_atomic_fetch_loop(__p, __v, __m, __fcxx_atomic_op_##op());                      \
        return after ? __fcxx_atomic_op_##op()(__old, __v) : __old;                                               \
    }
#else
#  define _FCXX_ATOMIC_INTEGRAL_LOOP(op, after)
#endif

#define _FCXX_ATOMIC_INTEGRAL_OP(op)                                                                              \
    template <class _Tp, class _Up>                                                                               \
    _FCXX_ALWAYS_INLINE _FCXX_ATOMIC_CE _Tp __fcxx_atomic_fetch_##op(_Up* __p, _Tp __v, memory_order __m) noexcept { \
        _FCXX_ATOMIC_INTEGRAL_CE(op, false)                                                                       \
        _FCXX_ATOMIC_INTEGRAL_LOOP(op, false)                                                                     \
        return __atomic_fetch_##op(__fcxx_atomic_addr(__p), __v, __fcxx_atomic_order(__m));                     \
    }                                                                                                             \
    template <class _Tp, class _Up>                                                                               \
    _FCXX_ALWAYS_INLINE _FCXX_ATOMIC_CE _Tp __fcxx_atomic_##op##_fetch(_Up* __p, _Tp __v, memory_order __m) noexcept { \
