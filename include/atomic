enum {
    __fcxx_atomic_loop_add = 1,
    __fcxx_atomic_loop_sub = 0,
    __fcxx_atomic_loop_and = 1,
    __fcxx_atomic_loop_or = 1,
    __fcxx_atomic_loop_xor = 1
