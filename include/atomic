/* [atomics.fences], fences
 *
 * On the AVR and the MSP430, whose single core performs the accesses to
 * memory in the order of the program, and whose only other threads are the
 * interrupt handlers, a fence needs to be no more than a barrier to the
 * compiler, which is what it is there, with every compiler.
 * Workaround: Clang 6 to 23, MSP430: it cannot select any fence. */

#if defined(__AVR__) || defined(__MSP430__)
#  define _FCXX_ATOMIC_FENCE(fence, order) \
      if ((order) != __ATOMIC_RELAXED) {     \
          __asm__ __volatile__("" ::: "memory"); \
      }
#else
#  define _FCXX_ATOMIC_FENCE(fence, order) fence(order);
#endif

extern "C" {

_FCXX_ATOMIC_CE void atomic_thread_fence(memory_order __m) noexcept {
#if _FCXX_ATOMIC_CONSTEXPR
    if (__builtin_is_constant_evaluated()) {
        return;
    }
#endif
    _FCXX_ATOMIC_FENCE(__atomic_thread_fence, __fcxx_atomic_order(__m))
}

_FCXX_ATOMIC_CE void atomic_signal_fence(memory_order __m) noexcept {
#if _FCXX_ATOMIC_CONSTEXPR
    if (__builtin_is_constant_evaluated()) {
        return;
    }
#endif
    _FCXX_ATOMIC_FENCE(__atomic_signal_fence, __fcxx_atomic_order(__m))
}

