/* The read-modify-write operations the builtins have no direct form for,
 * as a loop of compare-and-exchange operations. The first value expected is
 * read with its padding cleared, as the values stored have theirs.
 *
 * Workaround: GCC before 11 (found with 8 to 10), i386: its peephole
 * optimizations lose a store to the object before such a loop, unless
 * something is taken to read and write the object in between. */
#if _FCXX_GCC && _FCXX_GCC < 1100 && defined(__i386__)
#  define _FCXX_ATOMIC_OBJECT_BARRIER(x) __asm__("" : "+m"(x))
#else
#  define _FCXX_ATOMIC_OBJECT_BARRIER(x) ((void)0)
#endif

/* Workaround: GCC 16, s390x: it crashes, expanding a conditional move of 2
 * bytes, on the selections of the maximum and the minimum of _Float16 with
 * a constant operand inlined into such a loop, so the operations on the
 * floating-point types of 2 bytes are made out of line there. */
