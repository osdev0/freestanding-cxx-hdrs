/* [atomics.types.generic], class template atomic
 *
 * The members are those of the bases, one for the operations of all of the
 * types, and one for those of each kind of type that has more. The standard
 * layout of the specializations comes from the value being in the first. */

template <class _Tp>
struct __fcxx_atomic_base {
#if _FCXX_STD >= 2017
    typedef _Tp value_type;

    static constexpr bool is_always_lock_free = __fcxx_atomic_always_lock_free<_Tp>::value;
#endif

    bool is_lock_free() const volatile noexcept {
        return __fcxx_atomic_lock_free_query<__fcxx_atomic_always_lock_free<_Tp>::value>::__query(sizeof(_Tp),
                                                                                                 &__value);
    }
    bool is_lock_free() const noexcept {
        return __fcxx_atomic_lock_free_query<__fcxx_atomic_always_lock_free<_Tp>::value>::__query(sizeof(_Tp),
                                                                                                 &__value);
    }

    _FCXX_ATOMIC_VOLATILE((void store(_Tp __d, memory_order __m = memory_order_seq_cst) volatile noexcept), {
        __fcxx_atomic_store<_Tp>(&__value, __d, __m);
    })
    _FCXX_ATOMIC_CE void store(_Tp __d, memory_order __m = memory_order_seq_cst) noexcept {
        __fcxx_atomic_store<_Tp>(&__value, __d, __m);
    }

    _FCXX_ATOMIC_VOLATILE((_Tp load(memory_order __m = memory_order_seq_cst) const volatile noexcept), {
        return __fcxx_atomic_load<_Tp>(&__value, __m);
    })
    _FCXX_ATOMIC_CE _Tp load(memory_order __m = memory_order_seq_cst) const noexcept {
        return __fcxx_atomic_load<_Tp>(&__value, __m);
    }

    _FCXX_ATOMIC_VOLATILE((operator _Tp() const volatile noexcept), {
        return __fcxx_atomic_load<_Tp>(&__value, memory_order_seq_cst);
    })
    _FCXX_ATOMIC_CE operator _Tp() const noexcept {
        return __fcxx_atomic_load<_Tp>(&__value, memory_order_seq_cst);
    }

    _FCXX_ATOMIC_VOLATILE((_Tp exchange(_Tp __d, memory_order __m = memory_order_seq_cst) volatile noexcept), {
        return __fcxx_atomic_exchange<_Tp>(&__value, __d, __m);
    })
    _FCXX_ATOMIC_CE _Tp exchange(_Tp __d, memory_order __m = memory_order_seq_cst) noexcept {
        return __fcxx_atomic_exchange<_Tp>(&__value, __d, __m);
    }

    _FCXX_ATOMIC_VOLATILE(
        (bool compare_exchange_weak(_Tp& __e, _Tp __d, memory_order __s, memory_order __f) volatile noexcept), {
            return __fcxx_atomic_compare_exchange<_Tp>(&__value, __e, __d, true, __s, __f);
        })
    _FCXX_ATOMIC_CE bool compare_exchange_weak(_Tp& __e, _Tp __d, memory_order __s, memory_order __f) noexcept {
        return __fcxx_atomic_compare_exchange<_Tp>(&__value, __e, __d, true, __s, __f);
    }
    _FCXX_ATOMIC_VOLATILE(
        (bool compare_exchange_strong(_Tp& __e, _Tp __d, memory_order __s, memory_order __f) volatile noexcept), {
            return __fcxx_atomic_compare_exchange<_Tp>(&__value, __e, __d, false, __s, __f);
        })
    _FCXX_ATOMIC_CE bool compare_exchange_strong(_Tp& __e, _Tp __d, memory_order __s, memory_order __f) noexcept {
        return __fcxx_atomic_compare_exchange<_Tp>(&__value, __e, __d, false, __s, __f);
    }
    _FCXX_ATOMIC_VOLATILE(
        (bool compare_exchange_weak(_Tp& __e, _Tp __d, memory_order __m = memory_order_seq_cst) volatile noexcept), {
            return __fcxx_atomic_compare_exchange<_Tp>(&__value, __e, __d, true, __m, __fcxx_atomic_failure_order(__m));
        })
    _FCXX_ATOMIC_CE bool compare_exchange_weak(_Tp& __e, _Tp __d, memory_order __m = memory_order_seq_cst) noexcept {
        return __fcxx_atomic_compare_exchange<_Tp>(&__value, __e, __d, true, __m, __fcxx_atomic_failure_order(__m));
    }
    _FCXX_ATOMIC_VOLATILE(
        (bool compare_exchange_strong(_Tp& __e, _Tp __d, memory_order __m = memory_order_seq_cst) volatile noexcept), {
            return __fcxx_atomic_compare_exchange<_Tp>(&__value, __e, __d, false, __m,
                                                       __fcxx_atomic_failure_order(__m));
        })
    _FCXX_ATOMIC_CE bool compare_exchange_strong(_Tp& __e, _Tp __d, memory_order __m = memory_order_seq_cst) noexcept {
        return __fcxx_atomic_compare_exchange<_Tp>(&__value, __e, __d, false, __m, __fcxx_atomic_failure_order(__m));
    }

#if _FCXX_STD >= 2020
    void wait(_Tp __old, memory_order __m = memory_order_seq_cst) const volatile noexcept {
        __fcxx_atomic_wait<_Tp>(&__value, __old, __m);
    }
    _FCXX_ATOMIC_CE void wait(_Tp __old, memory_order __m = memory_order_seq_cst) const noexcept {
        __fcxx_atomic_wait<_Tp>(&__value, __old, __m);
    }

    /* Nothing blocks on the waiting operations, which spin. */
    void notify_one() volatile noexcept {}
    _FCXX_ATOMIC_CE void notify_one() noexcept {}
    void notify_all() volatile noexcept {}
    _FCXX_ATOMIC_CE void notify_all() noexcept {}
#endif

protected:
    _Tp __value __attribute__((__aligned__(_FCXX_ATOMIC_ALIGNMENT(_Tp))));

#if _FCXX_STD >= 2020
    constexpr __fcxx_atomic_base() noexcept(is_nothrow_default_constructible<_Tp>::value) : __value() {}
#else
    __fcxx_atomic_base() noexcept = default;
#endif
    constexpr __fcxx_atomic_base(_Tp __d) noexcept : __value(__d) {}
    __fcxx_atomic_base(const __fcxx_atomic_base&) = delete;
    __fcxx_atomic_base& operator=(const __fcxx_atomic_base&) = delete;
    __fcxx_atomic_base& operator=(const __fcxx_atomic_base&) volatile = delete;
};

