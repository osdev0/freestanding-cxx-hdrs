#else
#  define _FCXX_ATOMIC_EXCHANGE(p, v, r, m) __atomic_exchange(p, v, r, m)
#endif

template <class _Tp, class _Up>
_FCXX_ALWAYS_INLINE _FCXX_ATOMIC_CE _Tp __fcxx_atomic_exchange(_Up* __p, _Tp __v, memory_order __m) noexcept {
#if _FCXX_ATOMIC_CONSTEXPR
