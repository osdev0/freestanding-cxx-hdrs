/* A read-modify-write operation with a loop at run time. */
template <class _Tp, class _Up, class _Fn>
_FCXX_ALWAYS_INLINE _FCXX_ATOMIC_CE _Tp __fcxx_atomic_fetch_op(_Up* __p, _Tp __v, memory_order __m, _Fn __fn) noexcept {
#if _FCXX_ATOMIC_CONSTEXPR
    if constexpr (!is_volatile<_Up>::value) {
