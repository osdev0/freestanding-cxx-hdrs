#endif
    __fcxx_atomic_clear_padding(&__old);
    for (;;) {
        __fcxx_atomic_holder<_Tp> __cur;
        __atomic_load(__fcxx_atomic_addr(__p), __fcxx_atomic_val(&__cur.__value), __fcxx_atomic_order(__m));
        __fcxx_atomic_clear_padding(&__cur.__value);
