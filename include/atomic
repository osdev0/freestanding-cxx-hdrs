/* The comparison of a compare-and-exchange is on the value representations,
 * without the padding bits. The values stored have theirs cleared, but those
 * of the object can have any value still, from its initialization when it
 * is not constant, or when the object is one atomic_ref refers to. When the
 * builtin fails on a value with only the padding different from the one
 * expected, it is retried with the padding found. */
template <bool _Padded>
struct __fcxx_atomic_cas {
    template <class _Tp, class _Up>
    static _FCXX_ALWAYS_INLINE bool __exchange(_Up* __p, _Tp& __e, _Tp& __d, bool __weak, int __s, int __f) noexcept {
        return __fcxx_atomic_builtin<_Tp>::__cas(__p, &__e, &__d, __weak, __s, __f);
    }
};

template <>
struct __fcxx_atomic_cas<true> {
    template <class _Tp, class _Up>
    static _FCXX_ALWAYS_INLINE bool __exchange(_Up* __p, _Tp& __e, _Tp& __d, bool __weak, int __s, int __f) noexcept {
        __fcxx_atomic_holder<_Tp> __want, __try, __found;
        __builtin_memcpy(static_cast<void*>(&__want.__value), static_cast<const void*>(&__e), sizeof(_Tp));
        __fcxx_atomic_clear_padding(&__want.__value);
        __builtin_memcpy(static_cast<void*>(&__try.__value), static_cast<const void*>(&__want.__value), sizeof(_Tp));
        for (;;) {
            if (__fcxx_atomic_builtin<_Tp>::__cas(__p, &__try.__value, &__d, __weak, __s, __f)) {
                return true;
            }
            __builtin_memcpy(static_cast<void*>(&__found.__value), static_cast<const void*>(&__try.__value),
                             sizeof(_Tp));
            __fcxx_atomic_clear_padding(&__found.__value);
            if (__builtin_memcmp(&__found.__value, &__want.__value, sizeof(_Tp)) != 0) {
                __builtin_memcpy(static_cast<void*>(&__e), static_cast<const void*>(&__try.__value), sizeof(_Tp));
                return false;
            }
        }
    }
};

template <class _Tp, class _Up>
_FCXX_ALWAYS_INLINE _FCXX_ATOMIC_CE bool __fcxx_atomic_compare_exchange(_Up* __p, _Tp& __e, _Tp __d, bool __weak,
                                                                        memory_order __s, memory_order __f) noexcept {
#if _FCXX_ATOMIC_CONSTEXPR
    if constexpr (!is_volatile<_Up>::value) {
        if (__builtin_is_constant_evaluated()) {
            if (__fcxx_atomic_same_ce(*__p, __e)) {
                *__p = __d;
                return true;
            }
            __e = *__p;
            return false;
        }
    }
#endif
    __fcxx_atomic_clear_padding(&__d);
    const int __fo = __fcxx_atomic_order(__f);
    return __fcxx_atomic_cas<__fcxx_atomic_padded<_Tp>::value>::__exchange(
        __p, __e, __d, __weak, __fcxx_atomic_success_order(__fcxx_atomic_order(__s), __fo), __fo);
}

/* Waits by spinning until the value representation differs from that of
 * the old value. */
template <class _Tp, class _Up>
_FCXX_ALWAYS_INLINE _FCXX_ATOMIC_CE void __fcxx_atomic_wait(_Up* __p, _Tp __old, memory_order __m) noexcept {
#if _FCXX_ATOMIC_CONSTEXPR
