    static _FCXX_ALWAYS_INLINE bool __cas(_Up* __p, _Tp* __e, _Tp* __d, bool __weak, int __s, int __f) noexcept {
        return __weak ? __atomic_compare_exchange(__fcxx_atomic_addr(__p), __fcxx_atomic_val(__e),
                                                  __fcxx_atomic_val(__d), true, _FCXX_ATOMIC_CAS_ORDER(__s),
                                                  _FCXX_ATOMIC_CAS_ORDER(__f))
                      : __atomic_compare_exchange(__fcxx_atomic_addr(__p), __fcxx_atomic_val(__e),
                                                  __fcxx_atomic_val(__d), false, _FCXX_ATOMIC_CAS_ORDER(__s),
                                                  _FCXX_ATOMIC_CAS_ORDER(__f));
