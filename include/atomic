    })                                                                                                           \
    _FCXX_ATOMIC_CE _Tp operator op##=(_Tp __v) noexcept {                                                      \
        return __fcxx_atomic_##key##_fetch<_Tp>(&this->__value, __v, memory_order_seq_cst);                      \
    }

template <class _Tp>
