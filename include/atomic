template <class _Tp, class _Fn>
__attribute__((__noinline__)) _Tp __fcxx_atomic_fetch_outline(_Fn __fn, _Tp __a, _Tp __b) noexcept {
    return __fn(__a, __b);
}

template <class _Tp, class _Fn>
_FCXX_ALWAYS_INLINE inline _Tp __fcxx_atomic_fetch_apply(_Fn __fn, _Tp __a, _Tp __b, true_type) noexcept {
    return __fcxx_atomic_fetch_outline(__fn, __a, __b);
}

template <class _Tp, class _Fn>
_FCXX_ALWAYS_INLINE inline _Tp __fcxx_atomic_fetch_apply(_Fn __fn, _Tp __a, _Tp __b, false_type) noexcept {
    return __fn(__a, __b);
}

#  define _FCXX_ATOMIC_FETCH_APPLY(fn, a, b) \
    __fcxx_atomic_fetch_apply(fn, a, b, __fcxx_bool_constant<is_floating_point<_Tp>::value && sizeof(_Tp) == 2>())
#else
#  define _FCXX_ATOMIC_FETCH_APPLY(fn, a, b) fn(a, b)
#endif

template <class _Tp, class _Up, class _Fn>
_FCXX_ALWAYS_INLINE inline _Tp __fcxx_atomic_fetch_loop(_Up* __p, _Tp __v, memory_order __m, _Fn __fn) noexcept {
    const int __mo = __fcxx_atomic_order(__m);
