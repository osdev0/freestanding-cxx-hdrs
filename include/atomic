/* The maximum and the minimum of the integers, for which Clang has builtins
 * where they are lock-free. */
template <class _Tp, class _Up>
_FCXX_ALWAYS_INLINE _FCXX_ATOMIC_CE _Tp __fcxx_atomic_fetch_max(_Up* __p, _Tp __v, memory_order __m) noexcept {
#  if _FCXX_HAS_BUILTIN(__atomic_fetch_max)
    if constexpr (is_integral<_Tp>::value && __fcxx_atomic_lock_free<_Tp>::value) {
#    if _FCXX_ATOMIC_CONSTEXPR
        if constexpr (!is_volatile<_Up>::value) {
            if (__builtin_is_constant_evaluated()) {
                const _Tp __old = *__p;
                *__p = __fcxx_atomic_op_max()(__old, __v);
                return __old;
            }
        }
#    endif
        return __atomic_fetch_max(__fcxx_atomic_addr(__p), __v, __fcxx_atomic_order(__m));
    } else
#  endif
    {
        return __fcxx_atomic_fetch_op(__p, __v, __m, __fcxx_atomic_op_max());
    }
}

template <class _Tp, class _Up>
_FCXX_ALWAYS_INLINE _FCXX_ATOMIC_CE _Tp __fcxx_atomic_fetch_min(_Up* __p, _Tp __v, memory_order __m) noexcept {
#  if _FCXX_HAS_BUILTIN(__atomic_fetch_min)
