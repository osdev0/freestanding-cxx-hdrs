#  define _FCXX_ATOMIC_THROUGH_MEMORY(x) __asm__("" : "+m"(x))
#else
#  define _FCXX_ATOMIC_THROUGH_MEMORY(x) ((void)0)
#endif

/* The exchange, generic.
 * Workaround: GCC 4.8.0 to 4.8.2, all targets: they do not compile the
 * generic __atomic_exchange of a size without a builtin of its own (the
 * call of the atomic library it becomes is taken for the builtin itself,
 * without the size), which is made of compare-and-exchanges there, which
 * they compile. */
