#ifndef __FREESTANDING_CXX_HDRS_ATOMIC
#define __FREESTANDING_CXX_HDRS_ATOMIC 1

#pragma GCC system_header

#include <__fcxx/config.h>

#if _FCXX_STD < 2011
#  error "<atomic> requires C++11 or later"
#endif

#define _FCXX_VERSION_ATOMIC
#include <__fcxx/version.h>
#undef _FCXX_VERSION_ATOMIC

#if _FCXX_STD >= 2011

#include <cstdint>
#include <type_traits>
#include <__fcxx/addressof.h>

/* The operations are those of the __atomic builtins of GCC and Clang, whose
 * generic forms take objects of any size. For the sizes the target has no
 * lock-free operations for, they call the functions of the atomic library,
 * of the names of the builtins, which the program then has to provide. Clang
 * warns about these calls where the objects are aligned less than their
 * size, which is by design here. */
#if defined(__clang__)
#  pragma clang diagnostic push
#  pragma clang diagnostic ignored "-Wunknown-warning-option"
#  pragma clang diagnostic ignored "-Watomic-alignment"
#endif

/* From C++26 on, the operations can be used in constant evaluation, where
 * they are ordinary accesses to the objects. */
#if _FCXX_STD >= 2026 && _FCXX_HAS_CONSTEXPR20 && _FCXX_HAS_IS_CONSTANT_EVALUATED
#  define _FCXX_ATOMIC_CONSTEXPR 1
#  define _FCXX_ATOMIC_CE constexpr
#else
#  define _FCXX_ATOMIC_CONSTEXPR 0
#  define _FCXX_ATOMIC_CE inline
#endif

/* The builtin that clears the padding bits of an object, for the comparison
 * of the compare-and-exchange operations to be on the value representations
 * only. Where the compiler lacks it, only the padding of the 80-bit format
 * of x87 is known, and cleared by hand. */
#if _FCXX_HAS_BUILTIN(__builtin_clear_padding)
#  define _FCXX_ATOMIC_CLEAR_PADDING 1
#else
#  define _FCXX_ATOMIC_CLEAR_PADDING 0
#endif

/* The volatile overloads of most of the members of atomic are constrained
 * by C++20 to the types that are always lock-free, while Annex D keeps them
 * available, deprecated, for the other types. Each such member is declared
 * by one of these, from its parenthesized declaration and its body: the
 * first one for the members of Annex D, and the second one for the others,
 * which only have the constraint. */
#define _FCXX_ATOMIC_UNPAREN(...) __VA_ARGS__
#if _FCXX_STD >= 2020 && _FCXX_HAS_CONCEPTS
#  define _FCXX_ATOMIC_VOLATILE(decl, ...) \
    _FCXX_ATOMIC_UNPAREN decl requires(__fcxx_atomic_always_lock_free<_Tp>::value) __VA_ARGS__ \
    _FCXX_DEPRECATED("volatile atomic operations are deprecated when the type is not always lock-free") \
    _FCXX_ATOMIC_UNPAREN decl requires(!__fcxx_atomic_always_lock_free<_Tp>::value) __VA_ARGS__
#  define _FCXX_ATOMIC_VOLATILE_LOCK_FREE(decl, ...) \
    _FCXX_ATOMIC_UNPAREN decl requires(__fcxx_atomic_always_lock_free<_Tp>::value) __VA_ARGS__
#else
#  define _FCXX_ATOMIC_VOLATILE(decl, ...) _FCXX_ATOMIC_UNPAREN decl __VA_ARGS__
#  define _FCXX_ATOMIC_VOLATILE_LOCK_FREE(decl, ...) _FCXX_ATOMIC_UNPAREN decl __VA_ARGS__
#endif

/* The members of atomic_ref that modify the object are constrained by C++26
 * to the specializations for types that are not const. */
#if _FCXX_STD >= 2026
#  define _FCXX_ATOMIC_REF_MUTABLE requires(!is_const<_Tp>::value)
#else
#  define _FCXX_ATOMIC_REF_MUTABLE
#endif

namespace std {

/* [atomics.order], order and consistency */

#if _FCXX_STD >= 2020
enum class memory_order : int {
    relaxed = 0,
    consume _FCXX_DEPRECATED_CXX26("memory_order::consume is deprecated, use memory_order::acquire") = 1,
    acquire = 2,
    release = 3,
    acq_rel = 4,
    seq_cst = 5
};

_FCXX_INLINE_VAR constexpr memory_order memory_order_relaxed = memory_order::relaxed;
_FCXX_DEPRECATED_CXX26("memory_order_consume is deprecated, use memory_order_acquire")
_FCXX_INLINE_VAR constexpr memory_order memory_order_consume = static_cast<memory_order>(1);
_FCXX_INLINE_VAR constexpr memory_order memory_order_acquire = memory_order::acquire;
_FCXX_INLINE_VAR constexpr memory_order memory_order_release = memory_order::release;
_FCXX_INLINE_VAR constexpr memory_order memory_order_acq_rel = memory_order::acq_rel;
_FCXX_INLINE_VAR constexpr memory_order memory_order_seq_cst = memory_order::seq_cst;
#else
typedef enum memory_order {
    memory_order_relaxed,
    memory_order_consume,
    memory_order_acquire,
    memory_order_release,
    memory_order_acq_rel,
    memory_order_seq_cst
} memory_order;
#endif

/* The orders are passed on to the builtins as they are, which only works as
 * the values of their macros are those of the enumerators. */
static_assert(__ATOMIC_RELAXED == 0 && __ATOMIC_CONSUME == 1 && __ATOMIC_ACQUIRE == 2 && __ATOMIC_RELEASE == 3
                  && __ATOMIC_ACQ_REL == 4 && __ATOMIC_SEQ_CST == 5,
              "the memory orders of the compiler are not those of the library");

/* In Annex D in C++26, where the dependencies it kills are no more. */
template <class _Tp>
_FCXX_DEPRECATED_CXX26("kill_dependency is deprecated")
_FCXX_CONSTEXPR26 _Tp kill_dependency(_Tp __y) noexcept {
    return __y;
}

} /* namespace std */

/* [atomics.lockfree], lock-free property, as the compiler tells it, but for
 * long long on i386, which is always lock-free with cmpxchg8b in atomic, as
 * that is aligned to 8 there.
 * Workaround: Clang 6 to 14, i386: it tells long long, which is aligned to 4
 * there, as only sometimes lock-free. The compare-and-swap macros cannot
 * tell the other types: Clang has the one of 8 bytes for ARMv7-M and 32-bit
 * SPARC too, where the operations of 8 bytes are calls of the atomic
 * library. */
#undef ATOMIC_BOOL_LOCK_FREE
#define ATOMIC_BOOL_LOCK_FREE __GCC_ATOMIC_BOOL_LOCK_FREE
#undef ATOMIC_CHAR_LOCK_FREE
#define ATOMIC_CHAR_LOCK_FREE __GCC_ATOMIC_CHAR_LOCK_FREE
#if _FCXX_STD >= 2020 && _FCXX_HAS_CHAR8_T
#  undef ATOMIC_CHAR8_T_LOCK_FREE
#  define ATOMIC_CHAR8_T_LOCK_FREE __GCC_ATOMIC_CHAR8_T_LOCK_FREE
#endif
#undef ATOMIC_CHAR16_T_LOCK_FREE
#define ATOMIC_CHAR16_T_LOCK_FREE __GCC_ATOMIC_CHAR16_T_LOCK_FREE
#undef ATOMIC_CHAR32_T_LOCK_FREE
#define ATOMIC_CHAR32_T_LOCK_FREE __GCC_ATOMIC_CHAR32_T_LOCK_FREE
#undef ATOMIC_WCHAR_T_LOCK_FREE
#define ATOMIC_WCHAR_T_LOCK_FREE __GCC_ATOMIC_WCHAR_T_LOCK_FREE
#undef ATOMIC_SHORT_LOCK_FREE
#define ATOMIC_SHORT_LOCK_FREE __GCC_ATOMIC_SHORT_LOCK_FREE
#undef ATOMIC_INT_LOCK_FREE
#define ATOMIC_INT_LOCK_FREE __GCC_ATOMIC_INT_LOCK_FREE
#undef ATOMIC_LONG_LOCK_FREE
#define ATOMIC_LONG_LOCK_FREE __GCC_ATOMIC_LONG_LOCK_FREE
#undef ATOMIC_LLONG_LOCK_FREE
#if defined(__i386__) && defined(__GCC_HAVE_SYNC_COMPARE_AND_SWAP_8)
#  define ATOMIC_LLONG_LOCK_FREE 2
#else
#  define ATOMIC_LLONG_LOCK_FREE __GCC_ATOMIC_LLONG_LOCK_FREE
#endif
#undef ATOMIC_POINTER_LOCK_FREE
#define ATOMIC_POINTER_LOCK_FREE __GCC_ATOMIC_POINTER_LOCK_FREE

namespace std {

/* The operations of all of the atomic types, on the objects of a pointer
 * type that is either volatile or not, as the builtins take both. From C++26
 * on, they are constexpr, and when evaluated in a constant expression they
 * access non-volatile objects as ordinary ones. */

/* Workaround: GCC before 14.4, and 15.1 and 15.2, MicroBlaze: its
 * compare-and-exchange of 4 bytes gives back the comparison it makes, which
 * is 0 where it succeeds, for its result. The builtin, and the operations
 * GCC and the atomic library build on it, the exchanges, the other
 * read-modify-write operations, test-and-set and those on 1 and 2 bytes,
 * get the wrong values then. Those on the objects of up to 4 bytes are
 * compare-and-exchange operations of the library there instead, with the
 * instructions GCC has used since. */
#if _FCXX_GCC && defined(__MICROBLAZE__) && (_FCXX_GCC < 1404 || (_FCXX_GCC >= 1500 && _FCXX_GCC < 1503))
#  define _FCXX_ATOMIC_MICROBLAZE 1
#else
#  define _FCXX_ATOMIC_MICROBLAZE 0
#endif

#if _FCXX_ATOMIC_MICROBLAZE
/* The compare-and-exchange of an aligned word, which gives back the value
 * found in it. */
inline unsigned int __fcxx_atomic_mb_cas(volatile unsigned int* __w, unsigned int __e, unsigned int __d) noexcept {
    unsigned int __found, __c;
    __asm__ __volatile__("addc\tr0,r0,r0\n"
                         "1:\tlwx\t%0,%2,r0\n\t"
                         "addic\t%1,r0,0\n\t"
                         "bnei\t%1,1b\n\t"
                         "cmp\t%1,%0,%3\n\t"
                         "bnei\t%1,2f\n\t"
                         "swx\t%4,%2,r0\n\t"
                         "addic\t%1,r0,0\n\t"
                         "bnei\t%1,1b\n"
                         "2:"
                         : "=&r"(__found), "=&r"(__c)
                         : "r"(__w), "r"(__e), "r"(__d)
                         : "cc", "memory");
    return __found;
}

/* The compare-and-exchange of the _Size bytes at __p, of up to 4, with that
 * of the aligned word they are in, which writes the value found to __e when
 * it fails. */
template <size_t _Size>
inline bool __fcxx_atomic_mb_compare_exchange(const volatile void* __p, void* __e, const void* __d) noexcept {
    volatile unsigned int* const __w = reinterpret_cast<volatile unsigned int*>(
        reinterpret_cast<_FCXX_UINTPTR>(__p) & ~static_cast<_FCXX_UINTPTR>(sizeof(unsigned int) - 1));
    const size_t __at = static_cast<size_t>(reinterpret_cast<_FCXX_UINTPTR>(__p) & (sizeof(unsigned int) - 1));
    unsigned int __found = *__w;
    for (;;) {
        unsigned int __want = __found;
        unsigned int __new = __found;
        __builtin_memcpy(reinterpret_cast<unsigned char*>(&__want) + __at, __e, _Size);
        __builtin_memcpy(reinterpret_cast<unsigned char*>(&__new) + __at, __d, _Size);
        __found = __fcxx_atomic_mb_cas(__w, __want, __new);
        if (__found == __want) {
            return true;
        }
        if (__builtin_memcmp(reinterpret_cast<const unsigned char*>(&__found) + __at, __e, _Size) != 0) {
            __builtin_memcpy(__e, reinterpret_cast<const unsigned char*>(&__found) + __at, _Size);
            return false;
        }
    }
}
#endif

/* Whether the operations on the objects of the type are always lock-free,
 * as they are when the objects are aligned to their size, which the storage
 * of atomic always is. */
template <class _Tp>
struct __fcxx_atomic_lock_free
    : __fcxx_bool_constant<__atomic_always_lock_free(sizeof(_Tp), 0)> {};

/* Whether the lock-free macros of all of the types of the size are 2, which
 * is_always_lock_free has to agree with. The compiler can take the operations
 * to be always lock-free where its macros have them only sometimes lock-free:
 * GCC does, for the sizes it only has lock-free operations for through
 * functions of its runtime library, as on ARM before ARMv6. The types are
 * not always lock-free as far as the library knows then, which cannot tell
 * what those functions do. */
template <size_t _Size>
struct __fcxx_atomic_macros_lock_free
    : __fcxx_bool_constant<(sizeof(bool) != _Size || ATOMIC_BOOL_LOCK_FREE == 2)
                           && (sizeof(char) != _Size || ATOMIC_CHAR_LOCK_FREE == 2)
#if defined(ATOMIC_CHAR8_T_LOCK_FREE)
                           && (sizeof(char8_t) != _Size || ATOMIC_CHAR8_T_LOCK_FREE == 2)
#endif
                           && (sizeof(char16_t) != _Size || ATOMIC_CHAR16_T_LOCK_FREE == 2)
                           && (sizeof(char32_t) != _Size || ATOMIC_CHAR32_T_LOCK_FREE == 2)
                           && (sizeof(wchar_t) != _Size || ATOMIC_WCHAR_T_LOCK_FREE == 2)
                           && (sizeof(short) != _Size || ATOMIC_SHORT_LOCK_FREE == 2)
                           && (sizeof(int) != _Size || ATOMIC_INT_LOCK_FREE == 2)
                           && (sizeof(long) != _Size || ATOMIC_LONG_LOCK_FREE == 2)
                           && (sizeof(long long) != _Size || ATOMIC_LLONG_LOCK_FREE == 2)
                           && (sizeof(void*) != _Size || ATOMIC_POINTER_LOCK_FREE == 2)> {};

/* Whether atomic and atomic_ref of the type are always lock-free, as their
 * is_always_lock_free says. */
template <class _Tp>
struct __fcxx_atomic_always_lock_free
    : __fcxx_bool_constant<__fcxx_atomic_lock_free<_Tp>::value
                           && __fcxx_atomic_macros_lock_free<sizeof(_Tp)>::value> {};

/* Whether the size is one lock-free operations can exist for. */
template <class _Tp>
struct __fcxx_atomic_sized : __fcxx_bool_constant<(sizeof(_Tp) & (sizeof(_Tp) - 1)) == 0 && sizeof(_Tp) <= 16> {};

/* The alignment of the storage of atomic, which is that of the size for the
 * sizes lock-free operations can exist for, as with _Atomic in C: the
 * lock-free operations need it for the types that are aligned less. GCC 4.8
 * only takes it spelt out in the attribute. */
#define _FCXX_ATOMIC_ALIGNMENT(_Tp)                                                                        \
    ((sizeof(_Tp) & (sizeof(_Tp) - 1)) == 0 && sizeof(_Tp) <= 16 && sizeof(_Tp) > alignof(_Tp) ? sizeof(_Tp) \
                                                                                                : alignof(_Tp))

/* The alignment atomic_ref requires, which is only raised for the types it
 * then makes always lock-free. */
template <class _Tp>
struct __fcxx_atomic_ref_align
    : integral_constant<size_t, (__fcxx_atomic_lock_free<_Tp>::value && __fcxx_atomic_sized<_Tp>::value
                                         && sizeof(_Tp) > alignof(_Tp)
                                     ? sizeof(_Tp)
                                     : alignof(_Tp))> {};

/* Whether the type is the 80-bit format of x87, stored with padding after
 * its first ten bytes. */
template <class _Tp>
struct __fcxx_atomic_is_x87
#if (defined(__i386__) || defined(__x86_64__)) && __LDBL_MANT_DIG__ == 64 && __SIZEOF_LONG_DOUBLE__ > 10
    : is_same<_Tp, long double> {};
#else
    : false_type {};
#endif

/* The objects and the values as the builtins take them.
 *
 * Workaround: Clang up to 23 (the latest), x86: the x87 format is given to
 * the builtins as the bytes of its representation, as Clang otherwise copies
 * only the bytes of its value, into temporaries with whatever padding, and
 * does not give back the value a compare-and-exchange finds.
 *
 * The builtins go by the alignment of the type, and Clang calls the atomic
 * library for the types that are aligned less than their size, even when
 * they are always lock-free with that alignment, which the objects of
 * atomic, and those atomic_ref refers to, have then. Their address is taken
 * as that of the type with that alignment. */
template <size_t _Size, size_t _Align>
struct __fcxx_atomic_bytes {
    unsigned char __b[_Size] __attribute__((__aligned__(_Align)));
};

template <class _Tp, bool = __fcxx_atomic_is_x87<_Tp>::value>
struct __fcxx_atomic_repr {
    typedef _Tp type;
};

template <class _Tp>
struct __fcxx_atomic_repr<_Tp, true> {
    typedef __fcxx_atomic_bytes<sizeof(_Tp), alignof(_Tp)> type;

    /* Which also completes the type, as the builtins need. */
    static_assert(sizeof(type) == sizeof(_Tp) && alignof(type) == alignof(_Tp), "the bytes of the representation");
};

/* The alignment the builtins are given the object with: 0 for that of the
 * type, and 1 for its size. */
template <class _Vp>
struct __fcxx_atomic_address_kind
    : integral_constant<int, __fcxx_atomic_lock_free<_Vp>::value && __fcxx_atomic_sized<_Vp>::value
                                     && (sizeof(_Vp) > alignof(_Vp))
                                 ? 1
                                 : 0> {};

template <class _Up, class _Vp = __fcxx_remove_cv_t<_Up>, int = __fcxx_atomic_address_kind<_Vp>::value>
struct __fcxx_atomic_address {
    typedef typename __fcxx_copy_cv<_Up, typename __fcxx_atomic_repr<_Vp>::type>::type __object;
    typedef __object type;
};

template <class _Up, class _Vp>
struct __fcxx_atomic_address<_Up, _Vp, 1> {
    typedef typename __fcxx_atomic_address<_Up, _Vp, 0>::__object __object;
    typedef __object type __attribute__((__aligned__(sizeof(_Vp))));
};

template <class _Up>
_FCXX_ALWAYS_INLINE inline typename __fcxx_atomic_address<_Up>::type* __fcxx_atomic_addr(_Up* __p) noexcept {
    return reinterpret_cast<typename __fcxx_atomic_address<_Up>::type*>(
        const_cast<typename __fcxx_atomic_address<_Up>::__object*>(
            reinterpret_cast<const volatile typename __fcxx_atomic_repr<__fcxx_remove_cv_t<_Up> >::type*>(__p)));
}

template <class _Tp>
_FCXX_ALWAYS_INLINE inline typename __fcxx_atomic_repr<_Tp>::type* __fcxx_atomic_val(_Tp* __v) noexcept {
    return reinterpret_cast<typename __fcxx_atomic_repr<_Tp>::type*>(__v);
}

/* Storage for a value that the builtins write, without constructing it. */
template <class _Tp>
union __fcxx_atomic_holder {
    _Tp __value;

    __fcxx_atomic_holder() noexcept {}
};

/* Whether the objects of the type can have padding bits, which the builtins
 * would compare. */
template <class _Tp>
struct __fcxx_atomic_padded
#if _FCXX_ATOMIC_CLEAR_PADDING
    : __fcxx_bool_constant<(!is_scalar<_Tp>::value && !__has_unique_object_representations(_Tp))
                           || __fcxx_atomic_is_x87<_Tp>::value> {};
#else
    : __fcxx_atomic_is_x87<_Tp> {};
#endif

template <bool _Padded>
struct __fcxx_atomic_padding {
    template <class _Tp>
    static _FCXX_ALWAYS_INLINE void __clear(_Tp*) noexcept {}
};

template <>
struct __fcxx_atomic_padding<true> {
    template <class _Tp>
    static _FCXX_ALWAYS_INLINE void __clear(_Tp* __p) noexcept {
#if _FCXX_ATOMIC_CLEAR_PADDING
        __builtin_clear_padding(__p);
#else
        __builtin_memset(reinterpret_cast<unsigned char*>(__p) + 10, 0, sizeof(_Tp) - 10);
#endif
    }
};

template <class _Tp>
_FCXX_ALWAYS_INLINE inline void __fcxx_atomic_clear_padding(_Tp* __p) noexcept {
    __fcxx_atomic_padding<__fcxx_atomic_padded<_Tp>::value>::__clear(__p);
}

/* The result of is_lock_free, only asked of the atomic library for the
 * types that are not always lock-free.
 * Workaround: Clang 17 to 23, MSP430, with exceptions: unlike its other
 * calls of the atomic library, the one __atomic_is_lock_free becomes is not
 * told not to throw, so in a noexcept function it gets a landing pad, on
 * which the backend crashes at -O1 and above, as on every landing pad there.
 * The function is called through a declaration of it that is noexcept there
 * instead, which is what the builtin becomes there with every version of
 * Clang, as no type is lock-free for it there. */
#if defined(__clang__) && defined(__MSP430__)
extern "C" bool __fcxx_atomic_is_lock_free(size_t, const volatile void*) noexcept __asm__("__atomic_is_lock_free");
#endif

template <bool _Always>
struct __fcxx_atomic_lock_free_query {
    static bool __query(size_t, const volatile void*) noexcept {
        return true;
    }
};

template <>
struct __fcxx_atomic_lock_free_query<false> {
    static bool __query(size_t __size, const volatile void* __p) noexcept {
#if defined(__clang__) && defined(__MSP430__)
        return __fcxx_atomic_is_lock_free(__size, __p);
#else
        return __atomic_is_lock_free(__size, const_cast<void*>(__p));
#endif
    }
};

_FCXX_CONSTEXPR11 int __fcxx_atomic_order(memory_order __m) noexcept {
    return static_cast<int>(__m);
}

/* The order of the failure of a compare-and-exchange given a single order. */
_FCXX_CONSTEXPR11 memory_order __fcxx_atomic_failure_order(memory_order __m) noexcept {
    return __m == memory_order_acq_rel ? memory_order_acquire
         : __m == memory_order_release ? memory_order_relaxed
                                       : __m;
}

/* The order of the success of a compare-and-exchange, which the builtins
 * need at least as strong as the order of the failure, as C++11 did. From
 * C++17 on, the failure can have the stronger one, and the success gets
 * strengthened to it then. */
_FCXX_CONSTEXPR11 int __fcxx_atomic_success_order(int __s, int __f) noexcept {
    return __f == __ATOMIC_SEQ_CST ? __ATOMIC_SEQ_CST
         : __f != __ATOMIC_ACQUIRE && __f != __ATOMIC_CONSUME ? __s
         : __s == __ATOMIC_RELAXED || __s == __ATOMIC_CONSUME ? __ATOMIC_ACQUIRE
         : __s == __ATOMIC_RELEASE ? __ATOMIC_ACQ_REL
                                   : __s;
}

/* What a waiting operation does while the value has not changed, as nothing
 * can make it block in a freestanding environment: it spins on the value,
 * hinting the processor at it where the architecture has an instruction for
 * that. */
_FCXX_ALWAYS_INLINE inline void __fcxx_atomic_pause() noexcept {
#if defined(__i386__) || defined(__x86_64__)
#  if _FCXX_GCC || _FCXX_HAS_BUILTIN(__builtin_ia32_pause)
    __builtin_ia32_pause();
#  else
    __asm__ __volatile__("pause");
#  endif
#elif defined(__aarch64__)                                                                                        \
    || (defined(__arm__)                                                                                          \
        && ((defined(__ARM_ARCH) && __ARM_ARCH >= 7) || defined(__ARM_ARCH_6K__) || defined(__ARM_ARCH_6KZ__)    \
            || defined(__ARM_ARCH_6ZK__) || defined(__ARM_ARCH_6T2__) || defined(__ARM_ARCH_6M__)               \
            || defined(__ARM_ARCH_7__) || defined(__ARM_ARCH_7A__) || defined(__ARM_ARCH_7R__)                   \
            || defined(__ARM_ARCH_7M__) || defined(__ARM_ARCH_7EM__)))
    __asm__ __volatile__("yield");
#elif defined(__riscv_zihintpause)
    __asm__ __volatile__("pause");
#endif
}

#if _FCXX_ATOMIC_CONSTEXPR
/* Whether two values have the same value representation, in constant
 * evaluation. The padding of the x87 format cannot be read there, and its
 * values are compared as numbers, with the sign of zero and NaN. */
template <class _Tp>
constexpr bool __fcxx_atomic_same_ce(const _Tp& __a, const _Tp& __b) noexcept {
    if constexpr (is_scalar<_Tp>::value && !is_floating_point<_Tp>::value) {
        return __a == __b;
    } else if constexpr (__fcxx_atomic_is_x87<_Tp>::value) {
        return (__a == __b && __builtin_signbit(__a) == __builtin_signbit(__b)) || (__a != __a && __b != __b);
    } else {
        struct __bytes {
            unsigned char __b[sizeof(_Tp)];
        };
        const __bytes __x = __builtin_bit_cast(__bytes, __a);
        const __bytes __y = __builtin_bit_cast(__bytes, __b);
        for (size_t __i = 0; __i != sizeof(_Tp); ++__i) {
            if (__x.__b[__i] != __y.__b[__i]) {
                return false;
            }
        }
        return true;
    }
}

/* Called by a waiting operation that would block forever in constant
 * evaluation, which it makes fail. */
inline void __fcxx_atomic_wait_blocks() noexcept {}
#endif

/* Workaround: Clang before 9, i386: it loads an object of 8 bytes with a
 * compare-and-exchange, which faults where the object is read-only, as a
 * constant atomic object can be. It is loaded with x87 there instead, which
 * reads 8 aligned bytes at once, where the target has it. */
#if _FCXX_CLANG && _FCXX_CLANG < 900 && defined(__i386__) && !defined(_SOFT_FLOAT)
#  define _FCXX_ATOMIC_X87_LOAD 1
#else
#  define _FCXX_ATOMIC_X87_LOAD 0
#endif

template <bool _X87>
struct __fcxx_atomic_loader {
    template <class _Tp, class _Up>
    static _FCXX_ALWAYS_INLINE void __load(_Up* __p, _Tp* __r, int __mo) noexcept {
        __atomic_load(__fcxx_atomic_addr(__p), __fcxx_atomic_val(__r), __mo);
    }
};

#if _FCXX_ATOMIC_X87_LOAD
template <>
struct __fcxx_atomic_loader<true> {
    template <class _Tp, class _Up>
    static _FCXX_ALWAYS_INLINE void __load(_Up* __p, _Tp* __r, int) noexcept {
        __asm__ __volatile__("fildll %1\n\tfistpll %0"
