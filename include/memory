    : __fcxx_bool_constant<is_same<_Up, _Pointer>::value
                           || (is_same<_Pointer, _Elem*>::value && is_pointer<_Up>::value
                               && is_convertible<typename remove_pointer<_Up>::type (*)[], _Elem (*)[]>::value)> {};

