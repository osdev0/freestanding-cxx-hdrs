}

/* [allocator.uses.construction], uninitialized_construct_using_allocator,
 * with the rest of uses-allocator construction in
 * <__fcxx/uses_allocator_args.h>, which <tuple> includes. */
template <class _Tp>
struct __fcxx_construct_at_fn {
    _Tp* __p;

    template <class... _Args>
    constexpr _Tp* operator()(_Args&&... __args) const {
        return std::construct_at(__p, std::forward<_Args>(__args)...);
    }
};

template <class _Tp, class _Alloc, class... _Args>
constexpr _Tp* uninitialized_construct_using_allocator(_Tp* __p, const _Alloc& __alloc, _Args&&... __args) {
    return std::apply(__fcxx_construct_at_fn<_Tp>{__p},
                      std::uses_allocator_construction_args<_Tp>(__alloc, std::forward<_Args>(__args)...));
}

/* [allocator.traits], allocator traits */
template <class _Pointer, class _SizeType = size_t>
struct allocation_result {
    _Pointer ptr;
    _SizeType count;
};

template <class _Alloc, class = void>
struct __fcxx_alloc_pointer {
    typedef typename _Alloc::value_type* type;
};

template <class _Alloc>
struct __fcxx_alloc_pointer<_Alloc, __fcxx_void_t<typename _Alloc::pointer> > {
    typedef typename _Alloc::pointer type;
};

#define _FCXX_ALLOC_MEMBER_TYPE(name, fallback)                                               \
      template <class _Alloc, class _Pointer, class = void>                                    \
      struct __fcxx_alloc_##name {                                                             \
          typedef fallback type;                                                               \
      };                                                                                       \
      template <class _Alloc, class _Pointer>                                                  \
      struct __fcxx_alloc_##name<_Alloc, _Pointer, __fcxx_void_t<typename _Alloc::name> > {    \
          typedef typename _Alloc::name type;                                                  \
      };

_FCXX_ALLOC_MEMBER_TYPE(const_pointer,
                        typename pointer_traits<_Pointer>::template rebind<const typename _Alloc::value_type>)
_FCXX_ALLOC_MEMBER_TYPE(void_pointer, typename pointer_traits<_Pointer>::template rebind<void>)
_FCXX_ALLOC_MEMBER_TYPE(const_void_pointer, typename pointer_traits<_Pointer>::template rebind<const void>)
_FCXX_ALLOC_MEMBER_TYPE(difference_type, typename pointer_traits<_Pointer>::difference_type)
_FCXX_ALLOC_MEMBER_TYPE(propagate_on_container_copy_assignment, false_type)
_FCXX_ALLOC_MEMBER_TYPE(propagate_on_container_move_assignment, false_type)
_FCXX_ALLOC_MEMBER_TYPE(propagate_on_container_swap, false_type)
_FCXX_ALLOC_MEMBER_TYPE(is_always_equal, typename is_empty<_Alloc>::type)

#undef _FCXX_ALLOC_MEMBER_TYPE

template <class _Alloc, class _Diff, class = void>
struct __fcxx_alloc_size_type : make_unsigned<_Diff> {};

template <class _Alloc, class _Diff>
struct __fcxx_alloc_size_type<_Alloc, _Diff, __fcxx_void_t<typename _Alloc::size_type> > {
    typedef typename _Alloc::size_type type;
};

/* rebind_alloc: Alloc::rebind<T>::other, or else the argument of the template
 * Alloc is a specialization of replaced. */
template <class _Alloc, class _Tp>
struct __fcxx_alloc_rebind_args {};

template <template <class, class...> class _Tmpl, class _Up, class... _Args, class _Tp>
struct __fcxx_alloc_rebind_args<_Tmpl<_Up, _Args...>, _Tp> {
    typedef _Tmpl<_Tp, _Args...> type;
};

template <class _Alloc, class _Tp, class = void>
struct __fcxx_alloc_rebind : __fcxx_alloc_rebind_args<_Alloc, _Tp> {};

template <class _Alloc, class _Tp>
struct __fcxx_alloc_rebind<_Alloc, _Tp, __fcxx_void_t<typename _Alloc::template rebind<_Tp>::other> > {
    typedef typename _Alloc::template rebind<_Tp>::other type;
};

/* The members of allocators that allocator_traits uses where they are. */
template <class _Alloc, class _Size, class _Hint, class = void>
struct __fcxx_alloc_has_hint_allocate : false_type {};

template <class _Alloc, class _Size, class _Hint>
struct __fcxx_alloc_has_hint_allocate<
    _Alloc, _Size, _Hint,
    __fcxx_void_t<decltype(std::declval<_Alloc&>().allocate(std::declval<_Size>(), std::declval<_Hint>()))>>
    : true_type {};

template <class _Void, class _Alloc, class _Tp, class... _Args>
struct __fcxx_alloc_has_construct : false_type {};

template <class _Alloc, class _Tp, class... _Args>
struct __fcxx_alloc_has_construct<
    __fcxx_void_t<decltype(std::declval<_Alloc&>().construct(std::declval<_Tp*>(), std::declval<_Args>()...))>, _Alloc,
    _Tp, _Args...> : true_type {};

template <class _Alloc, class _Tp, class = void>
struct __fcxx_alloc_has_destroy : false_type {};

template <class _Alloc, class _Tp>
struct __fcxx_alloc_has_destroy<_Alloc, _Tp,
                                __fcxx_void_t<decltype(std::declval<_Alloc&>().destroy(std::declval<_Tp*>()))>>
    : true_type {};

template <class _Alloc, class = void>
struct __fcxx_alloc_has_max_size : false_type {};

template <class _Alloc>
struct __fcxx_alloc_has_max_size<_Alloc, __fcxx_void_t<decltype(std::declval<const _Alloc&>().max_size())> >
    : true_type {};

template <class _Alloc, class = void>
struct __fcxx_alloc_has_select : false_type {};

template <class _Alloc>
struct __fcxx_alloc_has_select<
    _Alloc, __fcxx_void_t<decltype(std::declval<const _Alloc&>().select_on_container_copy_construction())> >
    : true_type {};

template <class _Alloc, class _Size, class = void>
struct __fcxx_alloc_has_allocate_at_least : false_type {};

template <class _Alloc, class _Size>
struct __fcxx_alloc_has_allocate_at_least<
    _Alloc, _Size, __fcxx_void_t<decltype(std::declval<_Alloc&>().allocate_at_least(std::declval<_Size>()))> >
    : true_type {};

template <class _Alloc>
struct allocator_traits {
    typedef _Alloc allocator_type;
    typedef typename _Alloc::value_type value_type;
    typedef typename __fcxx_alloc_pointer<_Alloc>::type pointer;
    typedef typename __fcxx_alloc_const_pointer<_Alloc, pointer>::type const_pointer;
    typedef typename __fcxx_alloc_void_pointer<_Alloc, pointer>::type void_pointer;
    typedef typename __fcxx_alloc_const_void_pointer<_Alloc, pointer>::type const_void_pointer;
    typedef typename __fcxx_alloc_difference_type<_Alloc, pointer>::type difference_type;
    typedef typename __fcxx_alloc_size_type<_Alloc, difference_type>::type size_type;
    typedef typename __fcxx_alloc_propagate_on_container_copy_assignment<_Alloc, pointer>::type
        propagate_on_container_copy_assignment;
    typedef typename __fcxx_alloc_propagate_on_container_move_assignment<_Alloc, pointer>::type
        propagate_on_container_move_assignment;
    typedef typename __fcxx_alloc_propagate_on_container_swap<_Alloc, pointer>::type propagate_on_container_swap;
    typedef typename __fcxx_alloc_is_always_equal<_Alloc, pointer>::type is_always_equal;

    template <class _Tp>
    using rebind_alloc = typename __fcxx_alloc_rebind<_Alloc, _Tp>::type;

    template <class _Tp>
    using rebind_traits = allocator_traits<rebind_alloc<_Tp> >;

    [[nodiscard]] static constexpr pointer allocate(_Alloc& __a, size_type __n) { return __a.allocate(__n); }

    [[nodiscard]] static constexpr pointer allocate(_Alloc& __a, size_type __n, const_void_pointer __hint) {
        return __allocate_hint(__a, __n, __hint,
                               __fcxx_alloc_has_hint_allocate<_Alloc, size_type, const_void_pointer>());
    }

    [[nodiscard]] static constexpr allocation_result<pointer, size_type> allocate_at_least(_Alloc& __a,
                                                                                            size_type __n) {
        if constexpr (__fcxx_alloc_has_allocate_at_least<_Alloc, size_type>::value) {
            return __a.allocate_at_least(__n);
        } else {
            return {__a.allocate(__n), __n};
        }
    }

    static constexpr void deallocate(_Alloc& __a, pointer __p, size_type __n) { __a.deallocate(__p, __n); }

    template <class _Tp, class... _Args>
    static constexpr void construct(_Alloc& __a, _Tp* __p, _Args&&... __args) {
        __construct(__fcxx_alloc_has_construct<void, _Alloc, _Tp, _Args...>(), __a, __p,
                    std::forward<_Args>(__args)...);
    }

    template <class _Tp>
    static constexpr void destroy(_Alloc& __a, _Tp* __p) {
        __destroy(__fcxx_alloc_has_destroy<_Alloc, _Tp>(), __a, __p);
    }

    /* The largest number of objects is that of the size divided by their
     * size, as LWG 2466 has it. */
    static constexpr size_type max_size(const _Alloc& __a) noexcept {
        return __max_size(__fcxx_alloc_has_max_size<_Alloc>(), __a);
    }

    static constexpr _Alloc select_on_container_copy_construction(const _Alloc& __rhs) {
        return __select(__fcxx_alloc_has_select<_Alloc>(), __rhs);
    }

private:
    static constexpr pointer __allocate_hint(_Alloc& __a, size_type __n, const_void_pointer __hint, true_type) {
        return __a.allocate(__n, __hint);
    }

    static constexpr pointer __allocate_hint(_Alloc& __a, size_type __n, const_void_pointer, false_type) {
        return __a.allocate(__n);
    }

    template <class _Tp, class... _Args>
    static constexpr void __construct(true_type, _Alloc& __a, _Tp* __p, _Args&&... __args) {
        __a.construct(__p, std::forward<_Args>(__args)...);
    }

    template <class _Tp, class... _Args>
    static constexpr void __construct(false_type, _Alloc&, _Tp* __p, _Args&&... __args) {
        std::construct_at(__p, std::forward<_Args>(__args)...);
    }

    template <class _Tp>
    static constexpr void __destroy(true_type, _Alloc& __a, _Tp* __p) {
        __a.destroy(__p);
    }

    template <class _Tp>
    static constexpr void __destroy(false_type, _Alloc&, _Tp* __p) {
        std::destroy_at(__p);
    }

    static constexpr size_type __max_size(true_type, const _Alloc& __a) noexcept { return __a.max_size(); }

    static constexpr size_type __max_size(false_type, const _Alloc&) noexcept {
        return numeric_limits<size_type>::max() / sizeof(value_type);
    }

    static constexpr _Alloc __select(true_type, const _Alloc& __rhs) {
        return __rhs.select_on_container_copy_construction();
    }

    static constexpr _Alloc __select(false_type, const _Alloc& __rhs) { return __rhs; }
};

/* [unique.ptr.dltr], default deleters. The converting constructor and the
 * function call operator of default_delete<T[]> take arrays of other types
 * of elements too, as N4089 has it. */
template <class _Tp>
struct default_delete {
    constexpr default_delete() noexcept = default;

    template <class _Up, __fcxx_enable_if_t<is_convertible<_Up*, _Tp*>::value, int> = 0>
    constexpr default_delete(const default_delete<_Up>&) noexcept {}

    constexpr void operator()(_Tp* __ptr) const {
        static_assert(!is_void<_Tp>::value, "std::default_delete of a pointer to void");
        static_assert(sizeof(_Tp) > 0, "std::default_delete of a pointer to an incomplete type");
        delete __ptr;
    }
};

template <class _Tp>
struct default_delete<_Tp[]> {
    constexpr default_delete() noexcept = default;

    template <class _Up, __fcxx_enable_if_t<is_convertible<_Up (*)[], _Tp (*)[]>::value, int> = 0>
    constexpr default_delete(const default_delete<_Up[]>&) noexcept {}

    template <class _Up, __fcxx_enable_if_t<is_convertible<_Up (*)[], _Tp (*)[]>::value, int> = 0>
    constexpr void operator()(_Up* __ptr) const {
        static_assert(sizeof(_Up) > 0, "std::default_delete of a pointer to an incomplete type");
        delete[] __ptr;
    }
};

/* [unique.ptr], unique-ownership pointers */
template <class _Tp, class _Dp, class = void>
struct __fcxx_unique_ptr_pointer {
    typedef _Tp* type;
};

template <class _Tp, class _Dp>
struct __fcxx_unique_ptr_pointer<_Tp, _Dp, __fcxx_void_t<typename remove_reference<_Dp>::type::pointer> > {
    typedef typename remove_reference<_Dp>::type::pointer type;
};

/* The pointer and the deleter, which takes no room where it is an empty
 * class that can be derived from. */
template <class _Dp, bool = is_empty<_Dp>::value && !__is_final(_Dp)>
struct __fcxx_deleter_holder {
    _Dp __deleter;

    constexpr __fcxx_deleter_holder() : __deleter() {}

    template <class _Ep>
    constexpr explicit __fcxx_deleter_holder(_Ep&& __d) : __deleter(std::forward<_Ep>(__d)) {}

    constexpr _Dp& __get() noexcept { return __deleter; }

    constexpr const _Dp& __get() const noexcept { return __deleter; }
};

/* Workaround: Clang 20, all targets: it warns that the cv-qualifiers of a
 * base class have no effect (-Wignored-qualifiers) where a template
 * parameter brings them, as a deleter of a cv-qualified empty class type
 * does here; Clang 21 does not. */
#if _FCXX_CLANG >= 2000 && _FCXX_CLANG < 2100
#  pragma clang diagnostic push
#  pragma clang diagnostic ignored "-Wignored-qualifiers"
#endif
template <class _Dp>
struct __fcxx_deleter_holder<_Dp, true> : private _Dp {
    constexpr __fcxx_deleter_holder() : _Dp() {}

    template <class _Ep>
    constexpr explicit __fcxx_deleter_holder(_Ep&& __d) : _Dp(std::forward<_Ep>(__d)) {}

    constexpr _Dp& __get() noexcept { return *this; }

    constexpr const _Dp& __get() const noexcept { return *this; }
};
#if _FCXX_CLANG >= 2000 && _FCXX_CLANG < 2100
#  pragma clang diagnostic pop
#endif

template <class _Ptr, class _Dp>
struct __fcxx_unique_ptr_storage : __fcxx_deleter_holder<_Dp> {
    _Ptr __ptr;

    constexpr __fcxx_unique_ptr_storage() : __fcxx_deleter_holder<_Dp>(), __ptr() {}

    constexpr explicit __fcxx_unique_ptr_storage(_Ptr __p) : __fcxx_deleter_holder<_Dp>(), __ptr(__p) {}

    template <class _Ep>
    constexpr __fcxx_unique_ptr_storage(_Ptr __p, _Ep&& __d)
        : __fcxx_deleter_holder<_Dp>(std::forward<_Ep>(__d)), __ptr(__p) {}
};

/* The constraints of the constructors from a pointer alone: the deleter is
 * default constructible, and not a pointer. */
template <class _Dp>
struct __fcxx_unique_ptr_default_deleter
    : __fcxx_bool_constant<!is_pointer<_Dp>::value && is_default_constructible<_Dp>::value> {};

/* The constraints of the conversions from other unique_ptrs, on their
 * deleters. */
template <class _Dp, class _Ep>
struct __fcxx_unique_ptr_deleter_converts
    : __fcxx_bool_constant<is_reference<_Dp>::value ? is_same<_Ep, _Dp>::value : is_convertible<_Ep, _Dp>::value> {};

template <class _Tp, class _Dp = default_delete<_Tp> >
class unique_ptr {
    template <class _Up, class _Ep>
    friend class unique_ptr;

public:
    typedef typename __fcxx_unique_ptr_pointer<_Tp, _Dp>::type pointer;
    typedef _Tp element_type;
    typedef _Dp deleter_type;

    template <class _D2 = _Dp, __fcxx_enable_if_t<__fcxx_unique_ptr_default_deleter<_D2>::value, int> = 0>
    constexpr unique_ptr() noexcept : __s() {}

    template <class _D2 = _Dp, __fcxx_enable_if_t<__fcxx_unique_ptr_default_deleter<_D2>::value, int> = 0>
    constexpr unique_ptr(nullptr_t) noexcept : __s() {}

    template <class _D2 = _Dp, __fcxx_enable_if_t<__fcxx_unique_ptr_default_deleter<_D2>::value, int> = 0>
    constexpr explicit unique_ptr(pointer __p) noexcept : __s(__p) {}

    template <class _D2 = _Dp, __fcxx_enable_if_t<is_constructible<_D2, const _D2&>::value, int> = 0>
    constexpr unique_ptr(pointer __p, const _Dp& __d) noexcept : __s(__p, __d) {}

    template <
        class _D2 = _Dp,
        __fcxx_enable_if_t<
            !is_reference<_D2>::value && is_constructible<_D2, typename remove_reference<_D2>::type&&>::value, int> = 0>
    constexpr unique_ptr(pointer __p, typename remove_reference<_Dp>::type&& __d) noexcept
        : __s(__p, std::move(__d)) {}

    /* Deleted where the deleter is a reference, which would be bound to a
     * temporary otherwise. */
    template <
        class _D2 = _Dp,
        __fcxx_enable_if_t<
            is_reference<_D2>::value && is_constructible<_D2, typename remove_reference<_D2>::type&&>::value, int> = 0>
    unique_ptr(pointer, typename remove_reference<_Dp>::type&&) = delete;

    constexpr unique_ptr(unique_ptr&& __u) noexcept
        requires is_move_constructible_v<_Dp>
        : __s(__u.release(), std::forward<_Dp>(__u.get_deleter())) {
    }

    template <class _Up, class _Ep,
              __fcxx_enable_if_t<is_convertible<typename unique_ptr<_Up, _Ep>::pointer, pointer>::value
                                     && !is_array<_Up>::value && __fcxx_unique_ptr_deleter_converts<_Dp, _Ep>::value,
                                 int> = 0>
    constexpr unique_ptr(unique_ptr<_Up, _Ep>&& __u) noexcept
        : __s(__u.release(), std::forward<_Ep>(__u.get_deleter())) {}

    constexpr ~unique_ptr() {
        if (__s.__ptr) {
            get_deleter()(__s.__ptr);
        }
    }

    constexpr unique_ptr& operator=(unique_ptr&& __u) noexcept
        requires is_move_assignable_v<_Dp>
    {
        reset(__u.release());
        get_deleter() = std::forward<_Dp>(__u.get_deleter());
        return *this;
    }

    template <class _Up, class _Ep,
              __fcxx_enable_if_t<is_convertible<typename unique_ptr<_Up, _Ep>::pointer, pointer>::value
                                     && !is_array<_Up>::value && is_assignable<_Dp&, _Ep&&>::value,
                                 int> = 0>
    constexpr unique_ptr& operator=(unique_ptr<_Up, _Ep>&& __u) noexcept {
        reset(__u.release());
        get_deleter() = std::forward<_Ep>(__u.get_deleter());
        return *this;
    }

    constexpr unique_ptr& operator=(nullptr_t) noexcept {
        reset();
        return *this;
    }

    /* Constrained on dereferencing the pointer, as LWG 4324 has it (with the
