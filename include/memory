/* [ptr.align], pointer alignment */
inline void* align(size_t __alignment, size_t __size, void*& __ptr, size_t& __space) noexcept {
    if (__size > __space) {
        return nullptr;
    }
    const size_t __adjust =
        static_cast<size_t>((0 - reinterpret_cast<_FCXX_UINTPTR>(__ptr)) & static_cast<_FCXX_UINTPTR>(__alignment - 1));
    if (__adjust > __space - __size) {
        return nullptr;
    }
    __ptr = static_cast<char*>(__ptr) + __adjust;
    __space -= __adjust;
    return __ptr;
}

template <size_t _Np, class _Tp>
[[nodiscard]] constexpr _Tp* assume_aligned(_Tp* __ptr) {
    static_assert(_Np != 0 && (_Np & (_Np - 1)) == 0, "std::assume_aligned of an alignment that is not a power of two");
    if (__builtin_is_constant_evaluated()) {
        return __ptr;
    }
    return static_cast<_Tp*>(
        __builtin_assume_aligned(const_cast<const void*>(static_cast<const volatile void*>(__ptr)), _Np));
}

#if _FCXX_STD >= 2026
template <size_t _Alignment, class _Tp>
bool is_sufficiently_aligned(_Tp* __ptr) noexcept {
    static_assert(_Alignment != 0 && (_Alignment & (_Alignment - 1)) == 0,
                  "std::is_sufficiently_aligned of an alignment that is not a power of two");
    return reinterpret_cast<_FCXX_UINTPTR>(__ptr) % _Alignment == 0;
}
#endif

/* [obj.lifetime], explicit lifetime management. The objects are created
 * implicitly by a memmove of their storage onto itself, as memmove does. */
template <class _Tp>
void* __fcxx_start_lifetime(const volatile void* __p, size_t __size) noexcept {
    void* __q = const_cast<void*>(__p);
#if _FCXX_GCC
    /* Workaround: GCC 11 to 16 (all versions with C++23), all targets: it
     * folds the memmove of storage onto itself away, and the creation of
     * the objects with it, so that the stores to the objects that were
     * there before, of unrelated types, are lost to the loads of the new
     * ones, which its type-based alias analysis takes them not to alias.
     * The pointer goes through an asm statement instead, which the
     * compiler takes to read and write all memory. */
    (void)__size;
    __asm__ __volatile__("" : "+r"(__q) : : "memory");
    return __q;
#else
    return __builtin_memmove(__q, __q, __size);
#endif
}

template <class _Tp>
_Tp* start_lifetime_as(void* __p) noexcept {
    static_assert(is_implicit_lifetime<_Tp>::value, "std::start_lifetime_as of a type that is not implicit-lifetime");
    return std::launder(static_cast<_Tp*>(std::__fcxx_start_lifetime<_Tp>(__p, sizeof(_Tp))));
}

template <class _Tp>
const _Tp* start_lifetime_as(const void* __p) noexcept {
    static_assert(is_implicit_lifetime<_Tp>::value, "std::start_lifetime_as of a type that is not implicit-lifetime");
    return std::launder(static_cast<const _Tp*>(std::__fcxx_start_lifetime<_Tp>(__p, sizeof(_Tp))));
}

template <class _Tp>
volatile _Tp* start_lifetime_as(volatile void* __p) noexcept {
    static_assert(is_implicit_lifetime<_Tp>::value, "std::start_lifetime_as of a type that is not implicit-lifetime");
    return std::launder(static_cast<volatile _Tp*>(std::__fcxx_start_lifetime<_Tp>(__p, sizeof(_Tp))));
}

template <class _Tp>
const volatile _Tp* start_lifetime_as(const volatile void* __p) noexcept {
    static_assert(is_implicit_lifetime<_Tp>::value, "std::start_lifetime_as of a type that is not implicit-lifetime");
    return std::launder(static_cast<const volatile _Tp*>(std::__fcxx_start_lifetime<_Tp>(__p, sizeof(_Tp))));
}

template <class _Tp>
_Tp* start_lifetime_as_array(void* __p, size_t __n) noexcept {
    static_assert(sizeof(_Tp) != 0, "std::start_lifetime_as_array of an incomplete type");
    if (__n == 0) {
        return static_cast<_Tp*>(__p);
    }
    return std::launder(static_cast<_Tp*>(std::__fcxx_start_lifetime<_Tp>(__p, __n * sizeof(_Tp))));
}

template <class _Tp>
const _Tp* start_lifetime_as_array(const void* __p, size_t __n) noexcept {
    static_assert(sizeof(_Tp) != 0, "std::start_lifetime_as_array of an incomplete type");
