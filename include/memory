    : __fcxx_bool_constant<is_array<_Up>::value && is_same<_Pointer, _Elem*>::value
                           && is_same<typename unique_ptr<_Up, _Ep>::pointer,
                                      typename unique_ptr<_Up, _Ep>::element_type*>::value
                           && is_convertible<typename unique_ptr<_Up, _Ep>::element_type (*)[], _Elem (*)[]>::value> {};

