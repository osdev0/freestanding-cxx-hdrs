#ifndef __FREESTANDING_CXX_HDRS_CSTRING
#define __FREESTANDING_CXX_HDRS_CSTRING 1

#pragma GCC system_header

#include <__fcxx/config.h>
_FCXX_BEGIN_EXTERN_CXX

#if _FCXX_STD < 2026
