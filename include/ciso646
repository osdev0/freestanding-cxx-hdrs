/* Only a header of C++11 to C++17, where it was freestanding. It has always
 * been empty, as the macros of the C header are keywords in C++. */

#ifndef __FREESTANDING_CXX_HDRS_CISO646
#define __FREESTANDING_CXX_HDRS_CISO646 1

#pragma GCC system_header

#include <__fcxx/config.h>
_FCXX_BEGIN_EXTERN_CXX

#if _FCXX_STD < 2011
#  error "<ciso646> is not a freestanding header before C++11"
#elif _FCXX_STD >= 2020
#  error "<ciso646> was removed in C++20"
#endif

_FCXX_END_EXTERN_CXX
#endif
