template <class _Tp, class _Up>
struct __fcxx_constructible_pred : is_constructible<_Tp, _Up> {};

template <class _Tp, class _Up>
struct __fcxx_convertible_pred : is_convertible<_Up, _Tp> {};

template <class _Tp, class _Up>
struct __fcxx_nothrow_constructible_pred : is_nothrow_constructible<_Tp, _Up> {};

template <class _Tp, class _Up>
struct __fcxx_assignable_pred : is_assignable<_Tp&, _Up> {};

template <class _Tp, class _Up>
struct __fcxx_const_assignable_pred : is_assignable<const _Tp&, _Up> {};

#if _FCXX_HAS_DANGLING_CHECK
template <class _Tp, class _Up>
struct __fcxx_no_dangling_pred : __fcxx_bool_constant<!__reference_constructs_from_temporary(_Tp, _Up)> {};
#endif

/* The additional constraint of the constructors of a tuple of one element
 * from another tuple, which keeps them from competing with the copy and move
 * constructors, and with those from the element. */
template <class _Src, class _TList, class _UList>
struct __fcxx_tuple_conv_single : true_type {};

template <class _Src, class _Tp, class _Up>
struct __fcxx_tuple_conv_single<_Src, __fcxx_type_list<_Tp>, __fcxx_type_list<_Up> >
    : __fcxx_and<__fcxx_not<is_same<_Tp, _Up> >, __fcxx_not<is_convertible<_Src, _Tp> >,
                 __fcxx_not<is_constructible<_Tp, _Src> > > {};

/* The disambiguating constraint of the constructor from the elements, for
 * tuples of one element, and of two and three elements, which the
 * constructors taking an allocator could be mistaken for. */
template <class _Tuple, class _TList, class _UList>
struct __fcxx_tuple_disambiguate : true_type {};

template <class _Tuple, class _T0, class _U0>
struct __fcxx_tuple_disambiguate<_Tuple, __fcxx_type_list<_T0>, __fcxx_type_list<_U0> >
    : __fcxx_not<is_same<__fcxx_remove_cvref_t<_U0>, _Tuple> > {};

template <class _Tuple, class _T0, class _T1, class _U0, class _U1>
struct __fcxx_tuple_disambiguate<_Tuple, __fcxx_type_list<_T0, _T1>, __fcxx_type_list<_U0, _U1> >
    : __fcxx_bool_constant<!is_same<__fcxx_remove_cvref_t<_U0>, allocator_arg_t>::value
                           || is_same<__fcxx_remove_cvref_t<_T0>, allocator_arg_t>::value> {};

template <class _Tuple, class _T0, class _T1, class _T2, class _U0, class _U1, class _U2>
struct __fcxx_tuple_disambiguate<_Tuple, __fcxx_type_list<_T0, _T1, _T2>, __fcxx_type_list<_U0, _U1, _U2> >
    : __fcxx_bool_constant<!is_same<__fcxx_remove_cvref_t<_U0>, allocator_arg_t>::value
                           || is_same<__fcxx_remove_cvref_t<_T0>, allocator_arg_t>::value> {};

template <class _Tuple, class _TList, class _UList>
struct __fcxx_tuple_forwarding
    : __fcxx_and<__fcxx_same_size<_TList, _UList>, __fcxx_tuple_disambiguate<_Tuple, _TList, _UList>,
                 __fcxx_zip_all<__fcxx_constructible_pred, _TList, _UList> > {};

template <class _Tp>
struct __fcxx_is_tuple_spec : false_type {};

template <class... _Types>
struct __fcxx_is_tuple_spec<tuple<_Types...> > : true_type {};

/* The elements of tuples, which empty classes are the bases of, taking no
 * space, but for final classes and tuples. */
template <class _Tp>
struct __fcxx_tuple_ebo : __fcxx_bool_constant<__is_class(_Tp) && __is_empty(_Tp) && !__is_final(_Tp)
                                               && !__fcxx_is_tuple_spec<_Tp>::value> {};

struct __fcxx_tuple_elem_tag {};
struct __fcxx_tuple_from_tag {};
struct __fcxx_tuple_alloc_tag {};

/* get of a tuple-like type, found by argument-dependent lookup, which the
 * members of the classes below cannot do themselves, as the members of the
 * element types they derive from would hide it. */
template <size_t _Ip, class _Tp>
constexpr auto __fcxx_adl_get(_Tp&& __t) noexcept -> decltype(get<_Ip>(std::forward<_Tp>(__t))) {
    return get<_Ip>(std::forward<_Tp>(__t));
}

template <class _Tp, class _Up>
constexpr void __fcxx_adl_swap(_Tp& __a, _Up& __b) noexcept(noexcept(swap(__a, __b))) {
    swap(__a, __b);
}

template <size_t _Ip, class _Tp, bool = __fcxx_tuple_ebo<_Tp>::value>
class __fcxx_tuple_leaf {
public:
    constexpr __fcxx_tuple_leaf() : __value() {}

    template <class _Up>
    constexpr __fcxx_tuple_leaf(__fcxx_tuple_elem_tag, _Up&& __u) : __value(std::forward<_Up>(__u)) {}

    template <class _Alloc, class... _Args>
    constexpr __fcxx_tuple_leaf(__fcxx_tuple_alloc_tag, const _Alloc& __a, _Args&&... __args)
        : __value(std::make_obj_using_allocator<_Tp>(__a, std::forward<_Args>(__args)...)) {}

    __fcxx_tuple_leaf(const __fcxx_tuple_leaf&) = default;
    __fcxx_tuple_leaf(__fcxx_tuple_leaf&&) = default;

    constexpr _Tp& __get() noexcept {
        return __value;
    }

    constexpr const _Tp& __get() const noexcept {
        return __value;
    }

private:

    _Tp __value;
};

template <size_t _Ip, class _Tp>
class __fcxx_tuple_leaf<_Ip, _Tp, true> : private _Tp {
public:
    constexpr __fcxx_tuple_leaf() : _Tp() {}

    template <class _Up>
    constexpr __fcxx_tuple_leaf(__fcxx_tuple_elem_tag, _Up&& __u) : _Tp(std::forward<_Up>(__u)) {}

    template <class _Alloc, class... _Args>
    constexpr __fcxx_tuple_leaf(__fcxx_tuple_alloc_tag, const _Alloc& __a, _Args&&... __args)
        : _Tp(std::make_obj_using_allocator<_Tp>(__a, std::forward<_Args>(__args)...)) {}

    __fcxx_tuple_leaf(const __fcxx_tuple_leaf&) = default;
    __fcxx_tuple_leaf(__fcxx_tuple_leaf&&) = default;

    constexpr _Tp& __get() noexcept {
        return *this;
    }

    constexpr const _Tp& __get() const noexcept {
        return *this;
    }

private:
};

/* All of the elements of a tuple, with what the tuple does to all of them
 * at once. */
template <class _Seq, class... _Types>
class __fcxx_tuple_impl;

template <size_t... _Is, class... _Types>
class __fcxx_tuple_impl<index_sequence<_Is...>, _Types...> : public __fcxx_tuple_leaf<_Is, _Types>... {
public:
    constexpr __fcxx_tuple_impl() : __fcxx_tuple_leaf<_Is, _Types>()... {}

    template <class... _Up>
    constexpr __fcxx_tuple_impl(__fcxx_tuple_elem_tag __tag, _Up&&... __u)
        : __fcxx_tuple_leaf<_Is, _Types>(__tag, std::forward<_Up>(__u))... {}

    template <class _Tuple>
    constexpr __fcxx_tuple_impl(__fcxx_tuple_from_tag, _Tuple&& __t)
        : __fcxx_tuple_leaf<_Is, _Types>(__fcxx_tuple_elem_tag(),
                                         std::__fcxx_adl_get<_Is>(std::forward<_Tuple>(__t)))... {}

    template <class _Alloc>
    constexpr __fcxx_tuple_impl(__fcxx_tuple_alloc_tag __tag, const _Alloc& __a)
        : __fcxx_tuple_leaf<_Is, _Types>(__tag, __a)... {}

    template <class _Alloc, class... _Up>
    constexpr __fcxx_tuple_impl(__fcxx_tuple_alloc_tag __tag, const _Alloc& __a, __fcxx_tuple_elem_tag,
                                        _Up&&... __u)
        : __fcxx_tuple_leaf<_Is, _Types>(__tag, __a, std::forward<_Up>(__u))... {}

    template <class _Alloc, class _Tuple>
    constexpr __fcxx_tuple_impl(__fcxx_tuple_alloc_tag __tag, const _Alloc& __a, __fcxx_tuple_from_tag,
                                        _Tuple&& __t)
        : __fcxx_tuple_leaf<_Is, _Types>(__tag, __a, std::__fcxx_adl_get<_Is>(std::forward<_Tuple>(__t)))... {}

    __fcxx_tuple_impl(const __fcxx_tuple_impl&) = default;
    __fcxx_tuple_impl(__fcxx_tuple_impl&&) = default;

    /* Assigning the elements of a tuple-like object to those of this one,
     * in order. */
    template <class _Tuple>
    constexpr void __assign(_Tuple&& __t) {
        int __in_order[] = {0, ((void)(__fcxx_tuple_leaf<_Is, _Types>::__get()
                                       = std::__fcxx_adl_get<_Is>(std::forward<_Tuple>(__t))), 0)...};
        (void)__in_order;
    }

    template <class _Tuple>
    constexpr void __assign_const(_Tuple&& __t) const {
        int __in_order[] = {0, ((void)(__fcxx_tuple_leaf<_Is, _Types>::__get()
                                       = std::__fcxx_adl_get<_Is>(std::forward<_Tuple>(__t))), 0)...};
        (void)__in_order;
    }

    constexpr void __swap(__fcxx_tuple_impl& __other) {
        int __in_order[] = {0,
                            ((void)std::__fcxx_adl_swap(__fcxx_tuple_leaf<_Is, _Types>::__get(),
                                                        static_cast<__fcxx_tuple_leaf<_Is, _Types>&>(__other).__get()),
                             0)...};
        (void)__in_order;
    }

    constexpr void __swap_const(const __fcxx_tuple_impl& __other) const {
        int __in_order[] = {0, ((void)std::__fcxx_adl_swap(
                                    __fcxx_tuple_leaf<_Is, _Types>::__get(),
                                    static_cast<const __fcxx_tuple_leaf<_Is, _Types>&>(__other).__get()),
                                0)...};
        (void)__in_order;
    }
};

/* [tuple.helper], tuple helper classes */

template <class... _Types>
struct tuple_size<tuple<_Types...> > : integral_constant<size_t, sizeof...(_Types)> {};

template <size_t _Ip, class... _Types>
struct tuple_element<_Ip, tuple<_Types...> > {
    static_assert(_Ip < sizeof...(_Types), "std::tuple_element index out of range for std::tuple");
    typedef __fcxx_type_at_t<_Ip, _Types...> type;
};

template <class... _Types>
struct __fcxx_is_tuple_like_impl<tuple<_Types...> > : true_type {};

/* The comparisons of the elements of tuples and tuple-like objects. */

template <size_t _Ip, size_t _Np>
struct __fcxx_tuple_compare {
    template <class _Tp, class _Up>
    static constexpr bool __eq(const _Tp& __t, const _Up& __u) {
        return bool(std::__fcxx_adl_get<_Ip>(__t) == std::__fcxx_adl_get<_Ip>(__u))
            && __fcxx_tuple_compare<_Ip + 1, _Np>::__eq(__t, __u);
    }

    template <class _Tp, class _Up>
    static constexpr bool __lt(const _Tp& __t, const _Up& __u) {
        return bool(std::__fcxx_adl_get<_Ip>(__t) < std::__fcxx_adl_get<_Ip>(__u))
            || (!bool(std::__fcxx_adl_get<_Ip>(__u) < std::__fcxx_adl_get<_Ip>(__t))
                && __fcxx_tuple_compare<_Ip + 1, _Np>::__lt(__t, __u));
    }
};

template <size_t _Np>
struct __fcxx_tuple_compare<_Np, _Np> {
    template <class _Tp, class _Up>
    static constexpr bool __eq(const _Tp&, const _Up&) {
        return true;
    }

    template <class _Tp, class _Up>
    static constexpr bool __lt(const _Tp&, const _Up&) {
        return false;
    }
};

/* The element-wise equality of a tuple and a tuple-like object of the same
 * size, and their three-way comparison. */
template <class _Tp, class _Up, class _Seq = make_index_sequence<tuple_size<_Tp>::value> >
struct __fcxx_tuple_eq_check : false_type {};

template <size_t _Ip, class _Tp, class _Up>
concept __fcxx_tuple_elem_eq = requires(const _Tp& __t, const _Up& __u) {
    { std::__fcxx_adl_get<_Ip>(__t) == std::__fcxx_adl_get<_Ip>(__u) } -> __boolean_testable;
};

template <class _Tp, class _Up, size_t... _Is>
    requires (tuple_size<_Tp>::value == tuple_size<_Up>::value)
struct __fcxx_tuple_eq_check<_Tp, _Up, index_sequence<_Is...> >
    : __fcxx_bool_constant<(__fcxx_tuple_elem_eq<_Is, _Tp, _Up> && ...)> {};

template <class _Tp, class _Up, class _Seq = make_index_sequence<tuple_size<_Tp>::value> >
struct __fcxx_tuple_three_way_result {};

template <class _Tp, class _Up, size_t... _Is>
    requires (tuple_size<_Tp>::value == tuple_size<_Up>::value)
          && requires {
                 typename common_comparison_category_t<__fcxx_synth_three_way_result<
                     typename tuple_element<_Is, _Tp>::type, typename tuple_element<_Is, _Up>::type>...>;
             }
struct __fcxx_tuple_three_way_result<_Tp, _Up, index_sequence<_Is...> > {
    using type = common_comparison_category_t<__fcxx_synth_three_way_result<typename tuple_element<_Is, _Tp>::type,
                                                                            typename tuple_element<_Is, _Up>::type>...>;
};

template <class _Result, size_t _Ip, size_t _Np, class _Tp, class _Up>
constexpr _Result __fcxx_tuple_three_way(const _Tp& __t, const _Up& __u) {
    if constexpr (_Ip == _Np) {
        return strong_ordering::equal;
    } else {
        if (auto __c = __fcxx_synth_three_way(std::__fcxx_adl_get<_Ip>(__t), std::__fcxx_adl_get<_Ip>(__u)); __c != 0) {
            return __c;
        }
        return std::__fcxx_tuple_three_way<_Result, _Ip + 1, _Np>(__t, __u);
    }
}

/* The comparisons of tuples with the other tuple-like types. */
template <class _Tuple, class _UTuple>
concept __fcxx_tuple_comparable_with = __fcxx_tuple_like<_UTuple> && !__fcxx_is_tuple_spec<_UTuple>::value
#if _FCXX_STD >= 2026
    && __fcxx_tuple_eq_check<_Tuple, _UTuple>::value
#endif
    ;

/* [tuple.tuple], class template tuple */

template <class _TList, class _UList>
concept __fcxx_tuple_constructible = __fcxx_zip_all<__fcxx_constructible_pred, _TList, _UList>::value;

template <class _TList, class _UList>
inline constexpr bool __fcxx_tuple_convertible = __fcxx_zip_all<__fcxx_convertible_pred, _TList, _UList>::value;

template <class _TList, class _UList>
inline constexpr bool __fcxx_tuple_nothrow = __fcxx_zip_all<__fcxx_nothrow_constructible_pred, _TList, _UList>::value;

template <class _TList, class _UList>
inline constexpr bool __fcxx_tuple_dangles =
#if _FCXX_HAS_DANGLING_CHECK
    !__fcxx_zip_all<__fcxx_no_dangling_pred, _TList, _UList>::value;
#else
    false;
#endif

/* The types of the elements of a tuple-like type, as get gives them. */
template <class _UTuple, class _Seq = make_index_sequence<tuple_size<__fcxx_remove_cvref_t<_UTuple> >::value> >
struct __fcxx_tuple_get_types;

template <class _UTuple, size_t... _Is>
struct __fcxx_tuple_get_types<_UTuple, index_sequence<_Is...> > {
    typedef __fcxx_type_list<__fcxx_get_t<_Is, _UTuple>...> type;
};

template <class _UTuple, class _Tuple, class _TList>
concept __fcxx_tuple_like_other = __fcxx_tuple_like<_UTuple> && !is_same<__fcxx_remove_cvref_t<_UTuple>, _Tuple>::value
    && !__fcxx_is_subrange<__fcxx_remove_cvref_t<_UTuple> >::value
    && tuple_size<__fcxx_remove_cvref_t<_UTuple> >::value == __fcxx_list_size<_TList>::value;

/* Whether the constructors from a tuple-like type are explicit, which only
 * looks at the elements of tuple-like types, as the explicit specifier can
 * be substituted into before the constraints are checked. */
template <class _TList, class _UTuple, bool = __fcxx_tuple_like<_UTuple> >
struct __fcxx_tuple_like_implicit : false_type {};

template <class _TList, class _UTuple>
struct __fcxx_tuple_like_implicit<_TList, _UTuple, true>
    : __fcxx_bool_constant<__fcxx_tuple_convertible<_TList, typename __fcxx_tuple_get_types<_UTuple>::type> > {};

template <class _UTuple, class... _Types>
struct __fcxx_tuple_like_single : true_type {};

template <class _UTuple, class _Tp>
struct __fcxx_tuple_like_single<_UTuple, _Tp>
    : __fcxx_and<__fcxx_not<is_convertible<_UTuple, _Tp> >, __fcxx_not<is_constructible<_Tp, _UTuple> > > {};

template <class... _Types>
class tuple : private __fcxx_tuple_impl<index_sequence_for<_Types...>, _Types...> {
    typedef __fcxx_tuple_impl<index_sequence_for<_Types...>, _Types...> _Base;
    typedef __fcxx_type_list<_Types...> _TList;

    template <class _UTuple>
    using _GetTypes = typename __fcxx_tuple_get_types<_UTuple>::type;

public:
    /* [tuple.cnstr], tuple construction */
    constexpr explicit(!__fcxx_and<__fcxx_is_implicitly_default_constructible<_Types>...>::value)
    tuple() requires (__fcxx_and<is_default_constructible<_Types>...>::value) : _Base() {}

    constexpr explicit(!__fcxx_tuple_convertible<_TList, __fcxx_type_list<const _Types&...> >)
    tuple(const _Types&... __args) noexcept(__fcxx_and<is_nothrow_copy_constructible<_Types>...>::value)
        requires (__fcxx_and<is_copy_constructible<_Types>...>::value)
        : _Base(__fcxx_tuple_elem_tag(), __args...) {}

    template <class... _UTypes>
        requires (__fcxx_tuple_forwarding<tuple, _TList, __fcxx_type_list<_UTypes...> >::value
                  && !__fcxx_tuple_dangles<_TList, __fcxx_type_list<_UTypes&&...> >)
    constexpr explicit(!__fcxx_tuple_convertible<_TList, __fcxx_type_list<_UTypes...> >)
    tuple(_UTypes&&... __u) noexcept(__fcxx_tuple_nothrow<_TList, __fcxx_type_list<_UTypes...> >)
        : _Base(__fcxx_tuple_elem_tag(), std::forward<_UTypes>(__u)...) {}

    tuple(const tuple&) = default;
    tuple(tuple&&) = default;

    template <class... _UTypes>
        requires (__fcxx_tuple_constructible<_TList, __fcxx_type_list<_UTypes&...> >
                  && __fcxx_tuple_conv_single<tuple<_UTypes...>&, _TList, __fcxx_type_list<_UTypes...> >::value
                  && !__fcxx_tuple_dangles<_TList, __fcxx_type_list<_UTypes&...> >)
    constexpr explicit(!__fcxx_tuple_convertible<_TList, __fcxx_type_list<_UTypes&...> >)
    tuple(tuple<_UTypes...>& __u) : _Base(__fcxx_tuple_from_tag(), __u) {}

    template <class... _UTypes>
        requires (__fcxx_tuple_constructible<_TList, __fcxx_type_list<const _UTypes&...> >
                  && __fcxx_tuple_conv_single<const tuple<_UTypes...>&, _TList, __fcxx_type_list<_UTypes...> >::value
                  && !__fcxx_tuple_dangles<_TList, __fcxx_type_list<const _UTypes&...> >)
    constexpr explicit(!__fcxx_tuple_convertible<_TList, __fcxx_type_list<const _UTypes&...> >)
    tuple(const tuple<_UTypes...>& __u) : _Base(__fcxx_tuple_from_tag(), __u) {}

    template <class... _UTypes>
        requires (__fcxx_tuple_constructible<_TList, __fcxx_type_list<_UTypes&&...> >
                  && __fcxx_tuple_conv_single<tuple<_UTypes...>&&, _TList, __fcxx_type_list<_UTypes...> >::value
                  && !__fcxx_tuple_dangles<_TList, __fcxx_type_list<_UTypes&&...> >)
    constexpr explicit(!__fcxx_tuple_convertible<_TList, __fcxx_type_list<_UTypes&&...> >)
    tuple(tuple<_UTypes...>&& __u) : _Base(__fcxx_tuple_from_tag(), std::move(__u)) {}

    template <class... _UTypes>
        requires (__fcxx_tuple_constructible<_TList, __fcxx_type_list<const _UTypes&&...> >
                  && __fcxx_tuple_conv_single<const tuple<_UTypes...>&&, _TList, __fcxx_type_list<_UTypes...> >::value
                  && !__fcxx_tuple_dangles<_TList, __fcxx_type_list<const _UTypes&&...> >)
    constexpr explicit(!__fcxx_tuple_convertible<_TList, __fcxx_type_list<const _UTypes&&...> >)
    tuple(const tuple<_UTypes...>&& __u) : _Base(__fcxx_tuple_from_tag(), std::move(__u)) {}

    template <class _U1, class _U2>
        requires (__fcxx_tuple_constructible<_TList, __fcxx_type_list<_U1&, _U2&> >
                  && !__fcxx_tuple_dangles<_TList, __fcxx_type_list<_U1&, _U2&> >)
    constexpr explicit(!__fcxx_tuple_convertible<_TList, __fcxx_type_list<_U1&, _U2&> >)
    tuple(pair<_U1, _U2>& __p) : _Base(__fcxx_tuple_from_tag(), __p) {}

    template <class _U1, class _U2>
        requires (__fcxx_tuple_constructible<_TList, __fcxx_type_list<const _U1&, const _U2&> >
                  && !__fcxx_tuple_dangles<_TList, __fcxx_type_list<const _U1&, const _U2&> >)
    constexpr explicit(!__fcxx_tuple_convertible<_TList, __fcxx_type_list<const _U1&, const _U2&> >)
    tuple(const pair<_U1, _U2>& __p) : _Base(__fcxx_tuple_from_tag(), __p) {}

    template <class _U1, class _U2>
        requires (__fcxx_tuple_constructible<_TList, __fcxx_type_list<_U1&&, _U2&&> >
                  && !__fcxx_tuple_dangles<_TList, __fcxx_type_list<_U1&&, _U2&&> >)
    constexpr explicit(!__fcxx_tuple_convertible<_TList, __fcxx_type_list<_U1&&, _U2&&> >)
    tuple(pair<_U1, _U2>&& __p) : _Base(__fcxx_tuple_from_tag(), std::move(__p)) {}

    template <class _U1, class _U2>
        requires (__fcxx_tuple_constructible<_TList, __fcxx_type_list<const _U1&&, const _U2&&> >
                  && !__fcxx_tuple_dangles<_TList, __fcxx_type_list<const _U1&&, const _U2&&> >)
    constexpr explicit(!__fcxx_tuple_convertible<_TList, __fcxx_type_list<const _U1&&, const _U2&&> >)
    tuple(const pair<_U1, _U2>&& __p) : _Base(__fcxx_tuple_from_tag(), std::move(__p)) {}

    template <class _UTuple>
        requires(__fcxx_tuple_like_other<_UTuple, tuple, _TList>
                 && __fcxx_tuple_constructible<_TList, _GetTypes<_UTuple>>
                 && __fcxx_tuple_like_single<_UTuple, _Types...>::value
#if _FCXX_STD >= 2026
                 && !__fcxx_tuple_dangles<_TList, _GetTypes<_UTuple>>
#endif
                 )
    constexpr explicit(!__fcxx_tuple_like_implicit<_TList, _UTuple>::value) tuple(_UTuple&& __u)
        : _Base(__fcxx_tuple_from_tag(), std::forward<_UTuple>(__u)) {
    }

#    if _FCXX_HAS_DANGLING_CHECK
    template <class... _UTypes>
        requires (__fcxx_tuple_forwarding<tuple, _TList, __fcxx_type_list<_UTypes...> >::value
                  && __fcxx_tuple_dangles<_TList, __fcxx_type_list<_UTypes&&...> >)
    constexpr explicit(!__fcxx_tuple_convertible<_TList, __fcxx_type_list<_UTypes...> >) tuple(_UTypes&&...) = delete;

    template <class... _UTypes>
        requires (__fcxx_tuple_constructible<_TList, __fcxx_type_list<_UTypes&...> >
