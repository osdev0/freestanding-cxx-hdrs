template <class... _Ts, class... _Us, class... _Rest>
struct __fcxx_concat_tuples<tuple<_Ts...>, tuple<_Us...>, _Rest...>
    : __fcxx_concat_tuples<tuple<_Ts..., _Us...>, _Rest...> {};

template <class _Seq, class... _Tuples>
struct __fcxx_tuple_cat_impl;

template <size_t... _Js, class... _Tuples>
struct __fcxx_tuple_cat_impl<index_sequence<_Js...>, _Tuples...> {
    typedef typename __fcxx_concat_tuples<typename __fcxx_tuple_elements<_Tuples>::type...>::type type;
    typedef typename __fcxx_concat_seqs<
        typename __fcxx_repeat_seq<_Js, make_index_sequence<tuple_size<_Tuples>::value> >::type...>::type _Outer;
    typedef typename __fcxx_concat_seqs<make_index_sequence<tuple_size<_Tuples>::value>...>::type _Inner;
};

template <class... _Tuples>
struct __fcxx_tuple_cat : __fcxx_tuple_cat_impl<index_sequence_for<_Tuples...>, __fcxx_remove_cvref_t<_Tuples>...> {};

template <class _Ret, size_t... _Os, size_t... _Is, class _Refs>
constexpr _Ret __fcxx_tuple_cat_from(index_sequence<_Os...>, index_sequence<_Is...>, _Refs&& __refs) {
    return _Ret(std::__fcxx_adl_get<_Is>(std::__fcxx_adl_get<_Os>(std::move(__refs)))...);
}

template <class... _Tuples
          >
    requires (__fcxx_tuple_like<_Tuples> && ...)
constexpr typename __fcxx_tuple_cat<_Tuples...>::type tuple_cat(_Tuples&&... __tpls) {
    typedef __fcxx_tuple_cat<_Tuples...> _Cat;
    return std::__fcxx_tuple_cat_from<typename _Cat::type>(typename _Cat::_Outer(), typename _Cat::_Inner(),
                                                           std::forward_as_tuple(std::forward<_Tuples>(__tpls)...));
}

/* [tuple.apply], calling a function with a tuple of arguments */

template <class _Fp, class _Tuple, size_t... _Is>
constexpr decltype(auto) __fcxx_apply(_Fp&& __f, _Tuple&& __t, index_sequence<_Is...>) noexcept(
    noexcept(std::__fcxx_invoke(std::forward<_Fp>(__f), std::__fcxx_adl_get<_Is>(std::forward<_Tuple>(__t))...))) {
    return std::__fcxx_invoke(std::forward<_Fp>(__f), std::__fcxx_adl_get<_Is>(std::forward<_Tuple>(__t))...);
}

template <class _Tuple>
using __fcxx_tuple_indices = make_index_sequence<tuple_size<__fcxx_remove_ref_t<_Tuple> >::value>;

#if _FCXX_STD >= 2026
template <class _Fp, __fcxx_tuple_like _Tuple>
constexpr apply_result_t<_Fp, _Tuple> apply(_Fp&& __f, _Tuple&& __t) noexcept(is_nothrow_applicable_v<_Fp, _Tuple>) {
    return std::__fcxx_apply(std::forward<_Fp>(__f), std::forward<_Tuple>(__t), __fcxx_tuple_indices<_Tuple>());
}
#else
template <class _Fp, class _Tuple
          >
    requires __fcxx_tuple_like<_Tuple>
constexpr decltype(auto) apply(_Fp&& __f, _Tuple&& __t) noexcept(
    noexcept(std::__fcxx_apply(std::forward<_Fp>(__f), std::forward<_Tuple>(__t), __fcxx_tuple_indices<_Tuple>()))) {
    return std::__fcxx_apply(std::forward<_Fp>(__f), std::forward<_Tuple>(__t), __fcxx_tuple_indices<_Tuple>());
}
#endif

/* Whether make_from_tuple would bind a reference to a temporary. */
template <class _Tp, class _Tuple, bool = (tuple_size<__fcxx_remove_ref_t<_Tuple> >::value == 1)>
struct __fcxx_make_from_tuple_dangles : false_type {};

#if _FCXX_STD >= 2026 && _FCXX_HAS_BUILTIN(__reference_constructs_from_temporary)
template <class _Tp, class _Tuple>
struct __fcxx_make_from_tuple_dangles<_Tp, _Tuple, true>
    : __fcxx_bool_constant<__reference_constructs_from_temporary(
          _Tp, decltype(std::__fcxx_adl_get<0>(std::declval<_Tuple>())))> {};
#endif

template <class _Tp, class _Tuple, size_t... _Is>
constexpr _Tp __fcxx_make_from_tuple(_Tuple&& __t, index_sequence<_Is...>) {
    static_assert(is_constructible<_Tp, decltype(std::__fcxx_adl_get<_Is>(std::forward<_Tuple>(__t)))...>::value,
                  "std::make_from_tuple: the type is not constructible from the elements");
    static_assert(!__fcxx_make_from_tuple_dangles<_Tp, _Tuple>::value,
                  "std::make_from_tuple: the reference would be bound to a temporary");
    return _Tp(std::__fcxx_adl_get<_Is>(std::forward<_Tuple>(__t))...);
}

template <class _Tp, class _Tuple
          >
    requires __fcxx_tuple_like<_Tuple>
constexpr _Tp make_from_tuple(_Tuple&& __t) {
    return std::__fcxx_make_from_tuple<_Tp>(std::forward<_Tuple>(__t), __fcxx_tuple_indices<_Tuple>());
}

/* [tuple.rel], relational operators */

template <class... _TTypes, class... _UTypes>
#if _FCXX_STD >= 2026
    requires (__fcxx_tuple_eq_check<tuple<_TTypes...>, tuple<_UTypes...> >::value)
#endif
constexpr bool operator==(const tuple<_TTypes...>& __t, const tuple<_UTypes...>& __u) {
    static_assert(sizeof...(_TTypes) == sizeof...(_UTypes), "std::tuple comparison of tuples of different sizes");
    return __fcxx_tuple_compare<0, sizeof...(_TTypes)>::__eq(__t, __u);
}

template <class... _TTypes, class... _UTypes>
constexpr typename __fcxx_tuple_three_way_result<tuple<_TTypes...>, tuple<_UTypes...> >::type
operator<=>(const tuple<_TTypes...>& __t, const tuple<_UTypes...>& __u) {
    return std::__fcxx_tuple_three_way<
        typename __fcxx_tuple_three_way_result<tuple<_TTypes...>, tuple<_UTypes...> >::type, 0, sizeof...(_TTypes)>(__t,
                                                                                                                  __u);
}

/* [tuple.traits], allocator-related traits */

template <class... _Types, class _Alloc>
struct uses_allocator<tuple<_Types...>, _Alloc> : true_type {};

/* [tuple.special], specialized algorithms */

template <class... _Types>
constexpr __fcxx_enable_if_t<__fcxx_and<__fcxx_is_swappable<_Types>...>::value>
swap(tuple<_Types...>& __x, tuple<_Types...>& __y) noexcept(noexcept(__x.swap(__y))) {
    __x.swap(__y);
}

template <class... _Types>
    requires (__fcxx_and<__fcxx_is_swappable<const _Types>...>::value)
constexpr void swap(const tuple<_Types...>& __x, const tuple<_Types...>& __y) noexcept(noexcept(__x.swap(__y))) {
    __x.swap(__y);
}

/* [tuple.common.ref], common_reference related specializations */

template <class _TTuple, class _UTuple, template <class> class _TQual, template <class> class _UQual,
          class _Seq = make_index_sequence<tuple_size<_TTuple>::value> >
struct __fcxx_tuple_common_reference {};

template <class _TTuple, class _UTuple, template <class> class _TQual, template <class> class _UQual, size_t... _Is>
    requires requires {
        typename tuple<common_reference_t<_TQual<typename tuple_element<_Is, _TTuple>::type>,
                                          _UQual<typename tuple_element<_Is, _UTuple>::type> >...>;
    }
struct __fcxx_tuple_common_reference<_TTuple, _UTuple, _TQual, _UQual, index_sequence<_Is...> > {
    using type = tuple<common_reference_t<_TQual<typename tuple_element<_Is, _TTuple>::type>,
                                          _UQual<typename tuple_element<_Is, _UTuple>::type> >...>;
};

template <class _TTuple, class _UTuple, class _Seq = make_index_sequence<tuple_size<_TTuple>::value> >
struct __fcxx_tuple_common_type {};

template <class _TTuple, class _UTuple, size_t... _Is>
    requires requires {
        typename tuple<common_type_t<typename tuple_element<_Is, _TTuple>::type,
                                     typename tuple_element<_Is, _UTuple>::type>...>;
    }
struct __fcxx_tuple_common_type<_TTuple, _UTuple, index_sequence<_Is...> > {
    using type = tuple<common_type_t<typename tuple_element<_Is, _TTuple>::type,
                                     typename tuple_element<_Is, _UTuple>::type>...>;
};

template <class _TTuple, class _UTuple>
concept __fcxx_tuple_common_candidates = (__fcxx_is_tuple_spec<_TTuple>::value || __fcxx_is_tuple_spec<_UTuple>::value)
    && is_same<_TTuple, __fcxx_decay_t<_TTuple> >::value && is_same<_UTuple, __fcxx_decay_t<_UTuple> >::value
    && tuple_size<_TTuple>::value == tuple_size<_UTuple>::value;

template <__fcxx_tuple_like _TTuple, __fcxx_tuple_like _UTuple, template <class> class _TQual,
          template <class> class _UQual>
    requires (__fcxx_tuple_common_candidates<_TTuple, _UTuple>
              && requires { typename __fcxx_tuple_common_reference<_TTuple, _UTuple, _TQual, _UQual>::type; })
struct basic_common_reference<_TTuple, _UTuple, _TQual, _UQual> {
    using type = typename __fcxx_tuple_common_reference<_TTuple, _UTuple, _TQual, _UQual>::type;
};

template <__fcxx_tuple_like _TTuple, __fcxx_tuple_like _UTuple>
    requires (__fcxx_tuple_common_candidates<_TTuple, _UTuple>
              && requires { typename __fcxx_tuple_common_type<_TTuple, _UTuple>::type; })
struct common_type<_TTuple, _UTuple> {
    using type = typename __fcxx_tuple_common_type<_TTuple, _UTuple>::type;
};

