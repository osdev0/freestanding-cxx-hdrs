/* [numeric.ops.midpoint], midpoint. Integers are halved in the unsigned
 * type, rounding towards a; floating-point values are halved before they
 * are added where they are so large that their sum would overflow, and
 * after where one is so small that halving it would be inexact. */
template <class _Tp>
    requires(is_arithmetic<_Tp>::value && !is_same<typename remove_cv<_Tp>::type, bool>::value)
[[nodiscard]] constexpr _Tp midpoint(_Tp __a, _Tp __b) noexcept {
    if constexpr (is_integral<_Tp>::value) {
        typedef typename make_unsigned<_Tp>::type _Up;
        if (__a > __b) {
            const _Up __half = static_cast<_Up>(static_cast<_Up>(static_cast<_Up>(__a) - static_cast<_Up>(__b)) / 2);
            return static_cast<_Tp>(__a - static_cast<_Tp>(__half));
        }
        const _Up __half = static_cast<_Up>(static_cast<_Up>(static_cast<_Up>(__b) - static_cast<_Up>(__a)) / 2);
        return static_cast<_Tp>(__a + static_cast<_Tp>(__half));
    } else {
        const _Tp __low = numeric_limits<_Tp>::min() * 2;
        const _Tp __high = numeric_limits<_Tp>::max() / 2;
        const _Tp __abs_a = __a < 0 ? -__a : __a;
        const _Tp __abs_b = __b < 0 ? -__b : __b;
        if (__abs_a <= __high && __abs_b <= __high) {
            return (__a + __b) / 2;
        }
        if (__abs_a < __low) {
            return __a + __b / 2;
        }
        if (__abs_b < __low) {
            return __a / 2 + __b;
        }
        return __a / 2 + __b / 2;
    }
}

template <class _Tp>
    requires is_object<_Tp>::value
[[nodiscard]] constexpr _Tp* midpoint(_Tp* __a, _Tp* __b) {
    static_assert(sizeof(_Tp) != 0, "std::midpoint takes pointers to complete types");
    return __a + (__b - __a) / 2;
}

/* [numeric.iota], ranges::iota */
namespace ranges {

template <class _Out, class _Tp>
using iota_result = out_value_result<_Out, _Tp>;

struct __fcxx_iota_fn {
    template <input_or_output_iterator _Out, sentinel_for<_Out> _Sp, weakly_incrementable _Tp>
        requires indirectly_writable<_Out, const _Tp&>
    constexpr iota_result<_Out, _Tp> operator()(_Out __first, _Sp __last, _Tp __value) const {
        for (; __first != __last; ++__first) {
            *__first = static_cast<const _Tp&>(__value);
            ++__value;
        }
        return {std::move(__first), std::move(__value)};
    }

    template <weakly_incrementable _Tp, output_range<const _Tp&> _Rp>
    constexpr iota_result<borrowed_iterator_t<_Rp>, _Tp> operator()(_Rp&& __r, _Tp __value) const {
        return (*this)(ranges::begin(__r), ranges::end(__r), std::move(__value));
    }
};

inline constexpr __fcxx_iota_fn iota{};

} /* namespace ranges */

/* [numeric.sat], saturation arithmetic, of the signed and unsigned integer
 * types, which are the integral types other than bool and the character
 * types, without cv-qualifiers. The sums and the differences are checked
 * against the bounds before they are computed, and the products are
 * computed of the absolute values, in the unsigned type. */
template <class _Tp>
concept __fcxx_sat_integer = same_as<_Tp, remove_cv_t<_Tp> > && __fcxx_is_cmp_integer<_Tp>::value;

template <__fcxx_sat_integer _Tp>
[[nodiscard]] constexpr _Tp saturating_add(_Tp __x, _Tp __y) noexcept {
    if constexpr (is_signed_v<_Tp>) {
        if (__y > 0 && __x > numeric_limits<_Tp>::max() - __y) {
            return numeric_limits<_Tp>::max();
        }
        if (__y < 0 && __x < numeric_limits<_Tp>::min() - __y) {
            return numeric_limits<_Tp>::min();
        }
        return static_cast<_Tp>(__x + __y);
    } else {
        const _Tp __r = static_cast<_Tp>(__x + __y);
        return __r < __x ? numeric_limits<_Tp>::max() : __r;
    }
}

template <__fcxx_sat_integer _Tp>
[[nodiscard]] constexpr _Tp saturating_sub(_Tp __x, _Tp __y) noexcept {
    if constexpr (is_signed_v<_Tp>) {
        if (__y < 0 && __x > numeric_limits<_Tp>::max() + __y) {
            return numeric_limits<_Tp>::max();
        }
        if (__y > 0 && __x < numeric_limits<_Tp>::min() + __y) {
            return numeric_limits<_Tp>::min();
        }
        return static_cast<_Tp>(__x - __y);
    } else {
        return __x < __y ? static_cast<_Tp>(0) : static_cast<_Tp>(__x - __y);
    }
}

template <__fcxx_sat_integer _Tp>
[[nodiscard]] constexpr _Tp saturating_mul(_Tp __x, _Tp __y) noexcept {
    using _Up = make_unsigned_t<_Tp>;
    if constexpr (is_signed_v<_Tp>) {
        const bool __negative = (__x < 0) != (__y < 0);
        const _Up __ux = std::__fcxx_unsigned_abs<_Up>(__x);
        const _Up __uy = std::__fcxx_unsigned_abs<_Up>(__y);
        _Up __product = 0;
        const bool __overflow = __builtin_mul_overflow(__ux, __uy, &__product);
        const _Up __limit = static_cast<_Up>(static_cast<_Up>(numeric_limits<_Tp>::max()) + (__negative ? 1 : 0));
        if (__overflow || __product > __limit) {
            return __negative ? numeric_limits<_Tp>::min() : numeric_limits<_Tp>::max();
        }
        return __negative ? static_cast<_Tp>(static_cast<_Up>(static_cast<_Up>(0) - __product))
                          : static_cast<_Tp>(__product);
    } else {
        _Tp __product = 0;
        if (__builtin_mul_overflow(__x, __y, &__product)) {
            return numeric_limits<_Tp>::max();
        }
        return __product;
    }
}

template <__fcxx_sat_integer _Tp>
[[nodiscard]] constexpr _Tp saturating_div(_Tp __x, _Tp __y) noexcept {
    if constexpr (is_signed_v<_Tp>) {
        if (__x == numeric_limits<_Tp>::min() && __y == -1) {
            return numeric_limits<_Tp>::max();
        }
    }
    return static_cast<_Tp>(__x / __y);
}

/* [numeric.sat.cast], casting */
template <__fcxx_sat_integer _Rp, __fcxx_sat_integer _Tp>
[[nodiscard]] constexpr _Rp saturating_cast(_Tp __x) noexcept {
    if (std::cmp_less(__x, numeric_limits<_Rp>::min())) {
