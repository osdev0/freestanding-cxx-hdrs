/* The accumulators are moved from, as P0616 has it, and adjacent_difference
 * moves the values to its accumulator. */

namespace std {

/* [accumulate], accumulate */
template <class _InputIterator, class _Tp>
[[nodiscard]] constexpr _Tp accumulate(_InputIterator __first, _InputIterator __last, _Tp __init) {
    for (; __first != __last; ++__first) {
        __init = std::move(__init) + *__first;
    }
    return __init;
}

template <class _InputIterator, class _Tp, class _BinaryOperation>
[[nodiscard]] constexpr _Tp accumulate(_InputIterator __first, _InputIterator __last, _Tp __init,
                                                 _BinaryOperation __binary_op) {
    for (; __first != __last; ++__first) {
        __init = __binary_op(std::move(__init), *__first);
    }
    return __init;
}

/* [inner.product], inner product */
template <class _InputIterator1, class _InputIterator2, class _Tp>
[[nodiscard]] constexpr _Tp inner_product(_InputIterator1 __first1, _InputIterator1 __last1,
                                                    _InputIterator2 __first2, _Tp __init) {
    for (; __first1 != __last1; ++__first1, (void)++__first2) {
        __init = std::move(__init) + _FCXX_MUL(*__first1, *__first2);
    }
    return __init;
}

template <class _InputIterator1, class _InputIterator2, class _Tp, class _BinaryOperation1, class _BinaryOperation2>
[[nodiscard]] constexpr _Tp inner_product(_InputIterator1 __first1, _InputIterator1 __last1,
                                                    _InputIterator2 __first2, _Tp __init,
                                                    _BinaryOperation1 __binary_op1, _BinaryOperation2 __binary_op2) {
    for (; __first1 != __last1; ++__first1, (void)++__first2) {
        __init = __binary_op1(std::move(__init), __binary_op2(*__first1, *__first2));
    }
    return __init;
}

/* [partial.sum], partial sum, with an accumulator of the value type of the
 * input, which is read before the output is written, as they may be the
 * same. */
template <class _InputIterator, class _OutputIterator, class _BinaryOperation>
constexpr _OutputIterator partial_sum(_InputIterator __first, _InputIterator __last, _OutputIterator __result,
                                              _BinaryOperation __binary_op) {
    if (__first == __last) {
        return __result;
    }
    typename iterator_traits<_InputIterator>::value_type __acc(*__first);
    *__result = __acc;
    ++__result;
    for (++__first; __first != __last; ++__first, (void)++__result) {
        __acc = __binary_op(std::move(__acc), *__first);
        *__result = __acc;
    }
    return __result;
}

template <class _InputIterator, class _OutputIterator>
constexpr _OutputIterator partial_sum(_InputIterator __first, _InputIterator __last,
                                              _OutputIterator __result) {
    if (__first == __last) {
        return __result;
    }
    typename iterator_traits<_InputIterator>::value_type __acc(*__first);
    *__result = __acc;
    ++__result;
    for (++__first; __first != __last; ++__first, (void)++__result) {
        __acc = std::move(__acc) + *__first;
        *__result = __acc;
    }
    return __result;
}

/* [adjacent.difference], adjacent difference, with an accumulator of the
 * previous element, as the output may be the input. */
template <class _InputIterator, class _OutputIterator, class _BinaryOperation>
constexpr _OutputIterator adjacent_difference(_InputIterator __first, _InputIterator __last,
                                                      _OutputIterator __result, _BinaryOperation __binary_op) {
    typedef typename iterator_traits<_InputIterator>::value_type _Vp;
    if (__first == __last) {
        return __result;
    }
    _Vp __acc(*__first);
    *__result = __acc;
    ++__result;
    for (++__first; __first != __last; ++__first, (void)++__result) {
        _Vp __val(*__first);
        *__result = __binary_op(__val, std::move(__acc));
        __acc = std::move(__val);
    }
    return __result;
}

template <class _InputIterator, class _OutputIterator>
constexpr _OutputIterator adjacent_difference(_InputIterator __first, _InputIterator __last,
                                                      _OutputIterator __result) {
    typedef typename iterator_traits<_InputIterator>::value_type _Vp;
    if (__first == __last) {
        return __result;
    }
    _Vp __acc(*__first);
    *__result = __acc;
    ++__result;
    for (++__first; __first != __last; ++__first, (void)++__result) {
        _Vp __val(*__first);
        *__result = __val - std::move(__acc);
        __acc = std::move(__val);
    }
    return __result;
}

/* [numeric.iota], iota */
template <class _ForwardIterator, class _Tp>
constexpr void iota(_ForwardIterator __first, _ForwardIterator __last, _Tp __value) {
    for (; __first != __last; ++__first) {
        *__first = __value;
        ++__value;
    }
}

/* [reduce], reduce, and the scans, which apply their operations in order,
 * as the other orders they may apply them in are not needed without
 * parallelism. */
template <class _InputIterator, class _Tp, class _BinaryOperation>
[[nodiscard]] constexpr _Tp reduce(_InputIterator __first, _InputIterator __last, _Tp __init,
                                             _BinaryOperation __binary_op) {
    for (; __first != __last; ++__first) {
        __init = __binary_op(std::move(__init), *__first);
    }
    return __init;
}

template <class _InputIterator, class _Tp>
[[nodiscard]] constexpr _Tp reduce(_InputIterator __first, _InputIterator __last, _Tp __init) {
    return std::reduce(__first, __last, std::move(__init), plus<>());
}

template <class _InputIterator>
[[nodiscard]] constexpr typename iterator_traits<_InputIterator>::value_type
reduce(_InputIterator __first, _InputIterator __last) {
    return std::reduce(__first, __last, typename iterator_traits<_InputIterator>::value_type{}, plus<>());
}

/* [transform.reduce], transform reduce */
template <class _InputIterator1, class _InputIterator2, class _Tp, class _BinaryOperation1, class _BinaryOperation2>
[[nodiscard]] constexpr _Tp transform_reduce(_InputIterator1 __first1, _InputIterator1 __last1,
                                                       _InputIterator2 __first2, _Tp __init,
                                                       _BinaryOperation1 __binary_op1,
                                                       _BinaryOperation2 __binary_op2) {
    for (; __first1 != __last1; ++__first1, (void)++__first2) {
        __init = __binary_op1(std::move(__init), __binary_op2(*__first1, *__first2));
    }
    return __init;
}

template <class _InputIterator1, class _InputIterator2, class _Tp>
[[nodiscard]] constexpr _Tp transform_reduce(_InputIterator1 __first1, _InputIterator1 __last1,
                                                       _InputIterator2 __first2, _Tp __init) {
    return std::transform_reduce(__first1, __last1, __first2, std::move(__init), plus<>(), multiplies<>());
}

template <class _InputIterator, class _Tp, class _BinaryOperation, class _UnaryOperation>
[[nodiscard]] constexpr _Tp transform_reduce(_InputIterator __first, _InputIterator __last, _Tp __init,
                                                       _BinaryOperation __binary_op, _UnaryOperation __unary_op) {
    for (; __first != __last; ++__first) {
        __init = __binary_op(std::move(__init), __unary_op(*__first));
    }
    return __init;
}

/* [exclusive.scan], exclusive scan, which reads each element before it
 * writes the sum of the elements before it. */
template <class _InputIterator, class _OutputIterator, class _Tp, class _BinaryOperation>
constexpr _OutputIterator exclusive_scan(_InputIterator __first, _InputIterator __last,
                                                 _OutputIterator __result, _Tp __init, _BinaryOperation __binary_op) {
    for (; __first != __last; ++__first, (void)++__result) {
        _Tp __next = __binary_op(__init, *__first);
        *__result = std::move(__init);
        __init = std::move(__next);
    }
    return __result;
}

template <class _InputIterator, class _OutputIterator, class _Tp>
constexpr _OutputIterator exclusive_scan(_InputIterator __first, _InputIterator __last,
                                                 _OutputIterator __result, _Tp __init) {
    return std::exclusive_scan(__first, __last, __result, std::move(__init), plus<>());
}

/* [inclusive.scan], inclusive scan */
template <class _InputIterator, class _OutputIterator, class _BinaryOperation, class _Tp>
constexpr _OutputIterator inclusive_scan(_InputIterator __first, _InputIterator __last,
                                                 _OutputIterator __result, _BinaryOperation __binary_op, _Tp __init) {
    for (; __first != __last; ++__first, (void)++__result) {
        __init = __binary_op(std::move(__init), *__first);
        *__result = __init;
    }
    return __result;
}

template <class _InputIterator, class _OutputIterator, class _BinaryOperation>
constexpr _OutputIterator inclusive_scan(_InputIterator __first, _InputIterator __last,
                                                 _OutputIterator __result, _BinaryOperation __binary_op) {
    if (__first == __last) {
        return __result;
    }
    typename iterator_traits<_InputIterator>::value_type __acc(*__first);
    *__result = __acc;
    for (++__first, (void)++__result; __first != __last; ++__first, (void)++__result) {
        __acc = __binary_op(std::move(__acc), *__first);
        *__result = __acc;
    }
    return __result;
}

template <class _InputIterator, class _OutputIterator>
constexpr _OutputIterator inclusive_scan(_InputIterator __first, _InputIterator __last,
                                                 _OutputIterator __result) {
    return std::inclusive_scan(__first, __last, __result, plus<>());
}

/* [transform.exclusive.scan], [transform.inclusive.scan], which do not
 * apply the unary operation to the initial value. */
template <class _InputIterator, class _OutputIterator, class _Tp, class _BinaryOperation, class _UnaryOperation>
constexpr _OutputIterator transform_exclusive_scan(_InputIterator __first, _InputIterator __last,
                                                           _OutputIterator __result, _Tp __init,
                                                           _BinaryOperation __binary_op,
                                                           _UnaryOperation __unary_op) {
    for (; __first != __last; ++__first, (void)++__result) {
        _Tp __next = __binary_op(__init, __unary_op(*__first));
        *__result = std::move(__init);
        __init = std::move(__next);
    }
    return __result;
}

template <class _InputIterator, class _OutputIterator, class _BinaryOperation, class _UnaryOperation, class _Tp>
constexpr _OutputIterator transform_inclusive_scan(_InputIterator __first, _InputIterator __last,
                                                           _OutputIterator __result, _BinaryOperation __binary_op,
                                                           _UnaryOperation __unary_op, _Tp __init) {
    for (; __first != __last; ++__first, (void)++__result) {
        __init = __binary_op(std::move(__init), __unary_op(*__first));
        *__result = __init;
    }
    return __result;
}

template <class _InputIterator, class _OutputIterator, class _BinaryOperation, class _UnaryOperation>
constexpr _OutputIterator transform_inclusive_scan(_InputIterator __first, _InputIterator __last,
                                                           _OutputIterator __result, _BinaryOperation __binary_op,
                                                           _UnaryOperation __unary_op) {
    if (__first == __last) {
        return __result;
    }
    typename iterator_traits<_InputIterator>::value_type __acc(__unary_op(*__first));
    *__result = __acc;
    for (++__first, (void)++__result; __first != __last; ++__first, (void)++__result) {
        __acc = __binary_op(std::move(__acc), __unary_op(*__first));
        *__result = __acc;
    }
    return __result;
}

/* [numeric.ops.gcd], [numeric.ops.lcm], of the absolute values, in the
 * unsigned type of the common type, which the absolute values of all the
 * values of the common type fit. */
template <class _Tp>
struct __fcxx_gcd_integer
    : __fcxx_bool_constant<is_integral<_Tp>::value && !is_same<typename remove_cv<_Tp>::type, bool>::value> {};

template <class _Up, class _Tp>
constexpr _Up __fcxx_unsigned_abs(_Tp __x) noexcept {
    return __x < 0 ? static_cast<_Up>(static_cast<_Up>(0) - static_cast<_Up>(__x)) : static_cast<_Up>(__x);
}

template <class _Up>
constexpr _Up __fcxx_gcd(_Up __a, _Up __b) noexcept {
    while (__b != 0) {
        const _Up __t = static_cast<_Up>(__a % __b);
        __a = __b;
        __b = __t;
    }
    return __a;
}

template <class _Mp, class _Np>
[[nodiscard]] constexpr typename common_type<_Mp, _Np>::type gcd(_Mp __m, _Np __n) {
    static_assert(__fcxx_gcd_integer<_Mp>::value && __fcxx_gcd_integer<_Np>::value,
                  "std::gcd takes integers other than bool");
    typedef typename common_type<_Mp, _Np>::type _Ct;
    typedef typename make_unsigned<_Ct>::type _Up;
    return static_cast<_Ct>(std::__fcxx_gcd(std::__fcxx_unsigned_abs<_Up>(__m), std::__fcxx_unsigned_abs<_Up>(__n)));
}

template <class _Mp, class _Np>
[[nodiscard]] constexpr typename common_type<_Mp, _Np>::type lcm(_Mp __m, _Np __n) {
    static_assert(__fcxx_gcd_integer<_Mp>::value && __fcxx_gcd_integer<_Np>::value,
                  "std::lcm takes integers other than bool");
    typedef typename common_type<_Mp, _Np>::type _Ct;
    typedef typename make_unsigned<_Ct>::type _Up;
    if (__m == 0 || __n == 0) {
        return 0;
    }
    const _Up __a = std::__fcxx_unsigned_abs<_Up>(__m);
    const _Up __b = std::__fcxx_unsigned_abs<_Up>(__n);
    return static_cast<_Ct>(_FCXX_MUL(static_cast<_Up>(__a / std::__fcxx_gcd(__a, __b)), __b));
}

