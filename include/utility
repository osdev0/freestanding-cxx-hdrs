/* [const.wrap.class], class template constant_wrapper */

#if _FCXX_HAS_CONSTANT_WRAPPER
template <class _Tp>
struct __fcxx_cw_fixed_value {
    using type = _Tp;

    constexpr __fcxx_cw_fixed_value(type __v) noexcept : __data(__v) {}

    _Tp __data;
};

template <class _Tp, size_t _Extent>
struct __fcxx_cw_fixed_value<_Tp[_Extent]> {
    using type = _Tp[_Extent];

    constexpr __fcxx_cw_fixed_value(_Tp (&__arr)[_Extent]) noexcept
        : __fcxx_cw_fixed_value(__arr, make_index_sequence<_Extent>()) {}

    _Tp __data[_Extent];

private:
    template <size_t... _Ip>
    constexpr __fcxx_cw_fixed_value(_Tp (&__arr)[_Extent], index_sequence<_Ip...>) noexcept
        : __data{__arr[_Ip]...} {}
};

template <class _Tp, size_t _Extent>
__fcxx_cw_fixed_value(_Tp (&)[_Extent]) -> __fcxx_cw_fixed_value<_Tp[_Extent]>;

template <__fcxx_cw_fixed_value _Xp, class = typename decltype(_Xp)::type>
struct constant_wrapper;

/* constant_wrapper<X>, as the library names it.
 * Workaround: GCC 14 and later (12 and 13 too, which have no C++26), all
 * targets: where X is dependent, GCC computes the default of the second
 * template argument from X before converting X to the type of the parameter,
 * and so fails (on typename int::type; its trunk of 2026-10-22 even crashes),
 * so the library gives that argument itself there. */
#  if _FCXX_GCC
template <__fcxx_cw_fixed_value _Xp>
using __fcxx_cw = constant_wrapper<_Xp, typename decltype(_Xp)::type>;
#  else
template <__fcxx_cw_fixed_value _Xp>
using __fcxx_cw = constant_wrapper<_Xp>;
#  endif

template <class _Tp>
concept __fcxx_constexpr_param = requires { typename __fcxx_cw<_Tp::value>; };

struct __fcxx_cw_operators {
    /* unary operators */
    template <__fcxx_constexpr_param _Tp>
    friend constexpr auto operator+(_Tp) noexcept -> __fcxx_cw<(+_Tp::value)> {
        return {};
    }

    template <__fcxx_constexpr_param _Tp>
    friend constexpr auto operator-(_Tp) noexcept -> __fcxx_cw<(-_Tp::value)> {
        return {};
    }

    template <__fcxx_constexpr_param _Tp>
    friend constexpr auto operator~(_Tp) noexcept -> __fcxx_cw<(~_Tp::value)> {
        return {};
    }

    template <__fcxx_constexpr_param _Tp>
    friend constexpr auto operator!(_Tp) noexcept -> __fcxx_cw<(!_Tp::value)> {
        return {};
    }

    template <__fcxx_constexpr_param _Tp>
    friend constexpr auto operator&(_Tp) noexcept -> __fcxx_cw<(&_Tp::value)> {
        return {};
    }

    template <__fcxx_constexpr_param _Tp>
    friend constexpr auto operator*(_Tp) noexcept -> __fcxx_cw<(*_Tp::value)> {
        return {};
    }

    /* binary operators */
    template <__fcxx_constexpr_param _Lp, __fcxx_constexpr_param _Rp>
    friend constexpr auto operator+(_Lp, _Rp) noexcept -> __fcxx_cw<(_Lp::value + _Rp::value)> {
        return {};
    }

    template <__fcxx_constexpr_param _Lp, __fcxx_constexpr_param _Rp>
    friend constexpr auto operator-(_Lp, _Rp) noexcept -> __fcxx_cw<(_Lp::value - _Rp::value)> {
        return {};
    }

    template <__fcxx_constexpr_param _Lp, __fcxx_constexpr_param _Rp>
    friend constexpr auto operator*(_Lp, _Rp) noexcept -> __fcxx_cw<(_Lp::value * _Rp::value)> {
        return {};
    }

    template <__fcxx_constexpr_param _Lp, __fcxx_constexpr_param _Rp>
    friend constexpr auto operator/(_Lp, _Rp) noexcept -> __fcxx_cw<(_Lp::value / _Rp::value)> {
        return {};
    }

    template <__fcxx_constexpr_param _Lp, __fcxx_constexpr_param _Rp>
    friend constexpr auto operator%(_Lp, _Rp) noexcept -> __fcxx_cw<(_Lp::value % _Rp::value)> {
        return {};
    }

    template <__fcxx_constexpr_param _Lp, __fcxx_constexpr_param _Rp>
    friend constexpr auto operator<<(_Lp, _Rp) noexcept -> __fcxx_cw<(_Lp::value << _Rp::value)> {
        return {};
    }

    template <__fcxx_constexpr_param _Lp, __fcxx_constexpr_param _Rp>
    friend constexpr auto operator>>(_Lp, _Rp) noexcept -> __fcxx_cw<(_Lp::value >> _Rp::value)> {
        return {};
    }

    template <__fcxx_constexpr_param _Lp, __fcxx_constexpr_param _Rp>
    friend constexpr auto operator&(_Lp, _Rp) noexcept -> __fcxx_cw<(_Lp::value & _Rp::value)> {
        return {};
    }

    template <__fcxx_constexpr_param _Lp, __fcxx_constexpr_param _Rp>
    friend constexpr auto operator|(_Lp, _Rp) noexcept -> __fcxx_cw<(_Lp::value | _Rp::value)> {
        return {};
    }

    template <__fcxx_constexpr_param _Lp, __fcxx_constexpr_param _Rp>
    friend constexpr auto operator^(_Lp, _Rp) noexcept -> __fcxx_cw<(_Lp::value ^ _Rp::value)> {
        return {};
    }

    template <__fcxx_constexpr_param _Lp, __fcxx_constexpr_param _Rp>
        requires (!is_constructible<bool, decltype(_Lp::value)>::value
                  || !is_constructible<bool, decltype(_Rp::value)>::value)
    friend constexpr auto operator&&(_Lp, _Rp) noexcept -> __fcxx_cw<(_Lp::value && _Rp::value)> {
        return {};
    }

    template <__fcxx_constexpr_param _Lp, __fcxx_constexpr_param _Rp>
        requires (!is_constructible<bool, decltype(_Lp::value)>::value
                  || !is_constructible<bool, decltype(_Rp::value)>::value)
    friend constexpr auto operator||(_Lp, _Rp) noexcept -> __fcxx_cw<(_Lp::value || _Rp::value)> {
        return {};
    }

    /* comparisons */
    template <__fcxx_constexpr_param _Lp, __fcxx_constexpr_param _Rp>
    friend constexpr auto operator<=>(_Lp, _Rp) noexcept -> __fcxx_cw<(_Lp::value <=> _Rp::value)> {
        return {};
    }

    template <__fcxx_constexpr_param _Lp, __fcxx_constexpr_param _Rp>
    friend constexpr auto operator<(_Lp, _Rp) noexcept -> __fcxx_cw<(_Lp::value < _Rp::value)> {
