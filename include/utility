    template <__fcxx_constexpr_param _Lp, __fcxx_constexpr_param _Rp>
    friend constexpr auto operator,(_Lp, _Rp) noexcept = delete;

    template <__fcxx_constexpr_param _Lp, __fcxx_constexpr_param _Rp>
    friend constexpr auto operator->*(_Lp, _Rp) noexcept -> __fcxx_cw<_Lp::value->*(_Rp::value)> {
        return {};
    }

    /* pseudo-mutators */
    template <__fcxx_constexpr_param _Tp>
    constexpr auto operator++(this _Tp) noexcept -> __fcxx_cw<(++_Tp::value)> {
        return {};
    }

    template <__fcxx_constexpr_param _Tp>
    constexpr auto operator++(this _Tp, int) noexcept -> __fcxx_cw<(_Tp::value++)> {
        return {};
    }

    template <__fcxx_constexpr_param _Tp>
    constexpr auto operator--(this _Tp) noexcept -> __fcxx_cw<(--_Tp::value)> {
        return {};
    }

    template <__fcxx_constexpr_param _Tp>
    constexpr auto operator--(this _Tp, int) noexcept -> __fcxx_cw<(_Tp::value--)> {
        return {};
    }

    template <__fcxx_constexpr_param _Tp, __fcxx_constexpr_param _Rp>
    constexpr auto operator+=(this _Tp, _Rp) noexcept -> __fcxx_cw<(_Tp::value += _Rp::value)> {
