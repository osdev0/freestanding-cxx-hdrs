    template <class _U1, class _U2>
        requires (is_assignable<_T1&, _U1>::value && is_assignable<_T2&, _U2>::value)
    constexpr pair& operator=(pair<_U1, _U2>&& __p) {
        first = std::forward<_U1>(__p.first);
        second = std::forward<_U2>(__p.second);
        return *this;
    }

    template <class _U1, class _U2>
        requires (is_assignable<const _T1&, _U1>::value && is_assignable<const _T2&, _U2>::value)
    constexpr const pair& operator=(pair<_U1, _U2>&& __p) const {
        first = std::forward<_U1>(__p.first);
        second = std::forward<_U2>(__p.second);
        return *this;
    }

    template <class _Pp>
        requires (__fcxx_pair_like_assignable<pair, _T1&, _Pp> && is_assignable<_T2&, __fcxx_get_t<1, _Pp> >::value)
