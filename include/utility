/* [utility.exchange], exchange */

template <class _Tp, class _Up = _Tp>
constexpr _Tp exchange(_Tp& __obj, _Up&& __new_val)
    noexcept(is_nothrow_move_constructible<_Tp>::value && is_nothrow_assignable<_Tp&, _Up>::value) {
    _Tp __old_val = std::move(__obj);
    __obj = std::forward<_Up>(__new_val);
    return __old_val;
}

/* [forward], forward/move, of which forward and move are in <type_traits> */

/* The type of forward_like: that of the argument, with the constness of T
 * added, and the value category of T. */
template <class _Tp, class _Up>
struct __fcxx_forward_like {
    typedef typename remove_reference<_Tp>::type _Tr;
    typedef typename remove_reference<_Up>::type _Ur;
    typedef __fcxx_conditional_t<is_const<_Tr>::value, const _Ur, _Ur> _Vp;
    typedef __fcxx_conditional_t<is_rvalue_reference<_Tp&&>::value, _Vp&&, _Vp&> type;
};

template <class _Tp, class _Up>
[[nodiscard]] constexpr auto forward_like(_Up&& __x) noexcept -> typename __fcxx_forward_like<_Tp, _Up>::type {
    return static_cast<typename __fcxx_forward_like<_Tp, _Up>::type>(__x);
}

template <class _Tp>
[[nodiscard]] constexpr
__fcxx_conditional_t<!is_nothrow_move_constructible<_Tp>::value && is_copy_constructible<_Tp>::value, const _Tp&, _Tp&&>
move_if_noexcept(_Tp& __x) noexcept {
    return std::move(__x);
}

/* [utility.as.const], as_const */

template <class _Tp>
[[nodiscard]] constexpr typename add_const<_Tp>::type& as_const(_Tp& __t) noexcept {
    return __t;
}

template <class _Tp>
void as_const(const _Tp&&) = delete;

/* [utility.intcmp], integer comparison functions */

/* The signed and unsigned integer types, which are the integral types other
 * than bool and the character types. */
template <class _Tp>
struct __fcxx_is_cmp_integer
    : __fcxx_bool_constant<is_integral<_Tp>::value && !is_same<_Tp, bool>::value && !is_same<_Tp, char>::value
                           && !is_same<_Tp, wchar_t>::value
#if _FCXX_HAS_CHAR8_T
                           && !is_same<_Tp, char8_t>::value
#endif
                           && !is_same<_Tp, char16_t>::value && !is_same<_Tp, char32_t>::value> {};

template <class _Tp, class _Up>
[[nodiscard]] constexpr bool cmp_equal(_Tp __t, _Up __u) noexcept {
    static_assert(__fcxx_is_cmp_integer<_Tp>::value && __fcxx_is_cmp_integer<_Up>::value,
                  "std::cmp_equal takes signed and unsigned integers only");
    if constexpr (is_signed<_Tp>::value == is_signed<_Up>::value) {
        return __t == __u;
    } else if constexpr (is_signed<_Tp>::value) {
        return __t < 0 ? false : static_cast<typename make_unsigned<_Tp>::type>(__t) == __u;
    } else {
        return __u < 0 ? false : __t == static_cast<typename make_unsigned<_Up>::type>(__u);
    }
}

template <class _Tp, class _Up>
[[nodiscard]] constexpr bool cmp_not_equal(_Tp __t, _Up __u) noexcept {
    return !std::cmp_equal(__t, __u);
}

template <class _Tp, class _Up>
[[nodiscard]] constexpr bool cmp_less(_Tp __t, _Up __u) noexcept {
    static_assert(__fcxx_is_cmp_integer<_Tp>::value && __fcxx_is_cmp_integer<_Up>::value,
                  "std::cmp_less takes signed and unsigned integers only");
    if constexpr (is_signed<_Tp>::value == is_signed<_Up>::value) {
        return __t < __u;
    } else if constexpr (is_signed<_Tp>::value) {
        return __t < 0 ? true : static_cast<typename make_unsigned<_Tp>::type>(__t) < __u;
    } else {
        return __u < 0 ? false : __t < static_cast<typename make_unsigned<_Up>::type>(__u);
    }
}

template <class _Tp, class _Up>
[[nodiscard]] constexpr bool cmp_greater(_Tp __t, _Up __u) noexcept {
    return std::cmp_less(__u, __t);
}

template <class _Tp, class _Up>
[[nodiscard]] constexpr bool cmp_less_equal(_Tp __t, _Up __u) noexcept {
    return !std::cmp_less(__u, __t);
}

template <class _Tp, class _Up>
[[nodiscard]] constexpr bool cmp_greater_equal(_Tp __t, _Up __u) noexcept {
    return !std::cmp_less(__t, __u);
}

template <class _Rp, class _Tp>
[[nodiscard]] constexpr bool in_range(_Tp __t) noexcept {
    static_assert(__fcxx_is_cmp_integer<_Rp>::value && __fcxx_is_cmp_integer<_Tp>::value,
                  "std::in_range takes signed and unsigned integers only");
    typedef typename make_unsigned<_Rp>::type _Ur;
    constexpr _Rp __max = is_signed<_Rp>::value ? static_cast<_Rp>(static_cast<_Ur>(-1) >> 1) : static_cast<_Rp>(-1);
    constexpr _Rp __min = is_signed<_Rp>::value ? static_cast<_Rp>(-__max - 1) : static_cast<_Rp>(0);
    return std::cmp_greater_equal(__t, __min) && std::cmp_less_equal(__t, __max);
}

/* [utility.underlying], to_underlying */

template <class _Tp>
[[nodiscard]] constexpr typename underlying_type<_Tp>::type to_underlying(_Tp __value) noexcept {
    return static_cast<typename underlying_type<_Tp>::type>(__value);
}

/* [utility.undefined], undefined behavior */

[[noreturn]] inline void unreachable() {
    _FCXX_UNREACHABLE();
}

#if _FCXX_STD >= 2026
/* Nothing may be moved across the checkpoint, which is what the compiler
 * does not see through, or what its builtin marks. */
inline void observable_checkpoint() noexcept {
#  if _FCXX_HAS_BUILTIN(__builtin_observable_checkpoint)
    __builtin_observable_checkpoint();
#  else
    __asm__ __volatile__("" ::: "memory");
#  endif
}
