    template <class _Pp>
        requires (__fcxx_pair_like_constructible<_T1, _T2, _Pp>
                  && !__fcxx_pair_dangles<_T1, _T2, __fcxx_get_t<0, _Pp>, __fcxx_get_t<1, _Pp> >)
