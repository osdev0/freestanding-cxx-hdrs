    template <class _U1, class _U2>
        requires (__fcxx_pair_constructible<_T1, _T2, _U1&, _U2&> && __fcxx_pair_dangles<_T1, _T2, _U1&, _U2&>)
    constexpr explicit(!__fcxx_pair_implicit<_T1, _T2, _U1&, _U2&>) pair(pair<_U1, _U2>&) = delete;

    template <class _U1, class _U2>
        requires (__fcxx_pair_constructible<_T1, _T2, const _U1&, const _U2&>
                  && __fcxx_pair_dangles<_T1, _T2, const _U1&, const _U2&>)
