template <class _T1, class _T2, class _U1, class _U2>
constexpr common_comparison_category_t<__fcxx_synth_three_way_result<_T1, _U1>,
                                       __fcxx_synth_three_way_result<_T2, _U2> >
operator<=>(const pair<_T1, _T2>& __x, const pair<_U1, _U2>& __y) {
    if (auto __c = __fcxx_synth_three_way(__x.first, __y.first); __c != 0) {
        return __c;
