        requires (is_copy_assignable<const _T1>::value && is_copy_assignable<const _T2>::value) {
        first = __p.first;
        second = __p.second;
        return *this;
    }

    template <class _U1, class _U2>
        requires (is_assignable<_T1&, const _U1&>::value && is_assignable<_T2&, const _U2&>::value)
    constexpr pair& operator=(const pair<_U1, _U2>& __p) {
        first = __p.first;
        second = __p.second;
