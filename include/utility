    template <__fcxx_constexpr_param _Tp, __fcxx_constexpr_param _Rp>
    constexpr auto operator/=(this _Tp, _Rp) noexcept -> __fcxx_cw<(_Tp::value /= _Rp::value)> {
        return {};
    }

    template <__fcxx_constexpr_param _Tp, __fcxx_constexpr_param _Rp>
    constexpr auto operator%=(this _Tp, _Rp) noexcept -> __fcxx_cw<(_Tp::value %= _Rp::value)> {
        return {};
    }

    template <__fcxx_constexpr_param _Tp, __fcxx_constexpr_param _Rp>
    constexpr auto operator&=(this _Tp, _Rp) noexcept -> __fcxx_cw<(_Tp::value &= _Rp::value)> {
        return {};
    }

    template <__fcxx_constexpr_param _Tp, __fcxx_constexpr_param _Rp>
    constexpr auto operator|=(this _Tp, _Rp) noexcept -> __fcxx_cw<(_Tp::value |= _Rp::value)> {
        return {};
    }

    template <__fcxx_constexpr_param _Tp, __fcxx_constexpr_param _Rp>
    constexpr auto operator^=(this _Tp, _Rp) noexcept -> __fcxx_cw<(_Tp::value ^= _Rp::value)> {
        return {};
    }

    template <__fcxx_constexpr_param _Tp, __fcxx_constexpr_param _Rp>
    constexpr auto operator<<=(this _Tp, _Rp) noexcept -> __fcxx_cw<(_Tp::value <<= _Rp::value)> {
        return {};
    }

    template <__fcxx_constexpr_param _Tp, __fcxx_constexpr_param _Rp>
    constexpr auto operator>>=(this _Tp, _Rp) noexcept -> __fcxx_cw<(_Tp::value >>= _Rp::value)> {
        return {};
    }
};

/* What calling the value of a constant_wrapper, or subscripting it, gives:
 * a constant_wrapper of the result when all of the arguments are
 * constant_wrappers and the result can be one, and the result otherwise. */
template <class _Cw, class... _Args>
concept __fcxx_cw_constant_call = (__fcxx_constexpr_param<__fcxx_remove_cvref_t<_Args> > && ...)
    && requires { typename __fcxx_cw<std::__fcxx_invoke(_Cw::value, __fcxx_remove_cvref_t<_Args>::value...)>; };

template <class _Cw, class... _Args>
concept __fcxx_cw_constant_subscript = (__fcxx_constexpr_param<__fcxx_remove_cvref_t<_Args> > && ...)
    && requires { typename __fcxx_cw<_Cw::value[__fcxx_remove_cvref_t<_Args>::value...]>; };

template <__fcxx_cw_fixed_value _Xp, class>
struct constant_wrapper : __fcxx_cw_operators {
    static constexpr const auto& value = _Xp.__data;
    using type = constant_wrapper;
    using value_type = typename decltype(_Xp)::type;

    template <__fcxx_constexpr_param _Rp>
    constexpr auto operator=(_Rp) const noexcept -> __fcxx_cw<(value = _Rp::value)> {
        return {};
    }

    constexpr operator decltype(value)() const noexcept {
        return value;
    }

    template <class... _Args>
        requires (__fcxx_cw_constant_call<constant_wrapper, _Args...>
                  || requires(_Args&&... __args) { std::__fcxx_invoke(value, std::forward<_Args>(__args)...); })
    static constexpr decltype(auto) operator()(_Args&&... __args) noexcept(__call_noexcept<_Args...>()) {
        if constexpr (__fcxx_cw_constant_call<constant_wrapper, _Args...>) {
            return __fcxx_cw<std::__fcxx_invoke(value, __fcxx_remove_cvref_t<_Args>::value...)>{};
        } else {
            return std::__fcxx_invoke(value, std::forward<_Args>(__args)...);
        }
    }

    template <class... _Args>
        requires (__fcxx_cw_constant_subscript<constant_wrapper, _Args...>
                  || requires(_Args&&... __args) { value[std::forward<_Args>(__args)...]; })
    static constexpr decltype(auto) operator[](_Args&&... __args) noexcept(__subscript_noexcept<_Args...>()) {
        if constexpr (__fcxx_cw_constant_subscript<constant_wrapper, _Args...>) {
            return __fcxx_cw<value[__fcxx_remove_cvref_t<_Args>::value...]>{};
        } else {
            return value[std::forward<_Args>(__args)...];
        }
    }

private:
    template <class... _Args>
    static constexpr bool __call_noexcept() {
        if constexpr (__fcxx_cw_constant_call<constant_wrapper, _Args...>) {
            return true;
        } else {
            return noexcept(std::__fcxx_invoke(value, std::declval<_Args>()...));
        }
    }

    template <class... _Args>
    static constexpr bool __subscript_noexcept() {
        if constexpr (__fcxx_cw_constant_subscript<constant_wrapper, _Args...>) {
            return true;
        } else {
            return noexcept(value[std::declval<_Args>()...]);
        }
    }
};

template <__fcxx_cw_fixed_value _Xp>
inline constexpr auto cw = constant_wrapper<_Xp>{};
#endif

/* [intseq.binding], structured binding support for integer_sequence, which
 * is in <__fcxx/integer_sequence.h> */

#if _FCXX_STD >= 2026
template <class _Tp, _Tp... _Values>
struct tuple_size<integer_sequence<_Tp, _Values...> > : integral_constant<size_t, sizeof...(_Values)> {};

template <size_t _Ip, class _Tp, _Tp... _Values>
struct tuple_element<_Ip, integer_sequence<_Tp, _Values...> > {
    static_assert(_Ip < sizeof...(_Values), "std::tuple_element index out of range for std::integer_sequence");
    using type = _Tp;
};

template <size_t _Ip, class _Tp, _Tp... _Values>
struct tuple_element<_Ip, const integer_sequence<_Tp, _Values...> > {
    static_assert(_Ip < sizeof...(_Values), "std::tuple_element index out of range for std::integer_sequence");
    using type = _Tp;
};

template <size_t _Ip, class _Tp, _Tp... _Values>
constexpr _Tp get(integer_sequence<_Tp, _Values...>) noexcept {
    static_assert(_Ip < sizeof...(_Values), "std::get index out of range for std::integer_sequence");
#  if _FCXX_HAS_PACK_INDEXING
    return _Values...[_Ip];
#  else
    constexpr _Tp __values[] = {_Values..., _Tp()};
    return __values[_Ip];
#  endif
}
#endif

/* [pairs.pair], class template pair */

struct piecewise_construct_t {
    explicit piecewise_construct_t() = default;
};

inline constexpr piecewise_construct_t piecewise_construct = piecewise_construct_t();

template <class... _Types>
class tuple;

/* The constraints of the constructors of pair from two values, whether
 * they are explicit, and whether they are deleted for binding a reference
 * member to a temporary. */
template <class _T1, class _T2, class _A1, class _A2>
concept __fcxx_pair_constructible = is_constructible<_T1, _A1>::value && is_constructible<_T2, _A2>::value;

template <class _T1, class _T2, class _A1, class _A2>
inline constexpr bool __fcxx_pair_implicit = is_convertible<_A1, _T1>::value && is_convertible<_A2, _T2>::value;

template <class _T1, class _T2, class _A1, class _A2>
inline constexpr bool __fcxx_pair_dangles =
#if _FCXX_HAS_DANGLING_CHECK
    __reference_constructs_from_temporary(_T1, _A1) || __reference_constructs_from_temporary(_T2, _A2);
#else
    false;
#endif

template <class _T1, class _T2, class _Pp>
concept __fcxx_pair_like_constructible = __fcxx_pair_like<_Pp> && !__fcxx_is_subrange<__fcxx_remove_cvref_t<_Pp>>::value
    && __fcxx_pair_constructible<_T1, _T2, __fcxx_get_t<0, _Pp>, __fcxx_get_t<1, _Pp>>;

/* Whether the constructor from a pair-like type is explicit, which only
 * looks at the elements of pair-like types, as the explicit specifier can
 * be substituted into before the constraints are checked. */
template <class _T1, class _T2, class _Pp, bool = __fcxx_pair_like<_Pp> >
struct __fcxx_pair_like_implicit : false_type {};

template <class _T1, class _T2, class _Pp>
struct __fcxx_pair_like_implicit<_T1, _T2, _Pp, true>
    : __fcxx_bool_constant<__fcxx_pair_implicit<_T1, _T2, __fcxx_get_t<0, _Pp>, __fcxx_get_t<1, _Pp> > > {};

/* The constraints of the assignments of pair from a pair-like type, but
 * that of the second element: the pair, and the type to assign the first
 * element to. */
template <class _Pair, class _First, class _Pp>
