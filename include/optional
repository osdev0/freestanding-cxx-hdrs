constexpr compare_three_way_result_t<_Tp, _Up> operator<=>(const optional<_Tp>& __x, const optional<_Up>& __y) {
    if (__x.has_value() && __y.has_value()) {
        return std::__fcxx_three_way(*__x, *__y);
    }
    return __x.has_value() <=> __y.has_value();
}

