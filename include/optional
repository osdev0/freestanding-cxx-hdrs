 * with requires-clauses. */

namespace std {

/* [optional.nullopt], no-value state indicator */

struct nullopt_t {
    /* The argument of the constructor, as nullopt_t has no default
     * constructor, so that "o = {}" is not ambiguous. */
    struct __fcxx_tag {
        explicit __fcxx_tag() = default;
    };

    constexpr explicit nullopt_t(__fcxx_tag) noexcept {}

    friend constexpr bool operator==(nullopt_t, nullopt_t) noexcept {
        return true;
    }

    friend constexpr strong_ordering operator<=>(nullopt_t, nullopt_t) noexcept {
        return strong_ordering::equal;
    }
};

inline constexpr nullopt_t nullopt{nullopt_t::__fcxx_tag()};

/* [optional.bad.access], class bad_optional_access, whose members are all
 * defined here, as no C++ runtime defines them */

class bad_optional_access : public exception {
public:
    constexpr bad_optional_access() noexcept {}
    constexpr bad_optional_access(const bad_optional_access&) noexcept = default;
    constexpr bad_optional_access& operator=(const bad_optional_access&) noexcept = default;

    constexpr const char* what() const noexcept override {
        return "std::bad_optional_access";
    }
};

/* [optional.optional], class template optional */

template <class _Tp>
class optional;

template <class _Tp>
struct __fcxx_is_optional : false_type {};

template <class _Tp>
struct __fcxx_is_optional<optional<_Tp> > : true_type {};

/* Whether a type can be held by optional: an object type other than an
 * array, in_place_t and nullopt_t, or, from C++26 on, an lvalue reference to
 * any other type. */
template <class _Tp>
struct __fcxx_optional_valid
    : __fcxx_bool_constant<(
                               is_lvalue_reference<_Tp>::value ||
                               (is_object<_Tp>::value && !is_array<_Tp>::value))
                           && !is_same<__fcxx_remove_cvref_t<_Tp>, in_place_t>::value
                           && !is_same<__fcxx_remove_cvref_t<_Tp>, nullopt_t>::value> {};

/* The tag of the constructors that hold the result of calling a function,
 * for transform. */
struct __fcxx_optional_invoke_tag {
    explicit __fcxx_optional_invoke_tag() = default;
};

/* The storage of the contained value, whose destructor is trivial where the
 * value's is. */
template <class _Vp, bool = is_trivially_destructible<_Vp>::value>
union __fcxx_optional_union {
    __fcxx_union_empty __empty;
    _Vp __val;

    constexpr __fcxx_optional_union() noexcept : __empty() {}

    template <class... _Args>
    constexpr explicit __fcxx_optional_union(in_place_t, _Args&&... __args) : __val(std::forward<_Args>(__args)...) {}

    template <class _Fp, class... _Args>
    constexpr __fcxx_optional_union(__fcxx_optional_invoke_tag, _Fp&& __f, _Args&&... __args)
        : __val(std::__fcxx_invoke(std::forward<_Fp>(__f), std::forward<_Args>(__args)...)) {}
};

template <class _Vp>
union __fcxx_optional_union<_Vp, false> {
    __fcxx_union_empty __empty;
    _Vp __val;

    constexpr __fcxx_optional_union() noexcept : __empty() {}

    template <class... _Args>
    constexpr explicit __fcxx_optional_union(in_place_t, _Args&&... __args) : __val(std::forward<_Args>(__args)...) {}

    template <class _Fp, class... _Args>
    constexpr __fcxx_optional_union(__fcxx_optional_invoke_tag, _Fp&& __f, _Args&&... __args)
        : __val(std::__fcxx_invoke(std::forward<_Fp>(__f), std::forward<_Args>(__args)...)) {}

    __fcxx_optional_union(const __fcxx_optional_union&) = default;
    __fcxx_optional_union(__fcxx_optional_union&&) = default;
    __fcxx_optional_union& operator=(const __fcxx_optional_union&) = default;
    __fcxx_optional_union& operator=(__fcxx_optional_union&&) = default;

    constexpr ~__fcxx_optional_union() {}
};

/* The contained value, if any, and what optional does with it. The value is
 * an object of the type without its cv-qualifiers, which C++26 uses as such,
 * where the earlier revisions use it through the type itself. */
template <class _Tp>
struct __fcxx_optional_payload {
    typedef __fcxx_remove_cv_t<_Tp> _Vp;
    typedef _Vp _Access;

    __fcxx_optional_union<_Vp> __u;
    bool __engaged;

    constexpr explicit __fcxx_optional_payload(__fcxx_no_value_tag) noexcept : __u(), __engaged(false) {}

    template <class... _Args>
    constexpr explicit __fcxx_optional_payload(in_place_t __tag, _Args&&... __args)
        : __u(__tag, std::forward<_Args>(__args)...), __engaged(true) {}

    template <class _Fp, class... _Args>
    constexpr __fcxx_optional_payload(__fcxx_optional_invoke_tag __tag, _Fp&& __f, _Args&&... __args)
        : __u(__tag, std::forward<_Fp>(__f), std::forward<_Args>(__args)...), __engaged(true) {}

    constexpr _Access& __get() noexcept {
        return __u.__val;
    }

    constexpr const _Access& __get() const noexcept {
        return __u.__val;
    }

    /* Constructs the value, which there must not be yet. */
    template <class... _Args>
    constexpr void __construct(_Args&&... __args) {
        std::construct_at(std::addressof(__u.__val), std::forward<_Args>(__args)...);
        __engaged = true;
    }

    constexpr void __reset() noexcept {
        if (__engaged) {
            if constexpr (!is_trivially_destructible<_Vp>::value) {
                __u.__val.~_Vp();
            }
            __engaged = false;
        }
    }

    /* The copy and move constructors and assignment operators. */
    constexpr __fcxx_optional_payload(__fcxx_smf_construct_tag, const __fcxx_optional_payload& __other)
        : __u(), __engaged(false) {
        if (__other.__engaged) {
            __construct(__other.__get());
        }
    }

    constexpr __fcxx_optional_payload(__fcxx_smf_construct_tag, __fcxx_optional_payload&& __other)
        noexcept(is_nothrow_move_constructible<_Tp>::value)
        : __u(), __engaged(false) {
        if (__other.__engaged) {
            __construct(std::move(__other.__get()));
        }
    }

    constexpr void __fcxx_assign_from(const __fcxx_optional_payload& __other) {
        if (__engaged && __other.__engaged) {
            __get() = __other.__get();
        } else if (__other.__engaged) {
            __construct(__other.__get());
        } else {
            __reset();
        }
    }

    constexpr void __fcxx_assign_from(__fcxx_optional_payload&& __other)
        noexcept(is_nothrow_move_assignable<_Tp>::value && is_nothrow_move_constructible<_Tp>::value) {
        if (__engaged && __other.__engaged) {
            __get() = std::move(__other.__get());
        } else if (__other.__engaged) {
            __construct(std::move(__other.__get()));
        } else {
            __reset();
        }
    }
};

template <class _Tp, bool = is_trivially_destructible<_Tp>::value>
struct __fcxx_optional_storage : __fcxx_optional_payload<_Tp> {
    using __fcxx_optional_payload<_Tp>::__fcxx_optional_payload;
};

template <class _Tp>
struct __fcxx_optional_storage<_Tp, false> : __fcxx_optional_payload<_Tp> {
    using __fcxx_optional_payload<_Tp>::__fcxx_optional_payload;

    __fcxx_optional_storage(const __fcxx_optional_storage&) = default;
    __fcxx_optional_storage(__fcxx_optional_storage&&) = default;
    __fcxx_optional_storage& operator=(const __fcxx_optional_storage&) = default;
    __fcxx_optional_storage& operator=(__fcxx_optional_storage&&) = default;

    constexpr ~__fcxx_optional_storage() {
        this->__reset();
    }
};

/* The base class of optional, with its copy and move constructors and
 * assignment operators, for the types it can hold. */
template <class _Tp>
struct __fcxx_optional_smf {
    typedef __fcxx_smf<__fcxx_optional_storage<_Tp>,
                       __fcxx_smf_select<is_copy_constructible<_Tp>::value,
                                         is_trivially_copy_constructible<_Tp>::value, __fcxx_smf_deleted>::value,
                       __fcxx_smf_select<is_move_constructible<_Tp>::value,
                                         is_trivially_move_constructible<_Tp>::value, __fcxx_smf_absent>::value,
                       __fcxx_smf_select<is_copy_constructible<_Tp>::value && is_copy_assignable<_Tp>::value,
                                         is_trivially_copy_constructible<_Tp>::value
                                             && is_trivially_copy_assignable<_Tp>::value
                                             && is_trivially_destructible<_Tp>::value,
                                         __fcxx_smf_deleted>::value,
                       __fcxx_smf_select<is_move_constructible<_Tp>::value && is_move_assignable<_Tp>::value,
                                         is_trivially_move_constructible<_Tp>::value
                                             && is_trivially_move_assignable<_Tp>::value
                                             && is_trivially_destructible<_Tp>::value,
                                         __fcxx_smf_absent>::value>
        type;
};

struct __fcxx_optional_invalid {};

template <class _Tp>
using __fcxx_optional_base_t
    = typename __fcxx_conditional_t<__fcxx_optional_valid<_Tp>::value && !is_reference<_Tp>::value,
                                    __fcxx_optional_smf<_Tp>, __fcxx_type_identity<__fcxx_optional_invalid> >::type;

/* The constraints of the converting constructors and assignment operators,
 * which leave out as soon as they can what does not apply, lest the traits
 * of the other types be needed. */
template <class _Tp, class _Up>
struct __fcxx_optional_from_value {
    typedef __fcxx_remove_cvref_t<_Up> _Uq;
    static constexpr bool __ok = __fcxx_and<__fcxx_not<is_same<_Uq, in_place_t> >,
                                            __fcxx_not<is_same<_Uq, optional<_Tp> > >,
                                            __fcxx_not<__fcxx_and<is_same<__fcxx_remove_cv_t<_Tp>, bool>,
                                                                  __fcxx_is_optional<_Uq> > >,
                                            is_constructible<_Tp, _Up> >::value;
    static constexpr bool __implicit = __ok && is_convertible<_Up, _Tp>::value;
    static constexpr bool __explicit = __ok && !is_convertible<_Up, _Tp>::value;
};

template <class _Tp, class _Up, class _Arg>
struct __fcxx_optional_from_optional {
    static constexpr bool __ok = __fcxx_and<is_constructible<_Tp, _Arg>,
                                            __fcxx_or<is_same<__fcxx_remove_cv_t<_Tp>, bool>,
                                                      __fcxx_not<__fcxx_converts_from_any_cvref<_Tp, optional<_Up> > > >
                                            >::value;
    static constexpr bool __implicit = __ok && is_convertible<_Arg, _Tp>::value;
    static constexpr bool __explicit = __ok && !is_convertible<_Arg, _Tp>::value;
};

template <class _Tp, class _Up>
struct __fcxx_optional_assign_value
    : __fcxx_and<__fcxx_not<is_same<__fcxx_remove_cvref_t<_Up>, optional<_Tp> > >,
                 __fcxx_not<__fcxx_and<is_scalar<_Tp>, is_same<_Tp, __fcxx_decay_t<_Up> > > >,
                 is_constructible<_Tp, _Up>, is_assignable<_Tp&, _Up> > {};

template <class _Tp, class _Up, class _Arg>
struct __fcxx_optional_assign_optional
    : __fcxx_and<is_constructible<_Tp, _Arg>, is_assignable<_Tp&, _Arg>,
                 __fcxx_not<__fcxx_converts_from_any_cvref<_Tp, optional<_Up> > >,
                 __fcxx_not<is_assignable<_Tp&, optional<_Up>&> >, __fcxx_not<is_assignable<_Tp&, optional<_Up>&&> >,
                 __fcxx_not<is_assignable<_Tp&, const optional<_Up>&> >,
                 __fcxx_not<is_assignable<_Tp&, const optional<_Up>&&> > > {};

template <class _Tp>
class optional : private __fcxx_optional_base_t<_Tp> {
    typedef __fcxx_optional_base_t<_Tp> _Base;

    static_assert(__fcxx_optional_valid<_Tp>::value && !is_reference<_Tp>::value,
                  "std::optional of a type it cannot hold");

    /* The default template argument of the converting constructor and
     * assignment operator, and of value_or. */
    typedef __fcxx_remove_cv_t<_Tp> _Dp;

    template <class _Up>
    friend class optional;

public:
    typedef _Tp value_type;
    typedef _Tp* iterator;
    typedef const _Tp* const_iterator;

    /* [optional.ctor], constructors */

    constexpr optional() noexcept : _Base(__fcxx_no_value_tag()) {}

    constexpr optional(nullopt_t) noexcept : _Base(__fcxx_no_value_tag()) {}

    optional(const optional&) = default;
    optional(optional&&) = default;

    template <class... _Args, __fcxx_enable_if_t<is_constructible<_Tp, _Args...>::value, int> = 0>
    constexpr explicit optional(in_place_t __tag, _Args&&... __args) : _Base(__tag, std::forward<_Args>(__args)...) {}

    template <class _Up, class... _Args,
              __fcxx_enable_if_t<is_constructible<_Tp, initializer_list<_Up>&, _Args...>::value, int> = 0>
    constexpr explicit optional(in_place_t __tag, initializer_list<_Up> __il, _Args&&... __args)
        : _Base(__tag, __il, std::forward<_Args>(__args)...) {}

    template <class _Up = _Dp, __fcxx_enable_if_t<__fcxx_optional_from_value<_Tp, _Up>::__implicit, int> = 0>
    constexpr optional(_Up&& __v) : _Base(in_place_t(), std::forward<_Up>(__v)) {}

    template <class _Up = _Dp, __fcxx_enable_if_t<__fcxx_optional_from_value<_Tp, _Up>::__explicit, int> = 0>
    constexpr explicit optional(_Up&& __v) : _Base(in_place_t(), std::forward<_Up>(__v)) {}

    template <class _Up, __fcxx_enable_if_t<__fcxx_optional_from_optional<_Tp, _Up, const _Up&>::__implicit, int> = 0>
    constexpr optional(const optional<_Up>& __rhs) : _Base(__fcxx_no_value_tag()) {
        if (__rhs.has_value()) {
            this->__construct(*__rhs);
        }
    }

    template <class _Up, __fcxx_enable_if_t<__fcxx_optional_from_optional<_Tp, _Up, const _Up&>::__explicit, int> = 0>
    constexpr explicit optional(const optional<_Up>& __rhs) : _Base(__fcxx_no_value_tag()) {
        if (__rhs.has_value()) {
            this->__construct(*__rhs);
        }
    }

    template <class _Up, __fcxx_enable_if_t<__fcxx_optional_from_optional<_Tp, _Up, _Up>::__implicit, int> = 0>
    constexpr optional(optional<_Up>&& __rhs) : _Base(__fcxx_no_value_tag()) {
        if (__rhs.has_value()) {
            this->__construct(*std::move(__rhs));
        }
    }

    template <class _Up, __fcxx_enable_if_t<__fcxx_optional_from_optional<_Tp, _Up, _Up>::__explicit, int> = 0>
    constexpr explicit optional(optional<_Up>&& __rhs) : _Base(__fcxx_no_value_tag()) {
        if (__rhs.has_value()) {
            this->__construct(*std::move(__rhs));
        }
    }

    /* [optional.assign], assignment */

    constexpr optional& operator=(nullopt_t) noexcept {
        this->__reset();
        return *this;
    }

    optional& operator=(const optional&) = default;
    optional& operator=(optional&&) = default;

    template <class _Up = _Dp, __fcxx_enable_if_t<__fcxx_optional_assign_value<_Tp, _Up>::value, int> = 0>
    constexpr optional& operator=(_Up&& __v) {
        if (this->__engaged) {
            this->__get() = std::forward<_Up>(__v);
        } else {
            this->__construct(std::forward<_Up>(__v));
        }
        return *this;
    }

    template <class _Up, __fcxx_enable_if_t<__fcxx_optional_assign_optional<_Tp, _Up, const _Up&>::value, int> = 0>
    constexpr optional& operator=(const optional<_Up>& __rhs) {
        if (this->__engaged && __rhs.has_value()) {
            this->__get() = *__rhs;
        } else if (__rhs.has_value()) {
            this->__construct(*__rhs);
        } else {
            this->__reset();
        }
        return *this;
    }

    template <class _Up, __fcxx_enable_if_t<__fcxx_optional_assign_optional<_Tp, _Up, _Up>::value, int> = 0>
    constexpr optional& operator=(optional<_Up>&& __rhs) {
        if (this->__engaged && __rhs.has_value()) {
            this->__get() = *std::move(__rhs);
        } else if (__rhs.has_value()) {
            this->__construct(*std::move(__rhs));
        } else {
            this->__reset();
        }
        return *this;
    }

    /* Constrained from C++26 on, where the earlier revisions require the
     * arguments to construct the value from. */
    template <class... _Args, __fcxx_enable_if_t<is_constructible<_Tp, _Args...>::value, int> = 0>
    constexpr _Tp& emplace(_Args&&... __args) {
        static_assert(is_constructible<_Tp, _Args...>::value, "std::optional::emplace of a value it cannot construct");
        this->__reset();
        this->__construct(std::forward<_Args>(__args)...);
        return this->__u.__val;
    }

    template <class _Up, class... _Args,
              __fcxx_enable_if_t<is_constructible<_Tp, initializer_list<_Up>&, _Args...>::value, int> = 0>
    constexpr _Tp& emplace(initializer_list<_Up> __il, _Args&&... __args) {
        this->__reset();
        this->__construct(__il, std::forward<_Args>(__args)...);
        return this->__u.__val;
    }

    /* [optional.swap], swap */

    constexpr void swap(optional& __rhs)
        noexcept(is_nothrow_move_constructible<_Tp>::value && __fcxx_is_nothrow_swappable<_Tp>::value) {
        static_assert(is_move_constructible<_Tp>::value, "std::optional::swap of a type that cannot be moved");
        if (this->__engaged && __rhs.__engaged) {
            using std::swap;
            swap(this->__get(), __rhs.__get());
        } else if (this->__engaged) {
            __rhs.__construct(std::move(this->__get()));
            this->__reset();
        } else if (__rhs.__engaged) {
            this->__construct(std::move(__rhs.__get()));
            __rhs.__reset();
        }
    }

    /* [optional.iterators], iterator support */

    constexpr iterator begin() noexcept {
        return std::addressof(this->__u.__val);
    }

    constexpr const_iterator begin() const noexcept {
        return std::addressof(this->__u.__val);
    }

    constexpr iterator end() noexcept {
        return this->__engaged ? begin() + 1 : begin();
    }

    constexpr const_iterator end() const noexcept {
        return this->__engaged ? begin() + 1 : begin();
    }

    /* [optional.observe], observers */

    constexpr const _Tp* operator->() const noexcept {
        return std::addressof(this->__u.__val);
    }

    constexpr _Tp* operator->() noexcept {
        return std::addressof(this->__u.__val);
    }

    constexpr const _Tp& operator*() const& noexcept {
        return this->__u.__val;
    }

    constexpr _Tp& operator*() & noexcept {
        return this->__u.__val;
    }

    constexpr _Tp&& operator*() && noexcept {
        return std::move(this->__u.__val);
    }

    constexpr const _Tp&& operator*() const&& noexcept {
        return std::move(this->__u.__val);
    }

    constexpr explicit operator bool() const noexcept {
        return this->__engaged;
    }

    constexpr bool has_value() const noexcept {
        return this->__engaged;
    }

    /* freestanding-deleted */
    constexpr const _Tp& value() const& = delete;
    constexpr _Tp& value() & = delete;
    constexpr _Tp&& value() && = delete;
    constexpr const _Tp&& value() const&& = delete;

    template <class _Up = _Dp>
    constexpr _Tp value_or(_Up&& __v) const& {
        static_assert(is_copy_constructible<_Tp>::value && is_convertible<_Up&&, _Tp>::value,
                      "std::optional::value_or of a value that cannot be copied or converted to");
        if (this->__engaged) {
            return this->__get();
        }
        return static_cast<_Tp>(std::forward<_Up>(__v));
    }

    template <class _Up = _Dp>
    constexpr _Tp value_or(_Up&& __v) && {
        static_assert(is_move_constructible<_Tp>::value && is_convertible<_Up&&, _Tp>::value,
                      "std::optional::value_or of a value that cannot be moved or converted to");
        if (this->__engaged) {
            return std::move(this->__get());
        }
        return static_cast<_Tp>(std::forward<_Up>(__v));
    }

    /* [optional.monadic], monadic operations */

    template <class _Fp>
    constexpr auto and_then(_Fp&& __f) & {
        return __and_then(*this, std::forward<_Fp>(__f));
    }

    template <class _Fp>
    constexpr auto and_then(_Fp&& __f) && {
        return __and_then(std::move(*this), std::forward<_Fp>(__f));
    }

    template <class _Fp>
    constexpr auto and_then(_Fp&& __f) const& {
        return __and_then(*this, std::forward<_Fp>(__f));
    }

    template <class _Fp>
    constexpr auto and_then(_Fp&& __f) const&& {
        return __and_then(std::move(*this), std::forward<_Fp>(__f));
    }

    template <class _Fp>
    constexpr auto transform(_Fp&& __f) & {
        return __transform(*this, std::forward<_Fp>(__f));
    }

    template <class _Fp>
    constexpr auto transform(_Fp&& __f) && {
        return __transform(std::move(*this), std::forward<_Fp>(__f));
    }

    template <class _Fp>
    constexpr auto transform(_Fp&& __f) const& {
        return __transform(*this, std::forward<_Fp>(__f));
    }

    template <class _Fp>
    constexpr auto transform(_Fp&& __f) const&& {
        return __transform(std::move(*this), std::forward<_Fp>(__f));
    }

    template <class _Fp>
        requires (invocable<_Fp> && move_constructible<_Tp>)
    constexpr optional or_else(_Fp&& __f) && {
        static_assert(is_same<__fcxx_remove_cvref_t<invoke_result_t<_Fp> >, optional>::value,
                      "std::optional::or_else of a function not returning the same std::optional");
        if (this->__engaged) {
            return std::move(*this);
        }
        return std::forward<_Fp>(__f)();
    }

    template <class _Fp>
        requires (invocable<_Fp> && copy_constructible<_Tp>)
    constexpr optional or_else(_Fp&& __f) const& {
        static_assert(is_same<__fcxx_remove_cvref_t<invoke_result_t<_Fp> >, optional>::value,
                      "std::optional::or_else of a function not returning the same std::optional");
        if (this->__engaged) {
            return *this;
        }
        return std::forward<_Fp>(__f)();
    }

    /* [optional.mod], modifiers */

    constexpr void reset() noexcept {
        this->__reset();
    }

private:
    template <class _Fp, class... _Args>
    constexpr optional(__fcxx_optional_invoke_tag __tag, _Fp&& __f, _Args&&... __args)
        : _Base(__tag, std::forward<_Fp>(__f), std::forward<_Args>(__args)...) {}

    /* The value of an optional of any value category, as the monadic
     * operations take it. */
    template <class _Self>
    static constexpr decltype(auto) __value_of(_Self&& __self) noexcept {
        if constexpr (is_lvalue_reference<_Self>::value) {
            return (__self.__get());
        } else {
            return std::move(__self.__get());
        }
    }

    template <class _Self, class _Fp>
    static constexpr auto __and_then(_Self&& __self, _Fp&& __f) {
